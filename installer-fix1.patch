 }
 
+# The error lines of the last Invoke-Tool call (for messages).
+function Get-ToolError {
+    $errors = @($script:ToolOutput | Where-Object { $_ -match '^\s*(error|cause|caused by)' })
+    if ($errors.Count -eq 0) { $errors = @($script:ToolOutput | Select-Object -Last 3) }
