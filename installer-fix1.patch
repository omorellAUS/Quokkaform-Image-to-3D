 # True if the runtime's Python can import the module.
 function Test-Import([string]$Module) {
     if (-not (Test-Path $VenvPy)) { return $false }
@@ -228,6 +246,128 @@ function Initialize-Toolchain {
     return $true
 }
 
+# True if $Exe is a working 64-bit Python 3.10.
+function Test-Python([string]$Exe) {
+    if (-not $Exe -or -not (Test-Path -LiteralPath $Exe)) { return $false }
+    & $Exe -c 'import sys, struct; sys.exit(0 if sys.version_info[:2] == (3, 10) and struct.calcsize(''P'') == 8 else 1)' 2>$null | Out-Null
+    return ($LASTEXITCODE -eq 0)
+}
+
+function Test-ReparsePoint([string]$Path) {
+    $item = Get-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue
+    return ($null -ne $item) -and (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0)
+}
+
+# A Python 3.10 already unpacked in runtime\python, in a real folder (never
+# through uv's 'cpython-3.10-...' junction). Newest patch version first.
+function Find-RuntimePython {
+    $dirs = @(Get-ChildItem -LiteralPath $PyRoot -Directory -ErrorAction SilentlyContinue |
+        Where-Object { $_.Name -match '^cpython-3\.10\.\d+-windows-x86_64-none$' -and -not (Test-ReparsePoint $_.FullName) } |
+        Sort-Object { [int]($_.Name -replace '^cpython-3\.10\.(\d+)-.*$', '$1') } -Descending)
+    foreach ($d in $dirs) {
+        $exe = Join-Path $d.FullName 'python.exe'
+        if (Test-Python $exe) { return $exe }
+    }
+    return $null
+}
+
+# 1st way: uv downloads and unpacks Python. uv then also makes a
+# 'cpython-3.10-...' junction; some PCs block that (Windows error 448
+# "untrusted mount point", e.g. OneDrive Files On-Demand or security
+# software) and uv reports failure although Python is unpacked and fine.
+# QuokkaForm never uses the junction, so only the unpacked folder counts.
+function Install-PythonWithUv {
+    $env:UV_PYTHON_INSTALL_DIR = $PyRoot
+    $code = Invoke-Tool $Uv @('python', 'install', $PyVersion, '--no-bin', '--no-registry')
+    Remove-Item Env:UV_PYTHON_INSTALL_DIR -ErrorAction SilentlyContinue
+    $script:UvPythonError = ''
+    if ($code -ne 0) { $script:UvPythonError = Get-ToolError }
+    $exe = Find-RuntimePython
+    if ($exe -and $code -ne 0) {
+        Say ('uv could not make its optional "cpython-3.10" folder link (' + $script:UvPythonError + ').') 'Yellow'
+        Say 'That link is not needed: Python itself was unpacked correctly and is used directly.' 'Yellow'
+    }
+    return $exe
+}
+
+# 2nd way: the same Python build downloaded directly (SHA-256 checked) and
+# unpacked with Windows' own tar.exe.
+function Install-PythonDirect {
+    $archive = Join-Path $Downloads $PyArchive
+    $target = Join-Path $PyRoot $PyDirName
+    $tmp = Join-Path $PyRoot '.quokkaform-unpack'
+    try {
+        if (-not (Test-Path -LiteralPath $archive)) {
+            Say ('Downloading Python ' + $PyVersion + ': ' + $PyArchiveUrl)
+            Invoke-WebRequest -UseBasicParsing -Uri $PyArchiveUrl -OutFile ($archive + '.part')
+            Move-Item -Force -LiteralPath ($archive + '.part') -Destination $archive
+        }
+        $hash = (Get-FileHash -Algorithm SHA256 -LiteralPath $archive).Hash.ToLower()
+        if ($hash -ne $PyArchiveSha) {
+            Remove-Item -LiteralPath $archive -ErrorAction SilentlyContinue
+            Say ('The Python download has an unexpected SHA-256 (' + $hash + '); not using it.') 'Yellow'
+            return $null
+        }
+        $tar = Join-Path $env:SystemRoot 'System32\tar.exe'
+        if (-not (Test-Path -LiteralPath $tar)) {
+            $cmd = Get-Command 'tar.exe', 'tar' -ErrorAction SilentlyContinue | Select-Object -First 1
+            if ($null -eq $cmd) { Say 'tar.exe (part of Windows 10 1803 and newer) was not found.' 'Yellow'; return $null }
+            $tar = $cmd.Source
+        }
+        if (Test-Path -LiteralPath $tmp) { Remove-Item -Recurse -Force -LiteralPath $tmp }
+        New-Item -ItemType Directory -Force -Path $tmp | Out-Null
+        if ((Invoke-Tool $tar @('-xzf', $archive, '-C', $tmp)) -ne 0) { return $null }
+        if (Test-Path -LiteralPath $target) { Remove-Item -Recurse -Force -LiteralPath $target }
+        Move-Item -LiteralPath (Join-Path $tmp 'python') -Destination $target
+        Remove-Item -Recurse -Force -LiteralPath $tmp -ErrorAction SilentlyContinue
+    } catch {
+        Say ('Direct Python download / unpack failed: ' + $_.Exception.Message) 'Yellow'
+        return $null
+    }
+    $exe = Join-Path $target 'python.exe'
+    if (Test-Python $exe) { return $exe }
+    return $null
+}
+
+# 3rd way: a 64-bit Python 3.10 already installed on this PC (python.org).
+function Find-SystemPython {
+    $candidates = @()
+    $launcher = Get-Command 'py.exe' -ErrorAction SilentlyContinue | Select-Object -First 1
+    if ($launcher) {
+        $out = & $launcher.Source '-3.10-64' '-c' 'import sys; print(sys.executable)' 2>$null
+        if ($LASTEXITCODE -eq 0 -and $out) { $candidates += ("" + @($out)[0]).Trim() }
+    }
+    foreach ($c in @(Get-Command 'python.exe' -All -ErrorAction SilentlyContinue)) {
+        if ($c.Source -notmatch '\\WindowsApps\\') { $candidates += $c.Source }   # skip the Microsoft Store stub
+    }
+    $candidates += (Join-Path $env:LOCALAPPDATA 'Programs\Python\Python310\python.exe')
+    if ($env:ProgramFiles) { $candidates += (Join-Path $env:ProgramFiles 'Python310\python.exe') }
+    foreach ($exe in $candidates) {
+        if (Test-Python $exe) { return $exe }
+    }
+    return $null
+}
+
+# The venv must point at the real Python folder, not at a junction.
+function Repair-VenvHome([string]$BaseExe) {
+    $cfg = Join-Path $Venv 'pyvenv.cfg'
+    if (-not (Test-Path -LiteralPath $cfg)) { return }
+    $want = Split-Path -Parent $BaseExe
+    $lines = @(Get-Content -LiteralPath $cfg)
+    $changed = $false
+    for ($i = 0; $i -lt $lines.Count; $i++) {
+        if ($lines[$i] -match '^\s*home\s*=\s*(.*?)\s*$') {
+            $current = $Matches[1]
+            if ($current -ne $want) {
+                Say ('pyvenv.cfg: home ' + $current + ' -> ' + $want)
+                $lines[$i] = 'home = ' + $want
+                $changed = $true
+            }
+        }
+    }
+    if ($changed) { [System.IO.File]::WriteAllLines($cfg, [string[]]$lines) }
+}
+
 # ---------------------------------------------------------------- 0. start
 $Version = 'unknown'
 $versionFile = Join-Path $AppDir 'VERSION.txt'
