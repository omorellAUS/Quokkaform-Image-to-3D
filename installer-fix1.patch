+def _fake_archive(t):
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tf:
+        tf.add(str(t / "fakepy"), arcname="python/python.exe")
+    return buf.getvalue()
+
+
+def _patch_script(t, sha=None, url="https://127.0.0.1:9/none.tar.gz"):
+    p = t / "QuokkaForm/installer/setup_runtime.ps1"
+    s = p.read_text()
+    if sha:
+        s = re.sub(r"\$PyArchiveSha = '[0-9a-f]{64}'", f"$PyArchiveSha = '{sha}'", s)
+    s = re.sub(r"\$PyArchiveUrl = '[^']*'", f"$PyArchiveUrl = '{url}'", s)
+    p.write_text(s)
+    return re.search(r"\$PyArchive\s+= '([^']+)'", s).group(1)
+
+
+def test_direct_download_fallback_when_uv_cannot_unpack(env):
+    t, e = env
+    e["FAKE_UV_PY"] = "448-noextract"
+    data = _fake_archive(t)
+    name = _patch_script(t, sha=hashlib.sha256(data).hexdigest())
+    (runtime(t) / "downloads").mkdir(parents=True)
+    (runtime(t) / "downloads" / name).write_bytes(data)
+    code, out, calls = run(t, e)
+    assert code == 0, out
+    real = runtime(t) / "python" / PY_DIR
+    assert (real / "python.exe").exists() and not (runtime(t) / "python/.quokkaform-unpack").exists()
+    [v] = venv_calls(calls)
+    assert f"--python {real}/python.exe" in v
+    assert venv_home(t) == str(real)
+
+
+def test_direct_download_with_wrong_hash_is_not_used(env):
+    t, e = env
+    e["FAKE_UV_PY"] = "448-noextract"
+    name = _patch_script(t)               # real pinned SHA, fake archive
+    (runtime(t) / "downloads").mkdir(parents=True)
+    (runtime(t) / "downloads" / name).write_bytes(_fake_archive(t))
+    code, out, calls = run(t, e)
