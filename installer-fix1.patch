@@ -309,9 +452,46 @@ if (Test-Path $VenvPy) {
     }
 }
 if (-not (Test-Path $VenvPy)) {
-    if ((Invoke-Tool $Uv @('venv', $Venv, '--python', '3.10')) -ne 0) {
-        Fail 'Could not install Python 3.10 / create the environment (internet connection?).'
+    New-Item -ItemType Directory -Force -Path $PyRoot | Out-Null
+    $BasePy = Find-RuntimePython
+    if ($BasePy) {
+        Say ('Python 3.10 is already unpacked: ' + $BasePy)
+    } else {
+        $BasePy = Install-PythonWithUv
+    }
+    if (-not $BasePy) {
+        Say 'uv could not install Python; downloading the same Python build directly ...' 'Yellow'
+        $BasePy = Install-PythonDirect
+    }
+    if (-not $BasePy) {
+        Say 'Looking for a Python 3.10 (64-bit) already installed on this PC ...' 'Yellow'
+        $BasePy = Find-SystemPython
+        if ($BasePy) {
+            Warn ('Using the Python 3.10 installed at ' + $BasePy + '. Keep it installed while you use QuokkaForm ' +
+                  '(QuokkaForm does not change it).')
+        }
+    }
+    if (-not $BasePy) {
+        $detail = ''
+        if ($script:UvPythonError) { $detail = ' uv reported: ' + $script:UvPythonError + '.' }
+        if ($script:UvPythonError -match '448|untrusted mount point') {
+            Fail ('Could not set up Python 3.10.' + $detail + ' Windows error 448 means a file-system filter (often OneDrive ' +
+                  'Files On-Demand or security software) blocked a folder link; it is not an internet problem. ' +
+                  'Install Python 3.10 64-bit from https://www.python.org/downloads/release/python-31011/ ' +
+                  '(Windows installer 64-bit), then run the repair again: it will use that Python.')
+        }
+        Fail ('Could not set up Python 3.10.' + $detail + ' Check the internet connection (github.com must be reachable), ' +
+              'or install Python 3.10 64-bit from https://www.python.org/downloads/release/python-31011/ and run the repair again.')
+    }
+    # A half-made environment from an earlier failed run is removed first.
+    if (Test-Path $Venv) { Remove-Item -Recurse -Force $Venv -ErrorAction SilentlyContinue }
+    if ((Invoke-Tool $Uv @('venv', $Venv, '--python', $BasePy)) -ne 0) {
+        Fail ('Could not create the Python environment in ' + $Venv + ' (uv: ' + (Get-ToolError) + '). ' +
+              'Close QuokkaForm and any Python windows, then run the repair again.')
     }
+    Repair-VenvHome $BasePy
+    if (-not (Test-Python $VenvPy)) { Fail ('The new Python environment in ' + $Venv + ' does not start.') }
+    Say ('Environment ready: ' + $Venv + ' (Python ' + $BasePy + ')')
 }
 Remove-Item $Marker -ErrorAction SilentlyContinue
 
