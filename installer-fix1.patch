@@ -0,0 +1,245 @@
+"""Runs installer/setup_runtime.ps1 under PowerShell 7 on Linux with fake
+uv / python / nvidia-smi programs, to check the Python 3.10 step and its
+fallbacks (incl. the Windows error 448 'untrusted mount point' failure seen
+when uv makes its 'cpython-3.10-...' junction). Skipped where pwsh is missing
+(and on Windows, where the bash fakes cannot run)."""
+import hashlib
+import io
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tarfile
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parent.parent
+PWSH = os.environ.get("QF_PWSH") or shutil.which("pwsh") or str(Path.home() / ".local/pwsh/pwsh")
+pytestmark = pytest.mark.skipif(sys.platform == "win32" or not Path(PWSH).exists(),
+                                reason="needs PowerShell 7 (pwsh) on Linux/macOS")
+
+PY_DIR = "cpython-3.10.22-windows-x86_64-none"
+LINK_DIR = "cpython-3.10-windows-x86_64-none"
+
+FAKE_PY = r"""#!/bin/bash
+echo "FAKEPY $0 $*" >> "$QF_T/calls.log"
+venv=$(dirname "$(dirname "$0")")
+if [ "$1" = "-c" ]; then
+  mod=$(echo "$2" | sed -n 's/^import \([a-z_.]*\)$/\1/p')
+  if [ -n "$mod" ]; then
+    for m in $FAKE_MISSING; do if [ "$m" = "$mod" ] && [ ! -e "$venv/installed_$mod" ]; then exit 1; fi; done
+  fi
+  case "$2" in *print*) echo "$0";; esac
+  exit 0
+fi
+echo "  OK  verify (fake)"; exit 0
+"""
+
+FAKE_UV = r"""#!/bin/bash
+echo "FAKEUV $* | INSTALL_DIR=${UV_PYTHON_INSTALL_DIR-unset} DOWNLOADS=${UV_PYTHON_DOWNLOADS-unset}" >> "$QF_T/calls.log"
+case "$1" in
+--version) echo "uv 0.13.5 (fake)"; exit 0;;
+python)
+  d="$UV_PYTHON_INSTALL_DIR/cpython-3.10.22-windows-x86_64-none"
+  case "$FAKE_UV_PY" in
+  ok) mkdir -p "$d"; cp "$QF_T/fakepy" "$d/python.exe"; ln -sfn "$d" "$UV_PYTHON_INSTALL_DIR/cpython-3.10-windows-x86_64-none"
+      echo "Installed Python 3.10.22"; exit 0;;
+  448) mkdir -p "$d"; cp "$QF_T/fakepy" "$d/python.exe"
+      echo "error: Failed to create Python minor version link directory" >&2
+      echo "  cause: The path cannot be traversed because it contains an untrusted mount point. (os error 448)" >&2; exit 2;;
+  448-noextract)
+      echo "error: Failed to create Python minor version link directory" >&2
+      echo "  cause: The path cannot be traversed because it contains an untrusted mount point. (os error 448)" >&2; exit 2;;
+  esac;;
+venv)
+  mkdir -p "$2/Scripts"; cp "$QF_T/fakepy" "$2/Scripts/python.exe"
+  home=$(dirname "$4"); [ -n "$FAKE_VENV_HOME" ] && home="$FAKE_VENV_HOME"
+  printf 'home = %s\nimplementation = CPython\nversion_info = 3.10.22\n' "$home" > "$2/pyvenv.cfg"; exit 0;;
+pip)
+  venv=$(dirname "$(dirname "$4")")
+  for a in "$@"; do
+    case "$a" in *nvdiffrast*) touch "$venv/installed_nvdiffrast.torch";; *diff_gaussian*) touch "$venv/installed_diff_gaussian_rasterization";; esac
+  done
+  echo "Installed packages (fake)"; exit ${FAKE_UV_PIP_RC:-0};;
+esac
+exit 0
+"""
+
+
+def _exe(path: Path, text: str):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text)
+    path.chmod(0o755)
+
+
+@pytest.fixture
+def env(tmp_path):
+    t = tmp_path
+    app = t / "QuokkaForm"
+    (app / "installer").mkdir(parents=True)
+    for f in ("setup_runtime.ps1", "verify_runtime.py", "requirements-lock-win.txt"):
+        shutil.copy(ROOT / "installer" / f, app / "installer" / f)
+    (app / "VERSION.txt").write_text("QuokkaForm test\n")
+    (app / "wheels").mkdir()
+    (app / "wheels" / "nvdiffrast-0.4.0-cp310-cp310-win_amd64.whl").write_text("x")
+    (app / "wheels" / "diff_gaussian_rasterization-0.0.0-cp310-cp310-win_amd64.whl").write_text("x")
+    _exe(t / "fakepy", FAKE_PY)
+    _exe(app / "tools" / "uv.exe", FAKE_UV)
+    _exe(t / "win" / "System32" / "nvidia-smi.exe", '#!/bin/bash\necho "NVIDIA GeForce RTX 3060, 610.62, 12288"\n')
+    (t / "local").mkdir()
+    (t / "bin").mkdir()
+    e = {k: v for k, v in os.environ.items() if not k.startswith(("UV_", "VIRTUAL_ENV"))}
+    e.update(QF_T=str(t), LOCALAPPDATA=str(t / "local"), SystemRoot=str(t / "win"), ProgramFiles=str(t / "pf"),
+             FAKE_UV_PY="ok", FAKE_MISSING="nvdiffrast.torch diff_gaussian_rasterization",
+             PATH=str(t / "bin") + ":/usr/bin:/bin")
+    e["ProgramFiles(x86)"] = str(t / "pf86")
+    return t, e
+
+
+def run(t, e, *args):
+    r = subprocess.run([PWSH, "-NoProfile", "-File", str(t / "QuokkaForm/installer/setup_runtime.ps1"),
+                        "-Unattended", "-Models", "no", *args], env=e, capture_output=True, text=True, timeout=180)
+    calls = (t / "calls.log").read_text() if (t / "calls.log").exists() else ""
+    (t / "calls.log").unlink(missing_ok=True)
+    return r.returncode, r.stdout + r.stderr, calls
+
+
+def runtime(t):
+    return t / "local/QuokkaForm/runtime"
+
+
+def venv_calls(calls):
+    return [line for line in calls.splitlines() if line.startswith("FAKEUV venv")]
+
+
+def venv_home(t):
+    return re.search(r"^home = (.*)$", (runtime(t) / "venv/pyvenv.cfg").read_text(), re.M).group(1)
+
+
+def test_normal_install_then_rerun(env):
+    t, e = env
+    code, out, calls = run(t, e)
+    assert code == 0, out
+    real = runtime(t) / "python" / PY_DIR
+    assert "FAKEUV python install 3.10.22 --no-bin --no-registry" in calls
+    [v] = venv_calls(calls)
+    assert f"--python {real}/python.exe" in v and "INSTALL_DIR=unset" in v and "DOWNLOADS=manual" in v
+    assert venv_home(t) == str(real)
+    assert (runtime(t) / "venv/quokkaform-setup.json").exists()
+    code, out, calls = run(t, e)
+    assert code == 0, out
+    assert "python install" not in calls and not venv_calls(calls) and "Already installed" in out
+
