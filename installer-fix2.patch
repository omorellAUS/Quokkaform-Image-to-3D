diff --git a/tests/test_server_queue.py b/tests/test_server_queue.py
new file mode 100644
index 0000000..b227386
--- /dev/null
+++ b/tests/test_server_queue.py
@@ -0,0 +1,155 @@
+"""Regression test for 0.9.2: queued Gradio events in desktop mode.
+
+The desktop launcher builds and launches the Gradio app in a worker thread
+(desktop.ServerThread). Gradio 4.x only creates its asyncio lock / stop event
+when that thread has an event loop, so in 0.9.1 every queued action failed
+("Connection errored out"; AttributeError __aenter__ in queueing.push and
+'NoneType' object has no attribute 'wait' in routes.stop_stream).
+
+This starts the server exactly like desktop mode does (ServerThread imports
+``app.main`` *inside* the thread) with a tiny stand-in for app.main, and runs
+a queued event over HTTP (/queue/join + /queue/data).
+"""
+import importlib.abc
+import importlib.util
+import json
+import socket
+import sys
+import uuid
+
+import pytest
+
+gr = pytest.importorskip("gradio")
+httpx = pytest.importorskip("httpx")
+
+from app import desktop  # noqa: E402
+from app.backend import instance  # noqa: E402
+
+STUB_MAIN = '''
+import gradio as gr
+with gr.Blocks() as demo:
+    box_in = gr.Textbox()
+    box_out = gr.Textbox()
+    btn = gr.Button()
+    btn.click(lambda s: s[::-1], box_in, box_out, api_name="reverse")   # queued (default)
+'''
+
+
+class _StubMainFinder(importlib.abc.MetaPathFinder, importlib.abc.Loader):
+    """Serves a small Blocks as ``app.main``, built when it is imported."""
+
+    def find_spec(self, name, path, target=None):
+        return importlib.util.spec_from_loader(name, self) if name == "app.main" else None
+
+    def create_module(self, spec):
+        return None
+
+    def exec_module(self, module):
+        exec(STUB_MAIN, module.__dict__)
+
+
+@pytest.fixture
+def stub_app_main():
+    import app as app_pkg
+
+    saved_mod = sys.modules.pop("app.main", None)
+    had_attr = hasattr(app_pkg, "main")
+    saved_attr = getattr(app_pkg, "main", None)
+    if had_attr:
+        delattr(app_pkg, "main")
+    finder = _StubMainFinder()
+    sys.meta_path.insert(0, finder)
+    try:
+        yield
+    finally:
+        sys.meta_path.remove(finder)
+        sys.modules.pop("app.main", None)
+        if saved_mod is not None:
+            sys.modules["app.main"] = saved_mod
+        if had_attr:
+            app_pkg.main = saved_attr
+        elif hasattr(app_pkg, "main"):
+            delattr(app_pkg, "main")
+
+
+def _free_port():
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+def _queued_round_trip(url, fn_index, text, timeout=30):
+    session = uuid.uuid4().hex[:10]
+    with httpx.Client(base_url=url, timeout=timeout, trust_env=False) as c:
+        r = c.post("queue/join", json={"data": [text], "fn_index": fn_index, "session_hash": session,
+                                        "event_data": None, "trigger_id": None})
+        assert r.status_code == 200, r.text
+        with c.stream("GET", "queue/data", params={"session_hash": session}) as stream:
+            assert stream.status_code == 200
+            for line in stream.iter_lines():
+                if not line.startswith("data:"):
+                    continue
+                msg = json.loads(line[5:])
+                if msg.get("msg") == "process_completed":
+                    return msg
+    raise AssertionError("no process_completed message")
+
+
+def test_desktop_server_thread_runs_queued_events(stub_app_main, capsys):
+    port = _free_port()
+    server = desktop.ServerThread("127.0.0.1", port)
+    server.start()
+    url = instance.url_for("127.0.0.1", port)
+    try:
+        assert instance.wait_until_ready(url, alive=server.alive, timeout=60), repr(server.error)
+        demo = server.demo
+        # Gradio's async primitives exist without any repair
+        assert "Queue check: OK" in capsys.readouterr().out
+        assert demo._queue.pending_message_lock is not None
+        assert demo.server_app.stop_event is not None
+        assert desktop.check_queue(demo) == []
+        fn_index = next(i for i, fn in demo.fns.items() if fn.api_name == "reverse")
+        msg = _queued_round_trip(url, fn_index, "quokka")
+        assert msg["success"] is True, msg
+        assert msg["output"]["data"] == ["akkouq"]
+    finally:
+        server.stop()
+
+
+def test_check_queue_reports_and_repairs_missing_primitives():
+    class Q:
+        pending_message_lock = None
+        delete_lock = object()
+
+    class A:
+        lock = object()
+        stop_event = None
+        startup_events_triggered = True
+
+    class D:
+        _queue, server_app = Q(), A()
+
+    d = D()
+    problems = desktop.check_queue(d)
+    assert problems == ["Q.pending_message_lock is None", "A.stop_event is None"]
+    assert d._queue.pending_message_lock is not None and d.server_app.stop_event is not None
+    assert desktop.check_queue(d) == []
+    d.server_app.startup_events_triggered = False
+    assert "startup events" in desktop.check_queue(d)[0]
+    assert desktop.check_queue(object()) == ["the Gradio server app or queue does not exist"]
+
+
+def test_server_thread_gets_an_event_loop():
+    import asyncio
+    import threading
+
+    seen = {}
+
+    def worker():
+        desktop.ensure_thread_event_loop()
+        seen["loop"] = asyncio.get_event_loop()
+
+    t = threading.Thread(target=worker)
+    t.start()
+    t.join(10)
+    assert isinstance(seen.get("loop"), asyncio.AbstractEventLoop)
