diff --git a/app/desktop.py b/app/desktop.py
index ed11a63..7a517be 100644
--- a/app/desktop.py
+++ b/app/desktop.py
@@ -27,6 +27,7 @@ import sys
 import threading
 import time
 import traceback
+import warnings
 from pathlib import Path
 
 ROOT = Path(__file__).resolve().parent.parent
@@ -305,6 +306,58 @@ LINK_GUARD_JS = r"""
 
 # ------------------------------------------------------------------ server
 
+def ensure_thread_event_loop() -> None:
+    """Give the calling (non-main) thread its own asyncio event loop.
+
+    Gradio 4.x creates its asyncio primitives (``Queue.pending_message_lock``,
+    ``App.stop_event``, ...) when the Blocks and the server app are built, and
+    only if ``asyncio.get_event_loop()`` works in that thread; otherwise it
+    silently stores None. The main thread always gets a loop, a plain worker
+    thread does not, so building the UI in the server thread left them None:
+    every queued action then failed ("Connection errored out", AttributeError
+    __aenter__ / 'NoneType' object has no attribute 'wait'). The loop is never
+    run: since Python 3.10 these primitives bind to uvicorn's loop on first use.
+    """
+    import asyncio
+
+    try:
+        asyncio.get_running_loop()
+        return
+    except RuntimeError:
+        pass
+    try:
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore", DeprecationWarning)
+            asyncio.get_event_loop()
+    except RuntimeError:
+        asyncio.set_event_loop(asyncio.new_event_loop())
+
+
+def check_queue(demo, repair: bool = True) -> list:
+    """Problems with Gradio's queue primitives after launch ([] = fine).
+
+    With ``repair`` missing primitives are created (safe on Python 3.10+:
+    asyncio locks and events bind to the server loop on first use)."""
+    import asyncio
+
+    problems = []
+    queue = getattr(demo, "_queue", None)
+    app = getattr(demo, "server_app", None)
+    if queue is None or app is None:
+        return ["the Gradio server app or queue does not exist"]
+    for owner, attr, factory in ((queue, "pending_message_lock", asyncio.Lock),
+                                 (queue, "delete_lock", asyncio.Lock),
+                                 (app, "lock", asyncio.Lock),
+                                 (app, "stop_event", asyncio.Event)):
+        if getattr(owner, attr, None) is None:
+            problems.append(f"{type(owner).__name__}.{attr} is None")
+            if repair:
+                setattr(owner, attr, factory())
+    if not getattr(app, "startup_events_triggered", False):
+        problems.append("the queue was not started (startup events did not run)")
+    return problems
+
+
 class ServerThread(threading.Thread):
     """Imports app.main (the Gradio Blocks) and serves it on host:port."""
 
@@ -317,11 +370,19 @@ class ServerThread(threading.Thread):
 
     def run(self):
         try:
+            ensure_thread_event_loop()  # before app.main builds the Blocks (see there)
             from app import main as app_main, ui_theme
 
             self.demo = app_main.demo
             self.demo.launch(server_name=self.host, server_port=self.port, favicon_path=ui_theme.FAVICON,
                              inbrowser=False, prevent_thread_lock=True, show_error=True, quiet=False)
+            problems = check_queue(self.demo)
+            if problems:
+                print("QUEUE CHECK FAILED: " + "; ".join(problems) + ". Actions would fail with "
+                      "'Connection errored out'; the missing parts were recreated. If actions still fail, "
+                      "run QuokkaForm Setup (repair) and send this log file.")
+            else:
+                print("Queue check: OK")
             self.started_ok.set()
         except BaseException as e:  # noqa: BLE001 - reported in the window
             traceback.print_exc()
