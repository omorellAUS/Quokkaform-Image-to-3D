+def test_lazy_module_without_version_counts_as_working():
+    """utils3d resolves unknown attributes as submodules: reading __version__
+    raises ModuleNotFoundError although the import worked (0.9.1 setup then
+    stopped with 'MISSING utils3d')."""
+    class Lazy:
+        def __getattr__(self, name):
+            raise ModuleNotFoundError(f"No module named 'utils3d.{name}'")
+
+    rows = vr.check_imports([("utils3d", "utils3d", True, "")], lambda name: Lazy())
+    assert rows == [("utils3d", True, True, "ok")]
+    assert vr.summarise(rows) == 0
+
+
 def test_summarise():
     assert vr.summarise([("a", True, True, "")]) == 0
     assert vr.summarise([("a", True, True, ""), ("b", False, False, "")]) == 2
