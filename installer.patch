+<#
+.SYNOPSIS
+    Build nvdiffrast and diff-gaussian-rasterization wheels for bundling.
+
+.DESCRIPTION
+    Optional. Builds both CUDA extensions once, on a PC with the CUDA 12.4
+    toolkit and the Visual Studio 2022 C++ Build Tools, into
+    installer\wheels\. build_zip.py then bundles them and setup_runtime.ps1
+    installs them, so other PCs need neither tool. Uses the dev folder's
+    venv (torch 2.5.1 + CUDA 12.4, run start.bat once first).
+
+    The wheels are built for these GPU generations (TORCH_CUDA_ARCH_LIST):
+    Turing (RTX 20xx) 7.5, Ampere 8.0 / 8.6 (RTX 30xx), Ada 8.9 (RTX 40xx),
+    Hopper 9.0 + PTX for newer cards.
+
+.EXAMPLE
+    powershell -ExecutionPolicy Bypass -File installer\build_wheels.ps1
+#>
+[CmdletBinding()]
+param(
+    [string]$Python,
+    [string]$CudaArchList = '7.5;8.0;8.6;8.9;9.0+PTX'
+)
+$ErrorActionPreference = 'Continue'
+$Repo = Split-Path -Parent $PSScriptRoot
+$Out = Join-Path $PSScriptRoot 'wheels'
+New-Item -ItemType Directory -Force -Path $Out | Out-Null
+if (-not $Python) { $Python = Join-Path $Repo 'venv\Scripts\python.exe' }
+if (-not (Test-Path $Python)) { Write-Host 'Run start.bat once first (venv\Scripts\python.exe is missing).' -ForegroundColor Red; exit 1 }
+
+# Same pinned sources as installer\setup_runtime.ps1
+$Sources = @(
+    'https://github.com/NVlabs/nvdiffrast/archive/253ac4fcea7de5f396371124af597e6cc957bfae.zip',
+    'https://github.com/autonomousvision/mip-splatting/archive/dda02ab5ecf45d6edb8c540d9bb65c7e451345a9.zip#subdirectory=submodules/diff-gaussian-rasterization'
+)
+
+# MSVC (vcvars64.bat via vswhere), written to a temp .cmd to avoid quoting problems
+if ($null -eq (Get-Command 'cl.exe' -ErrorAction SilentlyContinue)) {
+    $vswhere = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe'
+    if (-not (Test-Path $vswhere)) { Write-Host 'Visual Studio Build Tools not found (vswhere.exe).' -ForegroundColor Red; exit 1 }
+    $vs = & $vswhere -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath
+    $vcvars = Join-Path (@($vs)[0]) 'VC\Auxiliary\Build\vcvars64.bat'
+    if (-not (Test-Path $vcvars)) { Write-Host 'vcvars64.bat not found; install the C++ workload.' -ForegroundColor Red; exit 1 }
+    $envCmd = Join-Path $env:TEMP 'quokkaform-vcvars-env.cmd'
+    [System.IO.File]::WriteAllText($envCmd, ('@call "' + $vcvars + '" >nul 2>&1' + "`r`n" + '@set' + "`r`n"))
+    foreach ($line in (& cmd.exe /d /c $envCmd)) {
+        if ($line -match '^([^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2], 'Process') }
+    }
+}
+if (-not $env:CUDA_PATH) { Write-Host 'CUDA_PATH is not set; install the CUDA 12.4 toolkit.' -ForegroundColor Red; exit 1 }
+$env:CUDA_HOME = $env:CUDA_PATH
+$env:DISTUTILS_USE_SDK = '1'
+$env:TORCH_CUDA_ARCH_LIST = $CudaArchList
+$env:Path = (Join-Path $env:CUDA_PATH 'bin') + ';' + (Split-Path -Parent $Python) + ';' + $env:Path
+
+foreach ($src in $Sources) {
+    Write-Host "Building $src ..." -ForegroundColor Cyan
+    & $Python -m pip wheel --no-deps --no-build-isolation --no-cache-dir -w $Out $src
+    if ($LASTEXITCODE -ne 0) { Write-Host "Build failed: $src" -ForegroundColor Red; exit 1 }
+}
+Write-Host "Wheels in $Out :" -ForegroundColor Green
+Get-ChildItem $Out -Filter '*.whl' | ForEach-Object { Write-Host ('  ' + $_.Name) }
