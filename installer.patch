+# --------------------------------------------- 6. Gaussian rasteriser
+Step 'diff-gaussian-rasterization (textures and the 360 video)'
+if ((-not $Reinstall) -and (Test-Import 'diff_gaussian_rasterization')) {
+    Say 'Already installed.'
+} else {
+    $done = $false
+    $local = Get-ChildItem $Wheels -Filter 'diff_gaussian_rasterization-*.whl' -ErrorAction SilentlyContinue | Select-Object -First 1
+    if ($local) {
