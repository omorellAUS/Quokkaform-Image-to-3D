+; QuokkaForm - Images To Mesh: Windows installer (Inno Setup 6.4 or newer).
+;
+; Build:  1. powershell -ExecutionPolicy Bypass -File installer\build_zip.ps1
+;            (makes dist\QuokkaForm\, the files packed below)
+;         2. open this file in Inno Setup 6 and press Build > Compile
+;            (or: build_zip.ps1 -Installer, or ISCC.exe installer\QuokkaForm.iss)
+;         -> installer\Output\QuokkaForm-Setup-<version>.exe
+;
+; Per-user install, no admin rights: %LOCALAPPDATA%\Programs\QuokkaForm.
+; After copying the files it runs installer\setup_runtime.ps1 in a console
+; window: Python 3.10 (uv), the packages, the GPU components and, if ticked,
+; the AI models. The uninstaller removes the program and its Python runtime;
+; downloaded models, settings and outputs stay unless the user ticks them.
+; Not code-signed: Windows SmartScreen shows "Windows protected your PC" ->
+; click "More info" -> "Run anyway".
+
+#define AppName "QuokkaForm"
+#define AppFullName "QuokkaForm - Images To Mesh"
+; Keep in sync with app/version.py (tests/test_installer_files.py checks it)
+#define AppVersion "0.9.0"
+#define AppPublisher "Perth Resoles"
+#define SourceDir "..\dist\QuokkaForm"
+#define AppIcon "app\assets\quokkaform.ico"
+#define RuntimeDir "{localappdata}\QuokkaForm\runtime"
+#define PythonW "{localappdata}\QuokkaForm\runtime\venv\Scripts\pythonw.exe"
+#define AppUserModelID "PerthResoles.QuokkaForm"
+
+[Setup]
+AppId={{63F6A6D6-7F24-49B2-BDBF-247F132F2EF4}
+AppName={#AppName}
+AppVersion={#AppVersion}
+AppVerName={#AppFullName} {#AppVersion}
+AppPublisher={#AppPublisher}
+AppCopyright=Copyright (c) {#AppPublisher}. Free for non-commercial use.
+VersionInfoVersion={#AppVersion}
+VersionInfoCompany={#AppPublisher}
+VersionInfoDescription={#AppFullName} Setup
+VersionInfoProductName={#AppFullName}
+; per user, never asks for admin rights
+PrivilegesRequired=lowest
+DefaultDirName={autopf}\{#AppName}
+DefaultGroupName={#AppName}
+DisableProgramGroupPage=yes
+LicenseFile={#SourceDir}\LICENSE_AND_NOTICES.txt
+SetupIconFile={#SourceDir}\{#AppIcon}
+UninstallDisplayIcon={app}\{#AppIcon}
+UninstallDisplayName={#AppFullName}
+WizardStyle=modern
+OutputDir=Output
+OutputBaseFilename=QuokkaForm-Setup-{#AppVersion}
+Compression=lzma2/max
+SolidCompression=yes
+ArchitecturesAllowed=x64compatible
+ArchitecturesInstallIn64BitMode=x64compatible
+MinVersion=10.0
+; app/desktop.py holds this mutex while the window is open
+AppMutex=QuokkaFormDesktop
+CloseApplications=no
+
+[Languages]
+Name: "english"; MessagesFile: "compiler:Default.isl"
+
+[Tasks]
+Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
+Name: "downloadmodels"; Description: "Download the AI models during setup (about 4.3 GB; otherwise later in the app)"; GroupDescription: "Models:"
+
+[InstallDelete]
+; an update replaces these folders completely (no stale files from older versions)
+Type: filesandordirs; Name: "{app}\app"
+Type: filesandordirs; Name: "{app}\TRELLIS"
+Type: filesandordirs; Name: "{app}\installer"
+Type: filesandordirs; Name: "{app}\wheels"
+Type: filesandordirs; Name: "{app}\tools"
+
+[Files]
+Source: "{#SourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
+
+[Icons]
+Name: "{group}\QuokkaForm"; Filename: "{#PythonW}"; Parameters: """{app}\app\desktop.py"""; WorkingDir: "{app}"; IconFilename: "{app}\{#AppIcon}"; Comment: "{#AppFullName}"; AppUserModelID: "{#AppUserModelID}"
