+    assert out["HF_HUB_CACHE"] == str(user / ".cache" / "huggingface" / "hub")
+    assert out["TORCH_HOME"] == str(user / ".cache" / "torch")
+    assert out["U2NET_HOME"] == str(user / ".u2net")
