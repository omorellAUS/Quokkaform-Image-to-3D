+
+# --------------------------------------------------------------- 9. models
+Step 'AI models (TRELLIS, DINOv2, BiRefNet lite, SAM 2.1 Small; about 4.3 GB)'
+$getModels = $false
+if ($Models -eq 'yes') { $getModels = $true }
+elseif ($Models -eq 'ask') {
