+"""The kaolin stub (app/stubs) behaves like kaolin.utils.testing.check_tensor
+and lets TRELLIS's FlexiCubes import without the real kaolin."""
+import importlib
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+torch = pytest.importorskip("torch")
+ROOT = Path(__file__).resolve().parent.parent
+STUBS = ROOT / "app" / "stubs"
+
+
+def _stub_testing():
+    sys.path.insert(0, str(STUBS))
+    try:
+        for name in [m for m in sys.modules if m == "kaolin" or m.startswith("kaolin.")]:
+            del sys.modules[name]
+        return importlib.import_module("kaolin.utils.testing")
+    finally:
+        sys.path.remove(str(STUBS))
+        for name in [m for m in sys.modules if m == "kaolin" or m.startswith("kaolin.")]:
+            del sys.modules[name]
+
+
+def test_check_tensor_shape_dtype_device():
+    check_tensor = _stub_testing().check_tensor
+    t = torch.zeros(5, 3)
+    assert check_tensor(t, (None, 3), throw=False)
+    assert check_tensor(t, (5, 3), dtype=torch.float32, device="cpu")
+    assert not check_tensor(t, (None, 8), throw=False)
+    assert not check_tensor(t, (5,), throw=False)
+    assert not check_tensor(t, dtype=torch.int64, throw=False)
+    assert not check_tensor(t, device="cuda", throw=False)
+    with pytest.raises(ValueError):
+        check_tensor(t, (4, 3))
+    with pytest.raises(TypeError):
+        check_tensor(t, dtype=torch.float16)
+
+
+def test_stub_is_appended_so_real_kaolin_wins():
+    src = (ROOT / "app" / "backend" / "model.py").read_text(encoding="utf-8")
+    assert "sys.path.append(str(STUBS_PATH))" in src
+
+
+TRELLIS = Path(os.environ.get("TRELLIS_SRC", "/workspace/TRELLIS"))
+
+
+@pytest.mark.skipif(not (TRELLIS / "trellis" / "representations" / "mesh" / "flexicubes" / "flexicubes.py").is_file(),
+                    reason="TRELLIS source with FlexiCubes not available")
+def test_flexicubes_imports_with_stub():
+    # Import FlexiCubes as a namespace package (skips trellis/__init__ and its
+    # heavy dependencies); its "from kaolin.utils.testing import check_tensor"
+    # must resolve to the stub.
+    mesh_dir = TRELLIS / "trellis" / "representations" / "mesh"
+    code = ("import sys; sys.path.insert(0, %r); sys.path.append(%r);\n"
+            "import importlib.util as u\n"
+            "assert u.find_spec('kaolin').origin.startswith(%r), 'real kaolin installed, stub not exercised'\n"
+            "from flexicubes.flexicubes import FlexiCubes\n"
+            "import torch, itertools\n"
+            "fc = FlexiCubes(device='cpu'); r = 4\n"
+            "g = torch.stack(torch.meshgrid(*[torch.arange(r + 1)] * 3, indexing='ij'), -1).reshape(-1, 3)\n"
+            "idx = lambda x, y, z: (x * (r + 1) + y) * (r + 1) + z\n"
+            "cubes = torch.tensor([[idx(x + dx, y + dy, z + dz) for dz, dy, dx in "
+            "itertools.product((0, 1), repeat=3)] for x in range(r) for y in range(r) for z in range(r)])\n"
+            "v = g.float() / r - 0.5; sdf = v.norm(dim=1) - 0.3\n"
+            "verts, faces, _, _ = fc(v, sdf, cubes, r)\n"
+            "assert verts.shape[0] > 0 and faces.shape[1] == 3, (verts.shape, faces.shape)\n"
+            "print('ok')") % (str(mesh_dir), str(STUBS), str(STUBS))
+    r = subprocess.run([sys.executable, "-c", code], capture_output=True, text=True)
+    if "real kaolin installed" in r.stderr:
+        pytest.skip("real kaolin installed in this environment")
+    assert r.returncode == 0, r.stderr[-2000:]
+    assert "ok" in r.stdout
-- 
