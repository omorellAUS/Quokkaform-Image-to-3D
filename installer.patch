new file mode 100644
index 0000000..87afcc5
--- /dev/null
+++ b/installer/build_zip.ps1
@@ -0,0 +1,46 @@
+<#
+.SYNOPSIS
+    Build the portable QuokkaForm zip (and optionally setup.exe) on Windows.
+
+.DESCRIPTION
+    Runs installer\build_zip.py with the dev folder's venv (it has torch,
+    which building the sam2 wheel needs; run start.bat once first).
+    Output: dist\QuokkaForm\ and dist\QuokkaForm-<version>-portable.zip.
+    With -Installer it then compiles installer\QuokkaForm.iss with Inno
+    Setup 6 (ISCC.exe) into installer\Output\QuokkaForm-Setup-<version>.exe.
+
+.EXAMPLE
+    powershell -ExecutionPolicy Bypass -File installer\build_zip.ps1 -Installer
+#>
+[CmdletBinding()]
+param(
+    [switch]$Installer,
+    [string]$Python
+)
+$ErrorActionPreference = 'Stop'
+$Repo = Split-Path -Parent $PSScriptRoot
+
+if (-not $Python) {
+    $Python = Join-Path $Repo 'venv\Scripts\python.exe'
+    if (-not (Test-Path $Python)) {
+        throw 'venv\Scripts\python.exe not found. Run start.bat once (it creates the venv), or pass -Python <python.exe with torch>.'
+    }
+}
+
+Write-Host "Building the portable folder and zip with $Python ..." -ForegroundColor Cyan
+& $Python (Join-Path $PSScriptRoot 'build_zip.py') '--python' $Python
+if ($LASTEXITCODE -ne 0) { throw "build_zip.py failed (exit code $LASTEXITCODE)." }
+
+if ($Installer) {
+    $candidates = @(
+        (Join-Path ${env:ProgramFiles(x86)} 'Inno Setup 6\ISCC.exe'),
+        (Join-Path $env:ProgramFiles 'Inno Setup 6\ISCC.exe'),
+        (Join-Path $env:LOCALAPPDATA 'Programs\Inno Setup 6\ISCC.exe')
+    )
+    $iscc = $candidates | Where-Object { Test-Path $_ } | Select-Object -First 1
+    if (-not $iscc) { throw 'Inno Setup 6 (ISCC.exe) not found. Install it from https://jrsoftware.org/isdl.php' }
+    Write-Host "Compiling the installer with $iscc ..." -ForegroundColor Cyan
+    & $iscc (Join-Path $PSScriptRoot 'QuokkaForm.iss')
+    if ($LASTEXITCODE -ne 0) { throw "ISCC failed (exit code $LASTEXITCODE)." }
+    Write-Host ('Done: ' + (Join-Path $PSScriptRoot 'Output')) -ForegroundColor Green
+}
diff --git a/installer/build_zip.py b/installer/build_zip.py
new file mode 100644
index 0000000..beac3ec
--- /dev/null
+++ b/installer/build_zip.py
@@ -0,0 +1,238 @@
+#!/usr/bin/env python3
+"""
+Build the portable QuokkaForm folder + zip (and the input for QuokkaForm.iss).
+
+    python installer/build_zip.py                 # -> dist/QuokkaForm/ and dist/QuokkaForm-<ver>-portable.zip
+    python installer/build_zip.py --no-zip        # folder only (what Inno Setup packs)
+    python installer/build_zip.py --relock        # only regenerate installer/requirements-lock-win.txt
+
+Runs on Windows (installer\\build_zip.ps1 calls it) and Linux. Needs
+internet the first time (downloads are cached in dist/cache) and a Python
+with torch + setuptools + pip for building the sam2 wheel (--python;
+default: this interpreter, e.g. the dev venv).
+
+What goes in (nothing that is downloaded per PC, such as torch, models,
+nvdiffrast or the Gaussian rasteriser):
+  app/                   the QuokkaForm code (no __pycache__)
+  TRELLIS/trellis/       TRELLIS code at a pinned commit (MIT) incl. the
+                         FlexiCubes submodule (Apache-2.0), with licences
+  tools/uv.exe           uv (MIT / Apache-2.0), pinned and hash-checked
+  wheels/                sam2 1.1.0 built without its CUDA extension (pure
+                         Python), plus any wheels in installer/wheels/
+                         (e.g. made by installer/build_wheels.ps1)
+  installer/             setup_runtime.ps1, verify_runtime.py, lock file
+  QuokkaForm.cmd, QuokkaForm Setup.cmd, docs and LICENSE_AND_NOTICES.txt
+"""
+
+import argparse
+import hashlib
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import urllib.request
+import zipfile
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO))
+from app.version import APP_NAME, VERSION  # noqa: E402
+
+TRELLIS_COMMIT = "442aa1e1afb9014e80681d3bf604e8d728a86ee7"
+FLEXICUBES_COMMIT = "815e075a2a400d06c48d94c347674344ed6ae5c5"
+TRELLIS_ZIP = f"https://github.com/microsoft/TRELLIS/archive/{TRELLIS_COMMIT}.zip"
+FLEXICUBES_ZIP = f"https://github.com/MaxtirError/FlexiCubes/archive/{FLEXICUBES_COMMIT}.zip"
+UV_VERSION = "0.13.5"
+UV_ZIP = f"https://github.com/astral-sh/uv/releases/download/{UV_VERSION}/uv-x86_64-pc-windows-msvc.zip"
+UV_SHA256 = "a38b8d1902b7cfbc76b423ba1bb456f623f42064cdc72628b6075b89afd1019a"
+SAM2_VERSION = "1.1.0"
+
+DOCS = ["LICENSE", "THIRD_PARTY_LICENSES.md", "LICENCE_FINDINGS.md", "README.md", "INSTALL_WINDOWS.txt"]
+INSTALLER_FILES = ["setup_runtime.ps1", "verify_runtime.py", "requirements-lock-win.txt", "NOTICE.txt"]
+LAUNCHERS = ["QuokkaForm.cmd", "QuokkaForm Setup.cmd"]
+LOCK_ARGS = ["--python-platform", "x86_64-pc-windows-msvc", "--python-version", "3.10",
+             "--index-strategy", "unsafe-best-match", "--emit-index-url", "--no-header",
+             "--no-binary", "sam2", "--no-binary", "iopath", "--no-binary", "antlr4-python3-runtime"]
+LOCK_HEADER = ("# Generated by: python installer/build_zip.py --relock (uv pip compile of\n"
+               "# installer/requirements-win.in for Windows x64 / CPython 3.10). Do not edit by hand.\n")
+
+
+def log(*a):
+    print(*a, flush=True)
+
+
+def sha256(path: Path) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def fetch(url: str, dest: Path, expect_sha256: str = None) -> Path:
+    """Download once into the cache (temp name, then rename); check the hash."""
+    if not dest.is_file():
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        log(f"Downloading {url}")
+        tmp = dest.with_suffix(dest.suffix + ".part")
+        with urllib.request.urlopen(url, timeout=120) as r, open(tmp, "wb") as f:
+            shutil.copyfileobj(r, f, 1 << 20)
+        tmp.replace(dest)
+    if expect_sha256 and sha256(dest) != expect_sha256:
+        dest.unlink()
+        raise SystemExit(f"SHA-256 mismatch for {url}; the download was removed, run again.")
+    return dest
+
+
+def _ignore(_dir, names):
+    return [n for n in names if n == "__pycache__" or n.endswith((".pyc", ".pyo"))]
+
+
+def relock(uv: str = "uv") -> None:
+    out = REPO / "installer" / "requirements-lock-win.txt"
+    cmd = [uv, "pip", "compile", str(REPO / "installer" / "requirements-win.in"), "-o", str(out)] + LOCK_ARGS
+    log(" ".join(cmd))
+    subprocess.run(cmd, check=True, cwd=REPO)
+    text = out.read_text(encoding="utf-8").replace(str(REPO) + os.sep, "").replace(str(REPO), "")
+    out.write_text(LOCK_HEADER + text, encoding="utf-8")
+    log(f"Wrote {out}")
+
+
+def copy_trellis(dest: Path, cache: Path, trellis_src: Path = None) -> None:
+    """TRELLIS/trellis (+ FlexiCubes) and their licence files."""
+    target = dest / "TRELLIS"
+    if trellis_src:
+        src = Path(trellis_src)
+        if not (src / "trellis" / "representations" / "mesh" / "flexicubes" / "flexicubes.py").is_file():
+            raise SystemExit(f"{src} is not a TRELLIS checkout with the FlexiCubes submodule "
+                             "(git clone --recurse-submodules).")
+        head = subprocess.run(["git", "-C", str(src), "rev-parse", "HEAD"], capture_output=True, text=True)
+        if head.returncode == 0 and head.stdout.strip() != TRELLIS_COMMIT:
+            log(f"WARNING: {src} is at {head.stdout.strip()[:10]}, the tested commit is {TRELLIS_COMMIT[:10]}.")
+        shutil.copytree(src / "trellis", target / "trellis", ignore=_ignore)
+        shutil.copy2(src / "LICENSE", target / "LICENSE")
+    else:
+        tz = fetch(TRELLIS_ZIP, cache / f"TRELLIS-{TRELLIS_COMMIT}.zip")
+        fz = fetch(FLEXICUBES_ZIP, cache / f"FlexiCubes-{FLEXICUBES_COMMIT}.zip")
+        with tempfile.TemporaryDirectory() as tmp:
+            with zipfile.ZipFile(tz) as z:
+                z.extractall(tmp)
+            root = Path(tmp) / f"TRELLIS-{TRELLIS_COMMIT}"
+            flex = root / "trellis" / "representations" / "mesh" / "flexicubes"
+            if flex.exists():
+                shutil.rmtree(flex)
+            with zipfile.ZipFile(fz) as z:
+                z.extractall(tmp)
+            shutil.move(str(Path(tmp) / f"FlexiCubes-{FLEXICUBES_COMMIT}"), str(flex))
+            shutil.copytree(root / "trellis", target / "trellis", ignore=_ignore)
+            shutil.copy2(root / "LICENSE", target / "LICENSE")
+    flex = target / "trellis" / "representations" / "mesh" / "flexicubes"
+    for extra in ("examples", "images"):  # demo code and pictures, not used
+        if (flex / extra).exists():
+            shutil.rmtree(flex / extra)
+    (target / "README.txt").write_text(
+        f"TRELLIS (https://github.com/microsoft/TRELLIS, MIT, see LICENSE) at commit {TRELLIS_COMMIT},\n"
+        f"with FlexiCubes (https://github.com/MaxtirError/FlexiCubes, Apache-2.0, see\n"
+        f"trellis/representations/mesh/flexicubes/LICENSE.txt) at commit {FLEXICUBES_COMMIT}.\n"
+        "Unmodified, except that FlexiCubes' examples/ and images/ folders are left out.\n", encoding="utf-8")
+
+
+def build_sam2_wheel(python: str, out_dir: Path, cache: Path) -> Path:
+    """sam2 1.1.0 without its optional CUDA extension = a pure-Python wheel.
+    Its setup.py imports torch, hence a Python with torch (no build isolation)."""
+    cached = sorted(cache.glob(f"sam2-{SAM2_VERSION}-py3-none-any.whl"))
+    if not cached:
+        log(f"Building the sam2 {SAM2_VERSION} wheel with {python} ...")
+        env = dict(os.environ, SAM2_BUILD_CUDA="0")
+        r = subprocess.run([python, "-m", "pip", "wheel", "--no-deps", "--no-build-isolation", "--no-cache-dir",
+                            "--no-binary", "sam2",
+                            f"sam2=={SAM2_VERSION}", "-w", str(cache)], env=env)
+        cached = sorted(cache.glob(f"sam2-{SAM2_VERSION}-py3-none-any.whl"))
+        if r.returncode != 0 or not cached:
+            raise SystemExit("Could not build the sam2 wheel. Use --python with a Python that has torch, "
+                             "setuptools and pip (e.g. the dev folder's venv\\Scripts\\python.exe).")
+    out_dir.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(cached[-1], out_dir / cached[-1].name)
+    return out_dir / cached[-1].name
+
+
+def write_notices(dest: Path) -> None:
+    parts = [("QuokkaForm licence (MIT)", REPO / "LICENSE"),
+             ("Important notice: free, non-commercial use", REPO / "installer" / "NOTICE.txt"),
+             ("Third-party licences", REPO / "THIRD_PARTY_LICENSES.md")]
+    text = []
+    for title, p in parts:
+        text += ["=" * 72, title, "=" * 72, "", p.read_text(encoding="utf-8").strip(), "", ""]
+    (dest / "LICENSE_AND_NOTICES.txt").write_text("\r\n".join("\n".join(text).split("\n")), encoding="utf-8-sig")
+
+
+def build(out: Path, trellis_src=None, uv_zip=None, python=None, make_zip=True) -> Path:
+    out = out.resolve()
+    cache = out / "cache"
+    dest = out / APP_NAME
+    if dest.exists():
+        shutil.rmtree(dest)
+    dest.mkdir(parents=True)
+    log(f"Building {APP_NAME} {VERSION} in {dest}")
+
+    shutil.copytree(REPO / "app", dest / "app", ignore=_ignore)
+    copy_trellis(dest, cache, trellis_src)
+
+    (dest / "installer").mkdir()
+    for name in INSTALLER_FILES:
+        shutil.copy2(REPO / "installer" / name, dest / "installer" / name)
+    for name in LAUNCHERS + DOCS:
+        shutil.copy2(REPO / name, dest / name)
+    write_notices(dest)
+    (dest / "VERSION.txt").write_text(f"{APP_NAME} {VERSION}\n", encoding="utf-8")
+
+    uvz = Path(uv_zip) if uv_zip else fetch(UV_ZIP, cache / f"uv-{UV_VERSION}-x86_64-pc-windows-msvc.zip", UV_SHA256)
+    if uv_zip and sha256(uvz) != UV_SHA256:
+        raise SystemExit(f"{uvz} is not uv {UV_VERSION} for Windows x64 (SHA-256 differs).")
+    (dest / "tools").mkdir()
+    with zipfile.ZipFile(uvz) as z:
+        names = [n for n in z.namelist() if n.endswith("uv.exe")]
+        (dest / "tools" / "uv.exe").write_bytes(z.read(names[0]))
+    (dest / "tools" / "README.txt").write_text(
+        f"uv {UV_VERSION} (https://github.com/astral-sh/uv), MIT OR Apache-2.0, unmodified.\n"
+        "Used by installer\\setup_runtime.ps1 to install Python 3.10 and the packages.\n", encoding="utf-8")
+
+    wheels = dest / "wheels"
+    build_sam2_wheel(python or sys.executable, wheels, cache)
+    for whl in sorted((REPO / "installer" / "wheels").glob("*.whl")):
+        log(f"Adding prebuilt wheel {whl.name}")
+        shutil.copy2(whl, wheels / whl.name)
+
+    if make_zip:
+        zpath = out / f"{APP_NAME}-{VERSION}-portable.zip"
+        if zpath.exists():
+            zpath.unlink()
+        with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED, compresslevel=9) as z:
+            for p in sorted(dest.rglob("*")):
+                if p.is_file():
+                    z.write(p, Path(APP_NAME) / p.relative_to(dest))
+        log(f"Wrote {zpath} ({zpath.stat().st_size / 1024 ** 2:.1f} MB)")
+        return zpath
+    return dest
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("--out", default=str(REPO / "dist"), help="output folder (default: dist)")
+    ap.add_argument("--trellis-src", help="use this TRELLIS checkout instead of downloading the pinned commit")
+    ap.add_argument("--uv-zip", help="use this uv-x86_64-pc-windows-msvc.zip instead of downloading it")
+    ap.add_argument("--python", help="Python with torch for building the sam2 wheel (default: this one)")
+    ap.add_argument("--no-zip", action="store_true", help="only build the folder")
+    ap.add_argument("--relock", action="store_true", help="regenerate installer/requirements-lock-win.txt and exit")
+    ap.add_argument("--uv", default="uv", help="uv executable for --relock")
+    a = ap.parse_args(argv)
+    if a.relock:
+        relock(a.uv)
+        return 0
+    build(Path(a.out), a.trellis_src, a.uv_zip, a.python, not a.no_zip)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
