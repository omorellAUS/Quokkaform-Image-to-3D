+    env = {"LOCALAPPDATA": str(tmp_path / "Local"), "USERPROFILE": str(tmp_path / "user")}
+    env.update(extra)
+    return env
+
+
+def _touch(p: Path):
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_bytes(b"x")
+
+
+def test_windows_folders(tmp_path):
+    env = _win_env(tmp_path)
+    base = tmp_path / "Local" / "QuokkaForm"
