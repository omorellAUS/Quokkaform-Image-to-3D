+What it does:
+1. Model cache variables (app/backend/paths.py), log file in
+   %LOCALAPPDATA%\\QuokkaForm\\logs (stdout / stderr go there; pythonw has none).
+2. Single instance: a second launch brings the open window to the front.
+   If a QuokkaForm server already answers on the port (e.g. start.bat in
+   dev mode) only a window is opened to it; if the port is taken by
+   another program the next free port (up to 7879) is used.
+3. Shows a "Starting..." page at once, starts the server in this process
+   (background thread), loads the UI when the server answers.
+4. Closing the window stops the server and ends the process, so nothing
+   stays running on the port.
+"""
+
+import argparse
+import base64
+import io
+import json
+import os
+import sys
+import threading
+import time
+import traceback
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from app.backend import instance, paths  # noqa: E402  (light imports only)
+from app.version import APP_NAME, PUBLISHER, VERSION  # noqa: E402
+
+TITLE = instance.APP_TITLE
+ASSETS = ROOT / "app" / "assets"
+ICON = ASSETS / "quokkaform.ico"
+APP_USER_MODEL_ID = "PerthResoles.QuokkaForm"
+MUTEX_NAME = "QuokkaFormDesktop"          # also AppMutex in installer/QuokkaForm.iss
+WEBVIEW2_URL = "https://developer.microsoft.com/microsoft-edge/webview2/"
+DEFAULT_SIZE = (1400, 900)
+MIN_SIZE = (900, 600)
+KEEP_LOGS = 10
+WEBVIEW2_CLIENT = "{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"  # Evergreen runtime
+
+
+# ------------------------------------------------------------------ logging
+
+class _Tee:
+    """Write to the log file and, when there is one, the console."""
+
+    def __init__(self, log, console):
+        self.log, self.console = log, console
+
+    def write(self, s):
+        try:
+            self.log.write(s)
+            self.log.flush()
+        except (OSError, ValueError):
+            pass
+        if self.console is not None:
+            try:
+                self.console.write(s)
+            except (OSError, ValueError, UnicodeError):
+                pass
+        return len(s)
+
+    def flush(self):
+        for f in (self.log, self.console):
+            try:
+                if f is not None:
+                    f.flush()
+            except (OSError, ValueError):
+                pass
+
+    def isatty(self):
+        return False
+
+    def fileno(self):  # some libraries ask; there is no real descriptor
+        raise io.UnsupportedOperation("fileno")
+
+
+def prune_logs(folder: Path, keep: int = KEEP_LOGS, prefix: str = "quokkaform-") -> None:
+    """Delete all but the ``keep`` newest ``<prefix>*.log`` files."""
+    logs = sorted(folder.glob(prefix + "*.log"), key=lambda p: p.stat().st_mtime, reverse=True)
+    for old in logs[keep:]:
+        try:
+            old.unlink()
+        except OSError:
+            pass
+
+
+def setup_logging(folder: Path = None) -> Path:
+    """Send stdout / stderr to logs/quokkaform-<time>.log (and the console if any)."""
+    folder = folder or paths.logs_dir()
+    folder.mkdir(parents=True, exist_ok=True)
+    prune_logs(folder, KEEP_LOGS - 1)
+    log_path = folder / time.strftime("quokkaform-%Y%m%d-%H%M%S.log")
+    log = open(log_path, "a", encoding="utf-8", errors="replace", buffering=1)
+    sys.stdout = _Tee(log, sys.__stdout__)
+    sys.stderr = _Tee(log, sys.__stderr__)
+    print(f"{APP_NAME} {VERSION} ({PUBLISHER}) desktop, Python {sys.version.split()[0]}, "
+          f"{time.strftime('%Y-%m-%d %H:%M:%S')}")
+    return log_path
+
+
+# ------------------------------------------------------------ window state
+
+def config_dir() -> Path:
+    """Same folder as settings_store.config_dir() (kept import-light here)."""
+    if os.environ.get("IMG3D_CONFIG_DIR"):
+        return Path(os.environ["IMG3D_CONFIG_DIR"])
+    if sys.platform.startswith("win") and os.environ.get("APPDATA"):
+        return Path(os.environ["APPDATA"]) / APP_NAME
+    return Path.home() / ".quokkaform"
+
+
+def window_state_path() -> Path:
+    return config_dir() / "window.json"
+
+
+def load_window_state(path: Path = None) -> dict:
+    """{"width", "height", "maximized"}; defaults if missing / damaged."""
+    state = {"width": DEFAULT_SIZE[0], "height": DEFAULT_SIZE[1], "maximized": False}
+    try:
+        data = json.loads((path or window_state_path()).read_text(encoding="utf-8"))
+        w, h = int(data.get("width", 0)), int(data.get("height", 0))
+        if MIN_SIZE[0] <= w <= 10000 and MIN_SIZE[1] <= h <= 10000:
+            state["width"], state["height"] = w, h
+        state["maximized"] = bool(data.get("maximized", False))
+    except (OSError, ValueError, TypeError, AttributeError):
+        pass
+    return state
+
+
+def save_window_state(state: dict, path: Path = None) -> None:
+    path = path or window_state_path()
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps(state), encoding="utf-8")
+    except OSError as e:
+        print("Could not save the window size:", e)
+
+
+# ----------------------------------------------------------- Windows helpers
+
+def _windll():
+    import ctypes
+
+    return ctypes.windll if sys.platform.startswith("win") else None
+
+
+def message_box(text: str, title: str = TITLE, yes_no: bool = False, error: bool = True) -> bool:
+    """Native message box (Windows); prints elsewhere. True = OK / Yes."""
+    print(f"[{title}] {text}")
+    windll = _windll()
+    if windll is None:
+        return False
+    MB_YESNO, MB_ICONERROR, MB_ICONWARNING, MB_SETFOREGROUND = 0x4, 0x10, 0x30, 0x10000
+    flags = (MB_YESNO if yes_no else 0) | (MB_ICONERROR if error else MB_ICONWARNING) | MB_SETFOREGROUND
+    return windll.user32.MessageBoxW(None, text, title, flags) in (1, 6)  # IDOK, IDYES
+
+
+def set_app_user_model_id() -> None:
+    """Own taskbar group and icon (otherwise grouped as pythonw)."""
+    windll = _windll()
+    if windll is not None:
+        try:
+            windll.shell32.SetCurrentProcessExplicitAppUserModelID(APP_USER_MODEL_ID)
+        except (AttributeError, OSError):
+            pass
+
+
+_mutex_handle = None
+
+
+def acquire_single_instance() -> bool:
+    """False if another QuokkaForm window process already runs (Windows)."""
+    global _mutex_handle
+    windll = _windll()
+    if windll is None:
+        return True
+    ERROR_ALREADY_EXISTS = 183
+    _mutex_handle = windll.kernel32.CreateMutexW(None, False, MUTEX_NAME)
+    return windll.kernel32.GetLastError() != ERROR_ALREADY_EXISTS
+
+
+def focus_existing_window() -> bool:
+    """Bring the open QuokkaForm window to the front; False if not found."""
+    windll = _windll()
+    if windll is None:
+        return False
+    hwnd = windll.user32.FindWindowW(None, TITLE)
+    if not hwnd:
+        return False
+    SW_RESTORE = 9
+    if windll.user32.IsIconic(hwnd):
+        windll.user32.ShowWindow(hwnd, SW_RESTORE)
+    windll.user32.SetForegroundWindow(hwnd)
+    return True
+
+
+def webview2_version(reader=None):
+    """Installed WebView2 runtime version string, or None.
+
+    ``reader(root, key)`` returns the "pv" value or None (tests inject one)."""
+    if reader is None:
+        if not sys.platform.startswith("win"):
+            return None
+        import winreg
+
+        def reader(root, key):
+            hive = {"HKLM": winreg.HKEY_LOCAL_MACHINE, "HKCU": winreg.HKEY_CURRENT_USER}[root]
+            try:
+                with winreg.OpenKey(hive, key) as k:
+                    return winreg.QueryValueEx(k, "pv")[0]
+            except OSError:
+                return None
+
+    keys = [("HKLM", rf"SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{WEBVIEW2_CLIENT}"),
+            ("HKLM", rf"SOFTWARE\Microsoft\EdgeUpdate\Clients\{WEBVIEW2_CLIENT}"),
+            ("HKCU", rf"SOFTWARE\Microsoft\EdgeUpdate\Clients\{WEBVIEW2_CLIENT}")]
+    for root, key in keys:
+        v = reader(root, key)
+        if v and v != "0.0.0.0":
+            return v
+    return None
+
+
+# ------------------------------------------------------------------- pages
+
+def _logo_data_uri() -> str:
+    try:
+        return "data:image/png;base64," + base64.b64encode((ASSETS / "icon_256.png").read_bytes()).decode()
+    except OSError:
+        return ""
+
+
+def _page(heading: str, body_html: str, spinner: bool) -> str:
+    spin = ('<div class="spin"></div>' if spinner else "")
+    return f"""<!doctype html><html><head><meta charset="utf-8"><title>{TITLE}</title>
+<style>
+html,body{{height:100%;margin:0}}
+body{{display:flex;align-items:center;justify-content:center;background:#e9ebee;
+font-family:"Segoe UI",system-ui,sans-serif;color:#5a3b1e}}
+.box{{text-align:center;max-width:640px;padding:24px}}
+img{{width:128px;height:128px}}
+h1{{font-size:22px;margin:12px 0 6px;color:#7a4a20}}
+p{{font-size:14px;line-height:1.5;color:#432c17}}
+code{{background:#f2e6d4;padding:2px 6px;border-radius:4px;user-select:all}}
+.spin{{margin:18px auto 0;width:34px;height:34px;border:4px solid #e6cfae;border-top-color:#965c28;
+border-radius:50%;animation:s 1s linear infinite}}
+@keyframes s{{to{{transform:rotate(360deg)}}}}
+</style></head><body><div class="box"><img src="{_logo_data_uri()}" alt="">
+<h1>{heading}</h1>{body_html}{spin}</div></body></html>"""
+
+
+def splash_html() -> str:
+    return _page("Starting QuokkaForm&hellip;",
+                 "<p>Loading the app. The first start after installing can take a minute.</p>", True)
+
+
+def error_html(message: str, log_path) -> str:
+    import html
+
+    return _page("QuokkaForm could not start",
+                 f"<p>{html.escape(message)}</p><p>Details are in the log file:<br><code>{html.escape(str(log_path))}</code></p>"
+                 "<p>If it keeps happening, run <b>QuokkaForm Setup (repair)</b> from the Start menu.</p>", False)
+
+
+# Injected into every page: hide Gradio's footer links and keep every link
+# inside QuokkaForm (no browser): links to other sites only show their
+# address; same-site "open in new tab" links (output files) are downloaded.
+LINK_GUARD_JS = r"""
+(function () {
+  if (window.__quokkaformGuard) return; window.__quokkaformGuard = true;
+  var st = document.createElement('style');
+  st.textContent = 'footer{display:none !important}';
+  (document.head || document.documentElement).appendChild(st);
+  document.addEventListener('click', function (e) {
+    var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
+    if (!a) return;
+    var u; try { u = new URL(a.getAttribute('href'), location.href); } catch (_) { return; }
+    if (u.protocol === 'javascript:') return;
+    if (u.origin === location.origin) {
+      if (a.target === '_blank' && !a.hasAttribute('download')) {
+        e.preventDefault(); e.stopPropagation();
+        var d = document.createElement('a'); d.href = u.href; d.setAttribute('download', '');
+        document.body.appendChild(d); d.click(); d.remove();
+      }
+      return;
+    }
+    if (a.hasAttribute('download')) return;
+    e.preventDefault(); e.stopPropagation();
+    window.alert('This links to a web page:\n\n' + u.href +
+      '\n\nQuokkaForm does not open a web browser. Copy the address if you want to visit it.');
+  }, true);
+})();
+"""
+
+
+# ------------------------------------------------------------------ server
+
+class ServerThread(threading.Thread):
+    """Imports app.main (the Gradio Blocks) and serves it on host:port."""
+
+    def __init__(self, host: str, port: int):
+        super().__init__(name="quokkaform-server", daemon=True)
+        self.host, self.port = host, port
+        self.demo = None
+        self.error = None
+        self.started_ok = threading.Event()
+
+    def run(self):
+        try:
+            from app import main as app_main, ui_theme
+
+            self.demo = app_main.demo
+            self.demo.launch(server_name=self.host, server_port=self.port, favicon_path=ui_theme.FAVICON,
+                             inbrowser=False, prevent_thread_lock=True, show_error=True, quiet=False)
+            self.started_ok.set()
+        except BaseException as e:  # noqa: BLE001 - reported in the window
+            traceback.print_exc()
+            self.error = e
+
+    def alive(self) -> bool:
+        return self.error is None and (self.is_alive() or self.started_ok.is_set())
+
+    def stop(self, timeout: float = 10.0) -> None:
+        if self.demo is None:
+            return
+        t = threading.Thread(target=self.demo.close, name="quokkaform-close", daemon=True)
+        t.start()
+        t.join(timeout)
+        print("Server stopped." if not t.is_alive() else "Server did not stop in time; exiting anyway.")
+
+
+# -------------------------------------------------------------------- main
+
+def parse_args(argv=None):
+    ap = argparse.ArgumentParser(prog="QuokkaForm", description="QuokkaForm desktop window")
+    ap.add_argument("--port", type=int, default=int(os.environ.get("IMG3D_PORT", instance.DEFAULT_PORT)),
+                    help="preferred port (default 7860 or IMG3D_PORT)")
+    ap.add_argument("--debug", action="store_true", help="enable WebView2 developer tools")
+    ap.add_argument("--version", action="version", version=f"{APP_NAME} {VERSION}")
+    return ap.parse_args(argv)
+
+
+def plan_server(host: str, preferred: int, choose=instance.choose_port):
+    """(own_server, port, error_message): what the launcher should do."""
+    kind, port = choose(host, preferred)
+    if kind == "existing":
+        return False, port, None
+    if kind == "new":
+        return True, port, None
+    return False, None, (f"Ports {preferred}-{preferred + instance.PORT_SPAN - 1} are all in use by other "
+                         "programs. Close one of them (or set IMG3D_PORT to a free port) and start QuokkaForm again.")
+
+
+def main(argv=None) -> int:
+    args = parse_args(argv)
+    paths.apply_env()
+    log_path = setup_logging()
+    print(paths.describe())
+    set_app_user_model_id()
+
+    if not acquire_single_instance():
+        print("QuokkaForm is already open; bringing its window to the front.")
+        if focus_existing_window():
+            return 0
+        time.sleep(3)  # it may still be starting up
+        if focus_existing_window():
+            return 0
+        message_box("QuokkaForm is already starting. Wait a moment for its window to appear.", error=False)
+        return 0
+
+    if sys.platform.startswith("win") and not webview2_version():
+        message_box("QuokkaForm needs the Microsoft Edge WebView2 Runtime to show its window, and it is "
+                    "not installed on this PC (Windows 10 and 11 normally include it).\n\n"
+                    "Download the free \"Evergreen Bootstrapper\" from Microsoft:\n"
+                    f"{WEBVIEW2_URL}\n\nInstall it, then start QuokkaForm again. "
+                    "(Running the QuokkaForm installer again also offers to install it.)")
+        return 2
+
+    try:
+        import webview
+    except ImportError:
+        message_box("The desktop window component (pywebview) is missing. Run \"QuokkaForm Setup (repair)\" "
+                    f"from the Start menu.\n\nLog: {log_path}")
+        return 3
+
+    host = os.environ.get("IMG3D_HOST", "127.0.0.1")
+    own_server, port, problem = plan_server(host, args.port)
+    if problem:
+        message_box(problem)
+        return 4
+    url = instance.url_for(host, port)
+    if port != args.port:
+        print(f"Port {args.port} is used by another program; QuokkaForm uses port {port}.")
+    print(("Starting the server at " if own_server else "Opening the QuokkaForm server already running at ") + url)
+
+    webview.settings["ALLOW_DOWNLOADS"] = True                    # Gradio download links -> Save dialog
+    webview.settings["OPEN_EXTERNAL_LINKS_IN_BROWSER"] = False     # never start a browser
+    state = load_window_state()
+    window = webview.create_window(TITLE, html=splash_html(), width=state["width"], height=state["height"],
+                                   min_size=MIN_SIZE, maximized=state["maximized"], resizable=True,
+                                   text_select=True, zoomable=True, background_color="#e9ebee")
+
+    def on_resized(width, height):
+        if not state["maximized"] and width >= MIN_SIZE[0] and height >= MIN_SIZE[1]:
+            state["width"], state["height"] = int(width), int(height)
+
+    def on_maximized():
+        state["maximized"] = True
+
+    def on_restored():
+        state["maximized"] = False
+
+    def on_loaded(window):
+        try:
+            if (window.get_current_url() or "").startswith(url[:-1]):
+                window.run_js(LINK_GUARD_JS)
+        except Exception:  # noqa: BLE001 - cosmetic, never fatal
+            traceback.print_exc()
+
+    window.events.resized += on_resized
+    window.events.maximized += on_maximized
+    window.events.restored += on_restored
+    window.events.loaded += on_loaded
+
+    server = ServerThread(host, port) if own_server else None
+
+    def boot():
+        if server is not None:
+            server.start()
+        ok = instance.wait_until_ready(url, alive=(server.alive if server else (lambda: True)))
+        if ok:
+            print("UI ready:", url)
+            window.load_url(url)
+        else:
+            reason = (f"The server stopped with an error: {server.error!r}" if server is not None and server.error
+                      else "The server did not answer in time.")
+            window.load_html(error_html(reason, log_path))
+
+    try:
+        webview.start(boot, gui="edgechromium", icon=str(ICON), debug=args.debug, private_mode=False,
+                      storage_path=str(paths.webview_dir()))
+    except Exception as e:  # noqa: BLE001
+        traceback.print_exc()
+        message_box(f"The QuokkaForm window could not be opened:\n{e}\n\nLog: {log_path}")
+    finally:
+        save_window_state(state)
+        print("Window closed.")
+        if server is not None:
+            server.stop()
+        sys.stdout.flush()
+        sys.stderr.flush()
+    return 0
+
+
+if __name__ == "__main__":
+    code = main()
+    # Hard exit: no non-daemon thread (queue workers, a running generation)
+    # may keep the process, and with it port 7860, alive after the window closes.
+    os._exit(code)
