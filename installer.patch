+            }
+        } catch {
+            Say ('Prebuilt nvdiffrast download failed: ' + $_.Exception.Message) 'Yellow'
+        }
+    }
+    if (-not $done) {
+        Say 'Building nvdiffrast on this PC (a few minutes) ...'
+        if (Initialize-Toolchain) {
+            $done = ((Invoke-UvInstall @('--no-build-isolation', '--no-deps', '--reinstall', $NvdrSource)) -eq 0) -and (Test-Import 'nvdiffrast.torch')
+        }
+    }
+    if (-not $done) { Fail 'nvdiffrast could not be installed. Install the CUDA 12.4 toolkit and the Visual Studio 2022 C++ Build Tools, then run the setup again.' }
