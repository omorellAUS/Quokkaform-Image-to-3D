@@ -0,0 +1,108 @@
+"""
+Single-instance and port logic for the desktop launcher (no GUI code here).
+
+probe(host, port):
+    "free"        nothing listens on the port
+    "quokkaform"  a QuokkaForm server answers (its Gradio /config title)
+    "other"       something else listens (another app, a different Gradio app)
+
+choose_port(host, preferred): which port to use and whether a QuokkaForm
+server is already there (then the launcher only opens a window to it).
+"""
+
+import json
+import socket
+import time
+import urllib.error
+import urllib.request
+from typing import Callable, Optional, Tuple
+
+APP_TITLE = "QuokkaForm - Images To Mesh"
+DEFAULT_PORT = 7860
+PORT_SPAN = 20  # 7860-7879 are tried before giving up
+
+
+def url_for(host: str, port: int) -> str:
+    # 0.0.0.0 (shared on the network) is reached locally through 127.0.0.1
+    local = "127.0.0.1" if host in ("0.0.0.0", "", "::") else host
+    return f"http://{local}:{port}/"
+
+
+def port_in_use(host: str, port: int, timeout: float = 0.5) -> bool:
+    """True if something accepts TCP connections on host:port."""
+    local = "127.0.0.1" if host in ("0.0.0.0", "", "::") else host
+    try:
+        with socket.create_connection((local, port), timeout=timeout):
+            return True
+    except OSError:
+        return False
+
+
+def can_bind(host: str, port: int) -> bool:
+    """True if this process could listen on host:port right now."""
+    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    try:
+        s.bind((host or "127.0.0.1", port))
+        return True
+    except OSError:
+        return False
+    finally:
+        s.close()
+
+
+def is_quokkaform(host: str, port: int, timeout: float = 2.0) -> bool:
+    """True if the server on host:port is a QuokkaForm Gradio app."""
+    try:
+        with urllib.request.urlopen(url_for(host, port) + "config", timeout=timeout) as r:
+            data = json.loads(r.read(8 * 1024 * 1024).decode("utf-8", "replace"))
+    except (OSError, ValueError, urllib.error.URLError):
+        return False
+    title = data.get("title") if isinstance(data, dict) else None
+    return isinstance(title, str) and title.startswith("QuokkaForm")
+
+
+def probe(host: str, port: int) -> str:
+    if not port_in_use(host, port):
+        return "free" if can_bind(host, port) else "other"
+    return "quokkaform" if is_quokkaform(host, port) else "other"
+
+
+def choose_port(host: str, preferred: int = DEFAULT_PORT, span: int = PORT_SPAN,
+                probe_fn: Callable[[str, int], str] = probe) -> Tuple[str, Optional[int]]:
+    """("existing", port) if QuokkaForm already runs on the preferred port,
+    ("new", port) with the first free port from preferred upwards, or
+    ("none", None) if preferred..preferred+span-1 are all taken.
+
+    Only the preferred port is checked for a running QuokkaForm: another
+    QuokkaForm on a fallback port belongs to a different launch."""
+    for i in range(span):
+        port = preferred + i
+        state = probe_fn(host, port)
+        if state == "quokkaform" and i == 0:
+            return "existing", port
+        if state == "free":
+            return "new", port
+    return "none", None
+
+
+def wait_until_ready(url: str, timeout: float = 900.0, interval: float = 0.5,
+                     alive: Callable[[], bool] = lambda: True,
+                     opener: Callable[[str], bool] = None) -> bool:
+    """Poll ``url`` until it answers HTTP 200; False on timeout or when
+    ``alive()`` turns False (the server thread died)."""
+    def _get(u: str) -> bool:
+        try:
+            with urllib.request.urlopen(u, timeout=2.0) as r:
+                return r.status == 200
+        except (OSError, urllib.error.URLError, ValueError):
+            return False
+
+    opener = opener or _get
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if opener(url):
+            return True
+        if not alive():
+            return False
+        time.sleep(interval)
+    return False
