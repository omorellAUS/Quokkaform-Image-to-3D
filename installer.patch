+"""check_tensor as in kaolin.utils.testing (Apache-2.0), the only kaolin
+function TRELLIS's FlexiCubes uses."""
+
+
+def check_tensor(tensor, shape=None, dtype=None, device=None, throw=True):
+    """True if ``tensor`` has the given shape / dtype / device.
+
+    shape: sequence of ints or None (None = any size in that dimension).
+    device: a device type such as "cuda" or "cpu".
+    throw: raise ValueError on a mismatch instead of returning False.
+    """
+    if shape is not None:
+        if len(shape) != tensor.ndim:
+            if throw:
+                raise ValueError(f"tensor have {tensor.ndim} ndim, should have {len(shape)} dim")
+            return False
+        for i, dim in enumerate(shape):
+            if dim is not None and tensor.shape[i] != dim:
+                if throw:
+                    raise ValueError(f"tensor shape is {tensor.shape}, should be {shape}")
+                return False
+    if dtype is not None and dtype != tensor.dtype:
+        if throw:
+            raise TypeError(f"tensor dtype is {tensor.dtype}, should be {dtype}")
+        return False
+    if device is not None:
+        actual = tensor.device.type if hasattr(tensor.device, "type") else str(tensor.device)
+        wanted = device.type if hasattr(device, "type") else str(device).split(":")[0]
+        if actual != wanted:
+            if throw:
+                raise TypeError(f"tensor device is {tensor.device}, should be {device}")
+            return False
+    return True
