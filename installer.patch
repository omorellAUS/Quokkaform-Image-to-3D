+        $done = ((Invoke-UvInstall @('--no-deps', '--reinstall', $local.FullName)) -eq 0) -and (Test-Import 'diff_gaussian_rasterization')
+    }
+    if (-not $done) {
+        Say 'Building it on this PC (needs the CUDA 12.4 toolkit and VS 2022 C++ Build Tools; 5-15 minutes) ...'
+        if (Initialize-Toolchain) {
+            $done = ((Invoke-UvInstall @('--no-build-isolation', '--no-deps', '--reinstall', $DgrSource)) -eq 0) -and (Test-Import 'diff_gaussian_rasterization')
+        }
+    }
+    if (-not $done) {
+        Warn ('diff-gaussian-rasterization is not installed: QuokkaForm works, but only with Texture bake "None" ' +
+              'and without the 360 video. Install the build tools named above and run "QuokkaForm Setup (repair)".')
+    }
+}
+
+# --------------------------------------------------------------- 7. verify
+Step 'Checking the installation'
+Push-Location $AppDir
+$verifyCode = Invoke-Tool $VenvPy @($Verify, '--app-dir', $AppDir)
+Pop-Location
+if ($verifyCode -eq 1) { Fail 'Some required components do not work (see above).' }
+$stamp = '{"version": "' + $Version + '", "date": "' + (Get-Date -Format 's') + '"}'
+[System.IO.File]::WriteAllText($Marker, $stamp)
+
+# ------------------------------------------------------------- 8. WebView2
+$wv2 = '{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}'
+$wv2Keys = @("HKLM:\SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\$wv2",
