diff --git a/app/backend/paths.py b/app/backend/paths.py
new file mode 100644
index 0000000..559f19a
--- /dev/null
+++ b/app/backend/paths.py
@@ -0,0 +1,143 @@
+"""
+Where QuokkaForm keeps its files, independent of the folder it runs from.
+
+Install folder (read-only for the app): the folder that contains ``app/``,
+e.g. %LOCALAPPDATA%\\Programs\\QuokkaForm or the dev checkout.
+
+Per-user data (Windows):
+    %LOCALAPPDATA%\\QuokkaForm\\models     model downloads (HF / torch hub / rembg)
+    %LOCALAPPDATA%\\QuokkaForm\\runtime    Python 3.10 + venv made by the setup
+    %LOCALAPPDATA%\\QuokkaForm\\logs       desktop window and setup logs
+    %LOCALAPPDATA%\\QuokkaForm\\webview    WebView2 profile of the desktop window
+    %APPDATA%\\QuokkaForm\\settings.json   remembered settings (settings_store)
+    Documents\\QuokkaForm\\outputs          every run (history)
+
+Models: ``apply_env()`` points HF_HOME / HF_HUB_CACHE, TORCH_HOME and
+U2NET_HOME at the models folder, BUT if the old default caches
+(~/.cache/huggingface/hub, ~/.cache/torch, ~/.u2net) already hold more of
+QuokkaForm's models than the new folder, that cache keeps being used, so
+nothing is downloaded twice (about 4.3 GB). Variables the user already set
+are never changed. It runs on Windows only (Linux / Docker keep the usual
+defaults) unless IMG3D_DATA_DIR is set.
+
+This module must stay import-light (no torch / gradio / huggingface_hub):
+it runs before those read their cache variables.
+"""
+
+import os
+import sys
+from pathlib import Path
+from typing import Dict, Iterable, Mapping, MutableMapping, Optional
+
+APP_DIR_NAME = "QuokkaForm"
+
+# Files / folders that show a cache already holds one of our models.
+HF_MARKERS = ("models--microsoft--TRELLIS-image-large", "models--facebook--sam2.1-hiera-small")
+TORCH_MARKERS = ("hub/checkpoints/dinov2_vitl14_reg4_pretrain.pth", "hub/facebookresearch_dinov2_main/hubconf.py")
+U2NET_MARKERS = ("birefnet-general-lite.onnx", "birefnet-general.onnx", "u2net.onnx", "isnet-general-use.onnx")
+HF_VARS = ("HF_HOME", "HF_HUB_CACHE", "HUGGINGFACE_HUB_CACHE")
+
+
+def app_root() -> Path:
+    """The folder that contains ``app/`` (install folder or dev checkout)."""
+    return Path(__file__).resolve().parent.parent.parent
+
+
+def _env(env: Optional[Mapping[str, str]]) -> Mapping[str, str]:
+    return os.environ if env is None else env
+
+
+def _is_windows(platform: Optional[str]) -> bool:
+    return (platform or sys.platform).startswith("win")
+
+
+def _home(env: Mapping[str, str]) -> Path:
+    for key in ("USERPROFILE", "HOME"):
+        if env.get(key):
+            return Path(env[key])
+    return Path.home()
+
+
+def data_dir(env: Optional[Mapping[str, str]] = None, platform: Optional[str] = None) -> Path:
+    """Per-user data folder (models, runtime, logs, webview profile)."""
+    env = _env(env)
+    if env.get("IMG3D_DATA_DIR"):
+        return Path(env["IMG3D_DATA_DIR"])
+    if _is_windows(platform) and env.get("LOCALAPPDATA"):
+        return Path(env["LOCALAPPDATA"]) / APP_DIR_NAME
+    base = Path(env["XDG_DATA_HOME"]) if env.get("XDG_DATA_HOME") else _home(env) / ".local" / "share"
+    return base / "quokkaform"
+
+
+def models_dir(env=None, platform=None) -> Path:
+    return data_dir(env, platform) / "models"
+
+
+def logs_dir(env=None, platform=None) -> Path:
+    return data_dir(env, platform) / "logs"
+
+
+def runtime_dir(env=None, platform=None) -> Path:
+    return data_dir(env, platform) / "runtime"
+
+
+def webview_dir(env=None, platform=None) -> Path:
+    return data_dir(env, platform) / "webview"
+
+
+def legacy_caches(env: Optional[Mapping[str, str]] = None) -> Dict[str, Path]:
+    """The default cache folders used before (and by other tools)."""
+    env = _env(env)
+    home = _home(env)
+    cache = Path(env["XDG_CACHE_HOME"]) if env.get("XDG_CACHE_HOME") else home / ".cache"
+    u2_base = Path(env["XDG_DATA_HOME"]) if env.get("XDG_DATA_HOME") else home
+    return {"hf_hub": cache / "huggingface" / "hub", "torch": cache / "torch", "u2net": u2_base / ".u2net"}
+
+
+def count_markers(folder: Path, markers: Iterable[str]) -> int:
+    """How many of ``markers`` (relative paths) exist under ``folder``."""
+    return sum(1 for m in markers if (folder / m).exists())
+
+
+def _pick(new: Path, legacy: Path, markers) -> Path:
+    """The legacy cache if it holds more of our models than the new folder."""
+    return legacy if count_markers(legacy, markers) > count_markers(new, markers) else new
+
+
+def model_env(env: Optional[Mapping[str, str]] = None, platform: Optional[str] = None) -> Dict[str, str]:
+    """Cache variables to set (only ones the user has not set already)."""
+    env = _env(env)
+    if not (_is_windows(platform) or env.get("IMG3D_DATA_DIR")):
+        return {}
+    models = models_dir(env, platform)
+    legacy = legacy_caches(env)
+    out: Dict[str, str] = {}
+    if not any(env.get(v) for v in HF_VARS):
+        hf_home = models / "huggingface"
+        out["HF_HOME"] = str(hf_home)
+        hub = _pick(hf_home / "hub", legacy["hf_hub"], HF_MARKERS)
+        if hub != hf_home / "hub":
+            out["HF_HUB_CACHE"] = str(hub)
+    if not env.get("TORCH_HOME"):
+        out["TORCH_HOME"] = str(_pick(models / "torch", legacy["torch"], TORCH_MARKERS))
+    if not env.get("U2NET_HOME"):
+        out["U2NET_HOME"] = str(_pick(models / "u2net", legacy["u2net"], U2NET_MARKERS))
+    return out
+
+
+def apply_env(env: Optional[MutableMapping[str, str]] = None, platform: Optional[str] = None) -> Dict[str, str]:
+    """Set the model cache variables in ``env`` (default os.environ); returns what was set."""
+    target = os.environ if env is None else env
+    values = model_env(target, platform)
+    target.update(values)
+    return values
+
+
+def describe(env: Optional[Mapping[str, str]] = None) -> str:
+    """One line per location, for the log / setup output."""
+    env = _env(env)
+    rows = [("Install folder", app_root()), ("Data folder", data_dir(env))]
+    for key in ("HF_HOME", "HF_HUB_CACHE", "TORCH_HOME", "U2NET_HOME"):
+        if env.get(key):
+            rows.append((key, env[key]))
+    return "\n".join(f"{k}: {v}" for k, v in rows)
