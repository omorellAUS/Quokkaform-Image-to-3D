@@ -0,0 +1,111 @@
+"""Consistency of the installer files (they cannot run on Linux, so check
+what can be checked: versions, names shared with app/desktop.py, pins,
+ASCII-only PowerShell, CRLF batch files) and build the portable folder."""
+import re
+import subprocess
+import sys
+import zipfile
+from pathlib import Path
+
+import pytest
+
+from app import desktop
+from app.version import PUBLISHER, VERSION
+
+ROOT = Path(__file__).resolve().parent.parent
+INST = ROOT / "installer"
+ISS = (INST / "QuokkaForm.iss").read_text(encoding="utf-8")
+SETUP_PS1 = (INST / "setup_runtime.ps1").read_text(encoding="utf-8")
+
+
+def test_iss_matches_app():
+    assert f'#define AppVersion "{VERSION}"' in ISS
+    assert f'#define AppPublisher "{PUBLISHER}"' in ISS
+    assert f"AppMutex={desktop.MUTEX_NAME}" in ISS
+    assert f'#define AppUserModelID "{desktop.APP_USER_MODEL_ID}"' in ISS
+    assert "PrivilegesRequired=lowest" in ISS
+    assert "DefaultDirName={autopf}\\{#AppName}" in ISS        # = %LOCALAPPDATA%\Programs\QuokkaForm
+    assert "LicenseFile={#SourceDir}\\LICENSE_AND_NOTICES.txt" in ISS
+    assert "app\\assets\\quokkaform.ico" in ISS
+    assert "Flags: unchecked" in ISS                            # desktop icon optional
+    assert "QuokkaForm Setup (repair)" in ISS
+
+
+def test_iss_shortcut_uses_pythonw_and_desktop_py():
+    assert r'#define PythonW "{localappdata}\QuokkaForm\runtime\venv\Scripts\pythonw.exe"' in ISS
+    assert ISS.count('Parameters: """{app}\\app\\desktop.py"""') == 3   # Start menu, desktop, post-install
+
+
+def test_mutex_name_shared_with_setup_script():
+    assert f"TryOpenExisting('{desktop.MUTEX_NAME}'" in SETUP_PS1
+
+
+def test_powershell_and_iss_are_ascii():
+    for p in list(INST.glob("*.ps1")) + [INST / "QuokkaForm.iss"]:
+        bad = [i for i, ch in enumerate(p.read_text(encoding="utf-8")) if ord(ch) > 127]
+        assert not bad, f"non-ASCII character in {p.name} (Windows PowerShell 5.1 reads ANSI)"
+
+
+def test_cmd_files_crlf():
+    for name in ("QuokkaForm.cmd", "QuokkaForm Setup.cmd", "start.bat"):
+        data = (ROOT / name).read_bytes()
+        assert b"\r\n" in data and data.count(b"\n") == data.count(b"\r\n"), name
+
+
+def test_pins_agree():
+    req = (ROOT / "requirements.txt").read_text()
+    mip = re.search(r"mip-splatting\.git@([0-9a-f]{40})", req).group(1)
+    assert mip in SETUP_PS1 and mip in (INST / "build_wheels.ps1").read_text()
+    nvdr = re.search(r"nvdiffrast/archive/([0-9a-f]{40})", SETUP_PS1).group(1)
+    assert nvdr in (INST / "build_wheels.ps1").read_text()
+    assert "nvdiffrast.git@v0.4.0" in req and "diffoctreerast" not in req.replace("# diffoctreerast", "")
+    assert re.search(r"\$NvdrWheelSha\s*=\s*'[0-9a-f]{64}'", SETUP_PS1)
+
+
+def test_lock_covers_the_input_file():
+    names = []
+    for line in (INST / "requirements-win.in").read_text().splitlines():
+        line = line.split("#")[0].strip()
+        if line and not line.startswith("-"):
+            names.append(re.split(r"[=@ <>]", line)[0].lower().replace("_", "-"))
+    lock = (INST / "requirements-lock-win.txt").read_text().lower().replace("_", "-")
+    for n in names:
+        assert re.search(rf"^{re.escape(n)}(==| @ )", lock, re.M), n
+    for absent in ("kaolin", "diffoctreerast", "warp-lang", "usd-core", "gradio-litmodel3d"):
+        assert not re.search(rf"^{absent}==", lock, re.M), absent
+
+
+def _have(path):
+    return Path(path).exists()
+
+
+CACHE = ROOT / "dist" / "cache"
+
+
+@pytest.mark.skipif(not _have("/workspace/TRELLIS/trellis") or not list(CACHE.glob("uv-*.zip")),
+                    reason="needs a TRELLIS checkout and a cached uv zip (run build_zip.py once)")
+def test_build_zip_portable_folder(tmp_path):
+    pytest.importorskip("torch")
+    out = tmp_path / "dist"
+    (out / "cache").mkdir(parents=True)
+    for whl in CACHE.glob("sam2-*.whl"):          # reuse the built sam2 wheel when there is one
+        (out / "cache" / whl.name).write_bytes(whl.read_bytes())
+    uvzip = next(CACHE.glob("uv-*.zip"))
+    r = subprocess.run([sys.executable, str(INST / "build_zip.py"), "--out", str(out), "--trellis-src",
+                        "/workspace/TRELLIS", "--uv-zip", str(uvzip), "--python", sys.executable],
+                       capture_output=True, text=True, timeout=600)
+    assert r.returncode == 0, r.stdout[-2000:] + r.stderr[-2000:]
+    z = out / f"QuokkaForm-{VERSION}-portable.zip"
+    names = set(zipfile.ZipFile(z).namelist())
+    for must in ("QuokkaForm/app/desktop.py", "QuokkaForm/app/stubs/kaolin/utils/testing.py",
+                 "QuokkaForm/TRELLIS/trellis/pipelines/__init__.py",
+                 "QuokkaForm/TRELLIS/trellis/representations/mesh/flexicubes/flexicubes.py",
+                 "QuokkaForm/TRELLIS/LICENSE", "QuokkaForm/tools/uv.exe", "QuokkaForm/installer/setup_runtime.ps1",
+                 "QuokkaForm/installer/requirements-lock-win.txt", "QuokkaForm/QuokkaForm.cmd",
+                 "QuokkaForm/LICENSE_AND_NOTICES.txt", "QuokkaForm/VERSION.txt"):
+        assert must in names, must
+    assert any(n.startswith("QuokkaForm/wheels/sam2-1.1.0-py3-none-any.whl") for n in names)
+    assert not any("__pycache__" in n or n.endswith(".pyc") for n in names)
+    assert not any("/tests/" in n or n.endswith("start.bat") for n in names)
+    notices = (out / "QuokkaForm" / "LICENSE_AND_NOTICES.txt").read_text(encoding="utf-8-sig")
+    assert "NON-COMMERCIAL" in notices and "nvdiffrast" in notices and "MIT" in notices
