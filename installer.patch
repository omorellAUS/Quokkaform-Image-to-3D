+              'Use Texture bake "Fast" and keep the 360 video short if you run out of memory.')
+    }
+}
+
+# ------------------------------------------------------------------- 2. uv
+Step 'Preparing uv (Python package manager)'
+$Uv = Join-Path $AppDir 'tools\uv.exe'
+if (-not (Test-Path $Uv)) {
+    $cmd = Get-Command 'uv.exe' -ErrorAction SilentlyContinue
