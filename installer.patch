+    assert paths.models_dir(env, "win32") == base / "models"
+    assert paths.logs_dir(env, "win32") == base / "logs"
+    assert paths.runtime_dir(env, "win32") == base / "runtime"
+    assert paths.webview_dir(env, "win32") == base / "webview"
