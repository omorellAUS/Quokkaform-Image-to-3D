+"""Port / single-instance logic (app/backend/instance.py) with real sockets."""
+import http.server
+import json
+import socket
+import threading
+
+import pytest
+
+from app.backend import instance
+
+
+def _free_port():
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+class _Server:
+    """A tiny HTTP server answering /config with the given title."""
+
+    def __init__(self, title):
+        title_json = json.dumps({"title": title, "version": "4.44.1"}).encode()
+
+        class H(http.server.BaseHTTPRequestHandler):
+            def do_GET(self):
+                body = title_json if self.path == "/config" else b"<html></html>"
+                self.send_response(200)
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, *a):
+                pass
+
+        self.httpd = http.server.HTTPServer(("127.0.0.1", 0), H)
+        self.port = self.httpd.server_address[1]
+        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
+
+    def close(self):
+        self.httpd.shutdown()
+        self.httpd.server_close()
+
+
+@pytest.fixture
+def quokka():
+    s = _Server(instance.APP_TITLE)
+    yield s
+    s.close()
+
+
+@pytest.fixture
+def other():
+    s = _Server("Some other Gradio app")
+    yield s
+    s.close()
+
+
+def test_probe_free_quokkaform_other(quokka, other):
+    assert instance.probe("127.0.0.1", _free_port()) == "free"
+    assert instance.probe("127.0.0.1", quokka.port) == "quokkaform"
+    assert instance.probe("127.0.0.1", other.port) == "other"
+
+
+def test_probe_plain_tcp_listener_is_other():
+    s = socket.socket()
+    s.bind(("127.0.0.1", 0))
+    s.listen(1)
+    try:
+        assert instance.probe("127.0.0.1", s.getsockname()[1]) == "other"
+    finally:
+        s.close()
+
+
+def test_choose_port_logic_with_fake_probe():
+    def probe_fn(states):
+        return lambda host, port: states.get(port, "free")
+
+    assert instance.choose_port("h", 7860, probe_fn=probe_fn({})) == ("new", 7860)
+    assert instance.choose_port("h", 7860, probe_fn=probe_fn({7860: "quokkaform"})) == ("existing", 7860)
+    assert instance.choose_port("h", 7860, probe_fn=probe_fn({7860: "other", 7861: "other"})) == ("new", 7862)
+    # a QuokkaForm on a fallback port is somebody else's: skip it
+    assert instance.choose_port("h", 7860, probe_fn=probe_fn({7860: "other", 7861: "quokkaform"})) == ("new", 7862)
+    busy = {p: "other" for p in range(7860, 7860 + instance.PORT_SPAN)}
+    assert instance.choose_port("h", 7860, probe_fn=probe_fn(busy)) == ("none", None)
+
+
+def test_choose_port_real(quokka, other):
+    assert instance.choose_port("127.0.0.1", quokka.port) == ("existing", quokka.port)
+    kind, port = instance.choose_port("127.0.0.1", other.port)
+    assert kind == "new" and port > other.port
+
+
+def test_url_for():
+    assert instance.url_for("127.0.0.1", 7860) == "http://127.0.0.1:7860/"
+    assert instance.url_for("0.0.0.0", 7861) == "http://127.0.0.1:7861/"
+
+
+def test_wait_until_ready(quokka):
+    assert instance.wait_until_ready(instance.url_for("127.0.0.1", quokka.port), timeout=5)
+    assert not instance.wait_until_ready(instance.url_for("127.0.0.1", _free_port()), timeout=1, interval=0.1)
+    calls = []
+    assert not instance.wait_until_ready("http://x/", timeout=30, interval=0.01,
+                                         alive=lambda: len(calls) < 3, opener=lambda u: calls.append(u) or False)
+    assert len(calls) == 3
