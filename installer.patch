+} else {
+    $done = $false
+    $local = Get-ChildItem $Wheels -Filter 'nvdiffrast-*.whl' -ErrorAction SilentlyContinue | Select-Object -First 1
+    if ($local) {
+        Say ('Installing the bundled wheel ' + $local.Name)
+        $done = ((Invoke-UvInstall @('--no-deps', '--reinstall', $local.FullName)) -eq 0) -and (Test-Import 'nvdiffrast.torch')
+    }
+    if (-not $done) {
