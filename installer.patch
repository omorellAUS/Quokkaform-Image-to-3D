+"""app/desktop.py: window state, logs, WebView2 detection, server plan, and an
+end-to-end run with a fake pywebview (real Gradio server, mock TRELLIS)."""
+import json
+import os
+import socket
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+from app import desktop
+from app.backend import instance
+
+ROOT = Path(__file__).resolve().parent.parent
+FAKES = Path(__file__).resolve().parent / "fakes"
+MOCK_TRELLIS = Path(os.environ.get("MOCK_TRELLIS", "/workspace/mock_trellis"))
+
+
+def test_window_state_roundtrip_and_defaults(tmp_path):
+    p = tmp_path / "w" / "window.json"
+    assert desktop.load_window_state(p) == {"width": 1400, "height": 900, "maximized": False}
+    desktop.save_window_state({"width": 1600, "height": 1000, "maximized": True}, p)
+    assert desktop.load_window_state(p) == {"width": 1600, "height": 1000, "maximized": True}
+    p.write_text("{broken")
+    assert desktop.load_window_state(p)["width"] == 1400
+    p.write_text(json.dumps({"width": 50, "height": 50}))   # too small: defaults
+    assert desktop.load_window_state(p)["height"] == 900
+
+
+def test_window_state_lives_with_settings(monkeypatch, tmp_path):
+    monkeypatch.setenv("IMG3D_CONFIG_DIR", str(tmp_path))
+    assert desktop.window_state_path() == tmp_path / "window.json"
+
+
+def test_prune_logs_keeps_newest(tmp_path):
+    for i in range(14):
+        p = tmp_path / f"quokkaform-2026010{i:02d}.log"
+        p.write_text("x")
+        os.utime(p, (1000 + i, 1000 + i))
+    (tmp_path / "setup-1.log").write_text("x")
+    desktop.prune_logs(tmp_path, keep=5)
+    left = sorted(p.name for p in tmp_path.glob("quokkaform-*.log"))
+    assert len(left) == 5 and left[-1].endswith("13.log")
+    assert (tmp_path / "setup-1.log").exists()
+
+
+def test_setup_logging_writes_file(tmp_path, monkeypatch):
+    monkeypatch.setattr(sys, "stdout", sys.stdout)
+    monkeypatch.setattr(sys, "stderr", sys.stderr)
+    log = desktop.setup_logging(tmp_path)
+    print("hello log")
+    sys.stdout.flush()
+    assert "hello log" in log.read_text(encoding="utf-8")
+
+
+def test_webview2_detection():
+    key = rf"SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{desktop.WEBVIEW2_CLIENT}"
+    assert desktop.webview2_version(lambda root, k: "130.0.1" if (root, k) == ("HKLM", key) else None) == "130.0.1"
+    hkcu = rf"SOFTWARE\Microsoft\EdgeUpdate\Clients\{desktop.WEBVIEW2_CLIENT}"
+    assert desktop.webview2_version(lambda root, k: "129.0" if (root, k) == ("HKCU", hkcu) else None) == "129.0"
+    assert desktop.webview2_version(lambda root, k: "0.0.0.0") is None   # uninstalled leftover
+    assert desktop.webview2_version(lambda root, k: None) is None
+
+
+def test_plan_server():
+    assert desktop.plan_server("h", 7860, lambda h, p: ("new", 7860)) == (True, 7860, None)
+    assert desktop.plan_server("h", 7860, lambda h, p: ("new", 7862)) == (True, 7862, None)
+    assert desktop.plan_server("h", 7860, lambda h, p: ("existing", 7860)) == (False, 7860, None)
+    own, port, msg = desktop.plan_server("h", 7860, lambda h, p: ("none", None))
+    assert not own and port is None and "7860-7879" in msg
+
+
+def test_pages_escape_and_brand():
+    assert "Starting QuokkaForm" in desktop.splash_html()
+    page = desktop.error_html("<boom>", r"C:\logs\q.log")
+    assert "&lt;boom&gt;" in page and r"C:\logs\q.log" in page
+
+
+def test_no_browser_is_ever_opened():
+    src = (ROOT / "app" / "desktop.py").read_text(encoding="utf-8")
+    for bad in ("webbrowser", "startfile", "msedge", "inbrowser=True"):
+        assert bad not in src
+    assert 'settings["OPEN_EXTERNAL_LINKS_IN_BROWSER"] = False' in src
+
+
+def _free_port():
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+def _run_desktop(tmp_path, port, extra_env=None, timeout=240):
+    report = tmp_path / "report.json"
+    env = dict(os.environ, PYTHONPATH=os.pathsep.join([str(FAKES), str(MOCK_TRELLIS)]),
+               FAKE_WEBVIEW_REPORT=str(report), IMG3D_DATA_DIR=str(tmp_path / "data"),
+               IMG3D_CONFIG_DIR=str(tmp_path / "cfg"), IMG3D_OUTPUT_DIR=str(tmp_path / "out"),
+               IMG3D_SAM_DEVICE="cpu", PYTHONUNBUFFERED="1")
+    env.pop("IMG3D_PORT", None)
+    env.update(extra_env or {})
+    r = subprocess.run([sys.executable, str(ROOT / "app" / "desktop.py"), "--port", str(port)],
+                       env=env, capture_output=True, text=True, timeout=timeout)
+    return r, json.loads(report.read_text()) if report.exists() else None
+
+
+needs_mock = pytest.mark.skipif(not (MOCK_TRELLIS / "trellis").is_dir(), reason="mock TRELLIS not available")
+
+
+@needs_mock
+def test_end_to_end_starts_serves_and_stops(tmp_path):
+    pytest.importorskip("gradio")
+    port = _free_port()
+    t0 = time.time()
+    r, rep = _run_desktop(tmp_path, port)
+    assert r.returncode == 0, r.stdout[-3000:] + r.stderr[-3000:]
+    assert rep and rep["ok"] and rep["url"] == f"http://127.0.0.1:{port}/", rep
+    assert rep["title"] == "QuokkaForm - Images To Mesh"
+    assert rep["settings"]["ALLOW_DOWNLOADS"] is True
+    assert rep["settings"]["OPEN_EXTERNAL_LINKS_IN_BROWSER"] is False
+    assert rep["start_kw"]["gui"] == "edgechromium" and rep["start_kw"]["icon"].endswith("quokkaform.ico")
+    assert rep["js"] == 1                                   # link guard injected
+    # the server is gone with the process: nothing listens on the port
+    assert not instance.port_in_use("127.0.0.1", port)
+    # log file and window size were written
+    logs = list((tmp_path / "data" / "logs").glob("quokkaform-*.log"))
+    assert logs and "UI ready" in logs[0].read_text(encoding="utf-8")
+    assert json.loads((tmp_path / "cfg" / "window.json").read_text())["width"] == 1500
+    assert time.time() - t0 < 240
+
+
+@needs_mock
+def test_end_to_end_reuses_running_quokkaform(tmp_path):
+    """A QuokkaForm server already on the port: only a window is opened, and
+    closing it leaves that server running."""
+    import http.server
+    import threading
+
+    class H(http.server.BaseHTTPRequestHandler):
+        def do_GET(self):
+            self.send_response(200)
+            self.end_headers()
+            self.wfile.write(json.dumps({"title": instance.APP_TITLE}).encode())
+
+        def log_message(self, *a):
+            pass
+
+    httpd = http.server.HTTPServer(("127.0.0.1", 0), H)
+    threading.Thread(target=httpd.serve_forever, daemon=True).start()
+    port = httpd.server_address[1]
+    try:
+        r, rep = _run_desktop(tmp_path, port, timeout=60)
+        assert r.returncode == 0, r.stderr[-3000:]
+        assert rep["url"] == f"http://127.0.0.1:{port}/"
+        assert instance.port_in_use("127.0.0.1", port)
+        log = next((tmp_path / "data" / "logs").glob("quokkaform-*.log")).read_text(encoding="utf-8")
+        assert "already running" in log
+    finally:
+        httpd.shutdown()
+        httpd.server_close()
+
+
+@needs_mock
+def test_end_to_end_port_taken_by_other_program(tmp_path):
+    s = socket.socket()
+    s.bind(("127.0.0.1", 0))
+    s.listen(5)
+    busy = s.getsockname()[1]
+    try:
+        r, rep = _run_desktop(tmp_path, busy)
+        assert r.returncode == 0, r.stderr[-3000:]
+        used = int(rep["url"].rsplit(":", 1)[1].strip("/"))
+        assert used != busy and busy < used < busy + instance.PORT_SPAN
+        assert not instance.port_in_use("127.0.0.1", used)
+    finally:
+        s.close()
