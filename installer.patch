+++ b/installer/verify_runtime.py
@@ -0,0 +1,110 @@
+"""
+Check the installed QuokkaForm runtime (run by setup_runtime.ps1 with the
+runtime's python.exe; also handy by hand):
+
+    python installer/verify_runtime.py [--app-dir <install folder>]
+
+Prints one line per component. Exit code 0 = all fine, 1 = something
+required is missing (QuokkaForm cannot make models), 2 = only optional parts
+are missing (e.g. the Gaussian rasteriser: no textures / 360 video).
+"""
+
+import argparse
+import importlib
+import os
+import sys
+from pathlib import Path
+
+# (module, label, required, hint)
+CHECKS = [
+    ("torch", "PyTorch", True, "reinstall with QuokkaForm Setup (repair) -Reinstall"),
+    ("torchvision", "torchvision", True, ""),
+    ("flash_attn", "flash-attn", True, ""),
+    ("spconv.pytorch", "spconv", True, ""),
+    ("nvdiffrast.torch", "nvdiffrast", True, "needed for every model"),
+    ("diff_gaussian_rasterization", "diff-gaussian-rasterization", False,
+     "needed for textures and the 360 video; install the CUDA 12.4 toolkit and the Visual Studio 2022 "
+     "C++ Build Tools, then run QuokkaForm Setup (repair)"),
+    ("plyfile", "plyfile", True, ""),
+    ("utils3d", "utils3d", True, ""),
+    ("rembg", "rembg", True, ""),
+    ("onnxruntime", "onnxruntime", True, ""),
+    ("sam2", "SAM 2", False, "Select object will not work"),
+    ("open3d", "Open3D", True, ""),
+    ("pymeshfix", "pymeshfix", True, ""),
+    ("igraph", "igraph", True, ""),
+    ("xatlas", "xatlas", True, ""),
+    ("gradio", "Gradio", True, ""),
+    ("webview", "pywebview", True, "the QuokkaForm window"),
+]
+
+
+def check_imports(checks=CHECKS, importer=importlib.import_module):
+    """[(label, ok, required, detail)]"""
+    rows = []
+    for module, label, required, hint in checks:
+        try:
+            m = importer(module)
+            detail = getattr(m, "__version__", "") or "ok"
+            rows.append((label, True, required, str(detail)))
+        except Exception as e:  # noqa: BLE001 - report every kind of failure
+            msg = f"{type(e).__name__}: {e}".splitlines()[0][:200]
+            rows.append((label, False, required, msg + (f" ({hint})" if hint else "")))
+    return rows
+
+
+def check_cuda():
+    try:
+        import torch
+    except Exception as e:  # noqa: BLE001
+        return False, f"torch import failed: {e}"
+    if not torch.version.cuda:
+        return False, f"PyTorch {torch.__version__} is a CPU-only build"
+    if not torch.cuda.is_available():
+        return False, f"PyTorch {torch.__version__} cannot use the GPU (driver too old or no NVIDIA GPU)"
+    p = torch.cuda.get_device_properties(0)
+    return True, f"{p.name}, {p.total_memory / 1024 ** 3:.1f} GB, CUDA {torch.version.cuda}, torch {torch.__version__}"
+
+
+def check_trellis(app_dir: Path):
+    """Import the TRELLIS pipeline as the app does (bundled TRELLIS + stubs)."""
+    sys.path.insert(0, str(app_dir / "TRELLIS"))
+    sys.path.append(str(app_dir / "app" / "stubs"))
+    os.environ.setdefault("SPCONV_ALGO", "native")
+    try:
+        from trellis.pipelines import TrellisImageTo3DPipeline  # noqa: F401
+        return True, "ok"
+    except Exception as e:  # noqa: BLE001
+        return False, f"{type(e).__name__}: {e}".splitlines()[0][:300]
+
+
+def summarise(rows):
+    """Exit code: 1 if a required row failed, 2 if only optional ones, else 0."""
+    if any(not ok and req for _, ok, req, _ in rows):
+        return 1
+    if any(not ok for _, ok, _, _ in rows):
+        return 2
+    return 0
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--app-dir", default=str(Path(__file__).resolve().parent.parent))
+    a = ap.parse_args(argv)
+    rows = check_imports()
+    ok, detail = check_cuda()
+    rows.append(("CUDA GPU", ok, True, detail))
+    ok, detail = check_trellis(Path(a.app_dir))
+    rows.append(("TRELLIS pipeline", ok, True, detail))
+    for label, ok, req, detail in rows:
+        status = "OK     " if ok else ("MISSING" if req else "OPTIONAL MISSING")
+        print(f"  {status}  {label}: {detail}")
+    code = summarise(rows)
+    print({0: "All components are working.",
+           1: "Some required components are missing (see above).",
+           2: "Everything required works; some optional parts are missing (see above)."}[code])
+    return code
+
+
+if __name__ == "__main__":
+    sys.exit(main())
