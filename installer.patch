+    }
+    if ($gpu.VramMB -gt 0 -and $gpu.VramMB -lt $MinVramMB) {
+        Warn ('This GPU has only ' + [math]::Round($gpu.VramMB / 1024, 1) + ' GB of VRAM. TRELLIS needs about 8 GB at ' +
