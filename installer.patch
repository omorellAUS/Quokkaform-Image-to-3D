+++ b/tests/test_verify_runtime.py
@@ -0,0 +1,34 @@
+"""installer/verify_runtime.py: import checks and the exit code rules."""
+import importlib.util
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+spec = importlib.util.spec_from_file_location("verify_runtime", ROOT / "installer" / "verify_runtime.py")
+vr = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(vr)
+
+
+def test_check_imports_reports_failures():
+    def importer(name):
+        if name == "bad":
+            raise OSError("DLL load failed while importing _C")
+        return type("M", (), {"__version__": "1.2"})
+
+    rows = vr.check_imports([("good", "Good", True, ""), ("bad", "Bad", False, "optional hint")], importer)
+    assert rows[0] == ("Good", True, True, "1.2")
+    assert rows[1][1] is False and "DLL load failed" in rows[1][3] and "optional hint" in rows[1][3]
+
+
+def test_summarise():
+    assert vr.summarise([("a", True, True, "")]) == 0
+    assert vr.summarise([("a", True, True, ""), ("b", False, False, "")]) == 2
+    assert vr.summarise([("a", False, True, ""), ("b", False, False, "")]) == 1
+
+
+def test_every_required_runtime_package_is_checked():
+    lock = (ROOT / "installer" / "requirements-lock-win.txt").read_text()
+    for pkg in ("plyfile", "pywebview", "flash-attn", "spconv-cu124", "sam2", "torch=="):
+        assert pkg in lock
+    modules = [c[0] for c in vr.CHECKS]
+    for mod in ("plyfile", "webview", "nvdiffrast.torch", "diff_gaussian_rasterization", "flash_attn"):
+        assert mod in modules
