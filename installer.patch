diff --git a/installer/setup_runtime.ps1 b/installer/setup_runtime.ps1
new file mode 100644
index 0000000..10d8cfd
--- /dev/null
+++ b/installer/setup_runtime.ps1
@@ -0,0 +1,444 @@
+<#
+.SYNOPSIS
+    QuokkaForm first-run setup / repair (Windows 10/11 x64).
+
+.DESCRIPTION
+    Installs everything QuokkaForm needs for the current user, without admin
+    rights and without a system Python:
+      1. checks the NVIDIA GPU, driver and VRAM (friendly messages)
+      2. Python 3.10 managed by uv     -> %LOCALAPPDATA%\QuokkaForm\runtime\python
+      3. a virtual environment         -> %LOCALAPPDATA%\QuokkaForm\runtime\venv
+      4. the pinned packages (installer\requirements-lock-win.txt, torch 2.5.1 + CUDA 12.4)
+      5. nvdiffrast: bundled wheel, else the pinned prebuilt wheel (SHA-256
+         checked), else built on this PC (needs CUDA toolkit + VS Build Tools)
+      6. diff-gaussian-rasterization: bundled wheel, else built on this PC;
+         if that is not possible QuokkaForm still works without textures/video
+      7. verifies the installation, offers the model download (about 4.3 GB)
+    Safe to run again: finished parts are skipped. Log files go to
+    %LOCALAPPDATA%\QuokkaForm\logs\setup-<date>.log.
+
+.PARAMETER Reinstall
+    Delete the virtual environment and install everything again.
+.PARAMETER Models
+    ask (default), yes or no: download the AI models at the end.
+.PARAMETER Unattended
+    Never ask (use the defaults) and never wait for Enter.
+.PARAMETER FromInstaller
+    Started by setup.exe: wait for Enter at the end if something needs reading.
+
+.NOTES
+    Keep this file ASCII only: Windows PowerShell 5.1 reads scripts without a
+    BOM in the ANSI code page.
+#>
+[CmdletBinding()]
+param(
+    [switch]$Reinstall,
+    [ValidateSet('ask', 'yes', 'no')][string]$Models = 'ask',
+    [switch]$Unattended,
+    [switch]$FromInstaller
+)
+
+$ErrorActionPreference = 'Continue'   # native tools report through exit codes
+$ProgressPreference = 'SilentlyContinue'  # Invoke-WebRequest is very slow with the progress bar
+# GitHub needs TLS 1.2; Windows PowerShell 5.1 may default to older protocols.
+[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
+
+# ----------------------------------------------------------------- settings
+$AppDir    = Split-Path -Parent $PSScriptRoot           # the install folder
+$DataDir   = Join-Path $env:LOCALAPPDATA 'QuokkaForm'
+$Runtime   = Join-Path $DataDir 'runtime'
+$Venv      = Join-Path $Runtime 'venv'
+$VenvPy    = Join-Path $Venv 'Scripts\python.exe'
+$Marker    = Join-Path $Venv 'quokkaform-setup.json'
+$Downloads = Join-Path $Runtime 'downloads'
+$LogDir    = Join-Path $DataDir 'logs'
+$Wheels    = Join-Path $AppDir 'wheels'
+$Lock      = Join-Path $PSScriptRoot 'requirements-lock-win.txt'
+$Verify    = Join-Path $PSScriptRoot 'verify_runtime.py'
+
+$MinDriver = [version]'551.61'      # CUDA 12.4 on Windows
+$MinVramMB = 8000                   # below this TRELLIS does not fit
+$GoodVramMB = 11500                 # 12 GB cards: everything at default settings
+
+# nvdiffrast 0.4.0 for torch 2.5 / CUDA 12.4 / Python 3.10 (third-party build,
+# github.com/PozzettiAndrea/cuda-wheels). The release tag is not immutable,
+# so the file is pinned by its SHA-256; a different file is never installed.
+$NvdrWheelName = 'nvdiffrast-0.4.0+cu124torch2.5-cp310-cp310-win_amd64.whl'
+$NvdrWheelUrl  = 'https://github.com/PozzettiAndrea/cuda-wheels/releases/download/nvdiffrast-latest/nvdiffrast-0.4.0%2Bcu124torch2.5-cp310-cp310-win_amd64.whl'
+$NvdrWheelSha  = '63a17c0b23308ef7253d90ca0a763f1cf0e6916b1885621a0da4b5a3f271b873'
+# Sources (GitHub archives at pinned commits; no Git needed)
+$NvdrSource = 'nvdiffrast @ https://github.com/NVlabs/nvdiffrast/archive/253ac4fcea7de5f396371124af597e6cc957bfae.zip'
+$DgrSource  = 'diff_gaussian_rasterization @ https://github.com/autonomousvision/mip-splatting/archive/dda02ab5ecf45d6edb8c540d9bb65c7e451345a9.zip#subdirectory=submodules/diff-gaussian-rasterization'
+
+New-Item -ItemType Directory -Force -Path $LogDir, $Runtime, $Downloads | Out-Null
+$LogFile = Join-Path $LogDir ('setup-' + (Get-Date -Format 'yyyyMMdd-HHmmss') + '.log')
+$script:Warnings = @()
+$script:BuildToolsReady = $false
+
+# ------------------------------------------------------------------ helpers
+function Add-LogLine([string]$Text) {
+    try { [System.IO.File]::AppendAllText($LogFile, $Text + "`r`n") } catch { $null = $_ }  # logging must never stop the setup
+}
+
+function Say([string]$Text, [string]$Color = 'Gray') {
+    Write-Host $Text -ForegroundColor $Color
+    Add-LogLine $Text
+}
+
+function Step([string]$Text) {
+    Say ''
+    Say ('==> ' + $Text) 'Cyan'
+}
+
+function Warn([string]$Text) {
+    Say ('WARNING: ' + $Text) 'Yellow'
+    $script:Warnings += $Text
+}
+
+function Finish([int]$Code) {
+    $needsReading = ($Code -ne 0) -or ($script:Warnings.Count -gt 0)
+    if ($FromInstaller -and $needsReading -and -not $Unattended) {
+        Read-Host 'Press Enter to close this window' | Out-Null
+    }
+    exit $Code
+}
+
+function Fail([string]$Text) {
+    Say ''
+    Say ('SETUP STOPPED: ' + $Text) 'Red'
+    Say ('Log file: ' + $LogFile)
+    Say 'Fix the problem and run "QuokkaForm Setup (repair)" from the Start menu.'
+    Finish 1
+}
+
+function Ask([string]$Question, [bool]$Default) {
+    if ($Unattended) { return $Default }
+    $hint = '[y/N]'
+    if ($Default) { $hint = '[Y/n]' }
+    $answer = Read-Host ($Question + ' ' + $hint)
+    Add-LogLine ($Question + ' -> ' + $answer)
+    if ([string]::IsNullOrWhiteSpace($answer)) { return $Default }
+    return $answer.Trim().ToLower().StartsWith('y')
+}
+
+# Run a program, show and log its output (stdout and stderr), return the exit code.
+function Invoke-Tool([string]$Exe, [string[]]$Arguments) {
+    Add-LogLine ('> "' + $Exe + '" ' + ($Arguments -join ' '))
+    & $Exe @Arguments 2>&1 | ForEach-Object {
+        $line = "$_"
+        Write-Host $line
+        Add-LogLine $line
+    }
+    return $LASTEXITCODE
+}
+
+# True if the runtime's Python can import the module.
+function Test-Import([string]$Module) {
+    if (-not (Test-Path $VenvPy)) { return $false }
+    & $VenvPy -c ('import ' + $Module) 2>$null | Out-Null
+    return ($LASTEXITCODE -eq 0)
+}
+
+function Invoke-UvInstall([string[]]$Arguments) {
+    $all = @('pip', 'install', '--python', $VenvPy) + $Arguments
+    return (Invoke-Tool $Uv $all)
+}
+
+function Get-NvidiaGpu {
+    $smi = Join-Path $env:SystemRoot 'System32\nvidia-smi.exe'
+    if (-not (Test-Path $smi)) {
+        $cmd = Get-Command 'nvidia-smi.exe' -ErrorAction SilentlyContinue
+        if ($null -eq $cmd) { return $null }
+        $smi = $cmd.Source
+    }
+    $out = & $smi '--query-gpu=name,driver_version,memory.total' '--format=csv,noheader,nounits' 2>$null
+    if ($LASTEXITCODE -ne 0 -or -not $out) { return $null }
+    $parts = @(@($out)[0].Split(',') | ForEach-Object { $_.Trim() })
+    if ($parts.Count -lt 3) { return $null }
+    $vram = 0
+    [void][int]::TryParse($parts[2], [ref]$vram)
+    return [pscustomobject]@{ Name = $parts[0]; Driver = $parts[1]; VramMB = $vram }
+}
+
+# Find the CUDA 12.x toolkit and the MSVC compiler and load them into this
+# process's environment. Returns $true when a CUDA extension can be built.
+function Initialize-Toolchain {
+    if ($script:BuildToolsReady) { return $true }
+
+    # Visual Studio 2022 C++ Build Tools (cl.exe), loaded through vcvars64.bat
+    if ($null -eq (Get-Command 'cl.exe' -ErrorAction SilentlyContinue)) {
+        $vswhere = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe'
+        $vs = $null
+        if (Test-Path $vswhere) {
+            $vs = & $vswhere -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath
+        }
+        if (-not $vs) {
+            Warn ('The Visual Studio C++ compiler was not found. Install "Build Tools for Visual Studio 2022" with ' +
+                  'the "Desktop development with C++" workload: https://visualstudio.microsoft.com/visual-cpp-build-tools/')
+            return $false
+        }
+        $vcvars = Join-Path (@($vs)[0]) 'VC\Auxiliary\Build\vcvars64.bat'
+        if (-not (Test-Path $vcvars)) {
+            Warn ('vcvars64.bat is missing in ' + $vs + '. Repair the Visual Studio Build Tools (C++ workload).')
+            return $false
+        }
+        Say ('Loading the Visual Studio C++ environment: ' + $vcvars)
+        # A small .cmd file avoids quoting trouble with paths that contain spaces.
+        $envCmd = Join-Path $Downloads 'vcvars-env.cmd'
+        [System.IO.File]::WriteAllText($envCmd, ('@call "' + $vcvars + '" >nul 2>&1' + "`r`n" + '@set' + "`r`n"))
+        $dump = & cmd.exe /d /c $envCmd
+        foreach ($line in $dump) {
+            if ($line -match '^([^=]+)=(.*)$') {
+                [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2], 'Process')
+            }
+        }
+        if ($null -eq (Get-Command 'cl.exe' -ErrorAction SilentlyContinue)) {
+            Warn 'cl.exe is still not available after vcvars64.bat. Repair the Visual Studio Build Tools.'
+            return $false
+        }
+    }
+
+    # CUDA toolkit 12.x (12.4 recommended, it matches PyTorch's CUDA)
+    $cuda = $env:CUDA_PATH_V12_4
+    if (-not $cuda) { $cuda = $env:CUDA_PATH }
+    if (-not $cuda -or -not (Test-Path (Join-Path $cuda 'bin\nvcc.exe'))) {
+        $root = Join-Path $env:ProgramFiles 'NVIDIA GPU Computing Toolkit\CUDA'
+        $cuda = $null
+        if (Test-Path $root) {
+            $found = Get-ChildItem $root -Directory -Filter 'v12.*' | Sort-Object Name -Descending | Select-Object -First 1
+            if ($found) { $cuda = $found.FullName }
+        }
+    }
+    if (-not $cuda -or -not (Test-Path (Join-Path $cuda 'bin\nvcc.exe'))) {
+        Warn ('The NVIDIA CUDA Toolkit 12.4 was not found. Install it from ' +
+              'https://developer.nvidia.com/cuda-12-4-0-download-archive (Windows, x86_64).')
+        return $false
+    }
+    $nvccVersion = (& (Join-Path $cuda 'bin\nvcc.exe') --version 2>&1 | Out-String)
+    if ($nvccVersion -notmatch 'release 12\.') {
+        Warn ('The CUDA Toolkit in ' + $cuda + ' is not version 12.x. Install CUDA 12.4.')
+        return $false
+    }
+    $env:CUDA_PATH = $cuda
+    $env:CUDA_HOME = $cuda
+    $env:Path = (Join-Path $cuda 'bin') + ';' + (Join-Path $Venv 'Scripts') + ';' + $env:Path
+    $env:DISTUTILS_USE_SDK = '1'
+    Say ('Build tools ready: CUDA in ' + $cuda + ', MSVC cl.exe found.')
+    $script:BuildToolsReady = $true
+    return $true
+}
+
+# ---------------------------------------------------------------- 0. start
+$Version = 'unknown'
+$versionFile = Join-Path $AppDir 'VERSION.txt'
+if (Test-Path $versionFile) { $Version = (Get-Content $versionFile -TotalCount 1).Trim() }
+Say '========================================================' 'Cyan'
+Say ('  ' + $Version + ' - setup / repair') 'Cyan'
+Say '  QuokkaForm - Images To Mesh (free, non-commercial use)' 'Cyan'
+Say '========================================================' 'Cyan'
+Say ('Install folder: ' + $AppDir)
+Say ('Runtime folder: ' + $Runtime)
+Say ('Log file:       ' + $LogFile)
+
+if (-not [Environment]::Is64BitOperatingSystem) { Fail 'QuokkaForm needs 64-bit Windows 10 or 11.' }
+
+$running = $null
+if ([System.Threading.Mutex]::TryOpenExisting('QuokkaFormDesktop', [ref]$running)) {
+    $running.Dispose()
+    Fail 'QuokkaForm is open. Close the QuokkaForm window, then run the setup again.'
+}
+
+# ------------------------------------------------------------ 1. NVIDIA GPU
+Step 'Checking the NVIDIA graphics card and driver'
+$gpu = Get-NvidiaGpu
+if ($null -eq $gpu) {
+    Say 'No NVIDIA graphics card or driver was found (nvidia-smi did not answer).' 'Yellow'
+    Say 'QuokkaForm needs an NVIDIA GPU (RTX 3060 12 GB or better recommended) with driver 551.61 or newer:'
+    Say '  https://www.nvidia.com/drivers  (or the NVIDIA App)'
+    if (-not (Ask 'Continue the setup anyway?' $false)) { Fail 'No NVIDIA GPU / driver.' }
+    Warn 'No NVIDIA GPU / driver found; QuokkaForm will not be able to make models until one is installed.'
+} else {
+    Say ('GPU: ' + $gpu.Name + ', ' + [math]::Round($gpu.VramMB / 1024, 1) + ' GB VRAM, driver ' + $gpu.Driver)
+    $driver = $null
+    try { $driver = [version]$gpu.Driver } catch { $driver = $null }  # unusual version text: skip the check
+    if ($null -ne $driver -and $driver -lt $MinDriver) {
+        Warn ('The NVIDIA driver ' + $gpu.Driver + ' is too old for CUDA 12.4. Install driver 551.61 or newer from ' +
