diff --git a/tests/fakes/webview/__init__.py b/tests/fakes/webview/__init__.py
new file mode 100644
index 0000000..c8e295f
--- /dev/null
+++ b/tests/fakes/webview/__init__.py
@@ -0,0 +1,77 @@
+"""Fake pywebview for headless tests of app/desktop.py.
+
+start() runs the boot function, waits until the window was pointed at the
+UI (load_url) or an error page (load_html after the splash), fires the
+"loaded" event, then returns as if the user closed the window.
+Records what happened in the JSON file named by FAKE_WEBVIEW_REPORT.
+"""
+import json
+import os
+import threading
+import time
+
+settings = {"ALLOW_DOWNLOADS": False, "OPEN_EXTERNAL_LINKS_IN_BROWSER": True}
+_windows = []
+
+
+class _Event:
+    def __init__(self):
+        self.handlers = []
+
+    def __iadd__(self, fn):
+        self.handlers.append(fn)
+        return self
+
+
+class _Events:
+    def __init__(self):
+        for name in ("resized", "maximized", "restored", "loaded", "closed", "closing", "shown"):
+            setattr(self, name, _Event())
+
+
+class Window:
+    def __init__(self, title, html, **kw):
+        self.title, self.kw = title, kw
+        self.events = _Events()
+        self.html_pages = [html]
+        self.url = None
+        self.js = []
+        self.done = threading.Event()
+
+    def load_url(self, url):
+        self.url = url
+        self.done.set()
+
+    def load_html(self, html):
+        self.html_pages.append(html)
+        self.done.set()
+
+    def get_current_url(self):
+        return self.url
+
+    def run_js(self, js):
+        self.js.append(js)
+
+
+def create_window(title, html=None, **kw):
+    w = Window(title, html, **kw)
+    _windows.append(w)
+    return w
+
+
+def start(func=None, **kw):
+    w = _windows[0]
+    threading.Thread(target=func, daemon=True).start()
+    ok = w.done.wait(float(os.environ.get("FAKE_WEBVIEW_TIMEOUT", "120")))
+    if w.url:
+        for h in w.events.loaded.handlers:
+            h(w)
+        for h in w.events.resized.handlers:
+            h(1500, 950)
+    report = {"ok": ok, "title": w.title, "url": w.url, "pages": len(w.html_pages),
+              "error_page": "could not start" in w.html_pages[-1], "js": len(w.js),
+              "settings": settings, "start_kw": {k: str(v) for k, v in kw.items()},
+              "window_kw": {k: str(v) for k, v in w.kw.items()}}
+    with open(os.environ["FAKE_WEBVIEW_REPORT"], "w") as f:
+        json.dump(report, f)
+    time.sleep(float(os.environ.get("FAKE_WEBVIEW_HOLD", "0")))
