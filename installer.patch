+} else {
+    Say 'Skipped. Download them later in the app: Setup > Models > Download missing models.'
+}
+
+# -------------------------------------------------------------- 10. summary
+Say ''
+if ($script:Warnings.Count -gt 0) {
+    Say 'QuokkaForm is installed, with these notes:' 'Yellow'
+    foreach ($w in $script:Warnings) { Say (' - ' + $w) 'Yellow' }
