+def test_old_caches_are_reused(tmp_path):
+    env = _win_env(tmp_path)
+    user = tmp_path / "user"
+    (user / ".cache" / "huggingface" / "hub" / "models--microsoft--TRELLIS-image-large").mkdir(parents=True)
+    _touch(user / ".cache" / "torch" / "hub" / "checkpoints" / "dinov2_vitl14_reg4_pretrain.pth")
+    _touch(user / ".u2net" / "birefnet-general-lite.onnx")
