diff --git a/app/backend/model.py b/app/backend/model.py
index 724990b..4257efe 100644
--- a/app/backend/model.py
+++ b/app/backend/model.py
@@ -385,6 +385,17 @@ class TurntableJob:
 
 
 MAX_IMAGES = 6
+# Simplify = fraction of TRELLIS's faces removed before hole filling (pyvista
+# decimate). 0.95 is TRELLIS's default; 0.5 keeps half (~10x the faces of 0.95).
+SIMPLIFY_RANGE = (0.5, 0.98)
+
+
+def check_simplify(value) -> float:
+    lo, hi = SIMPLIFY_RANGE
+    v = float(value)
+    if not lo <= v <= hi:
+        raise ValueError(f"Simplify must be between {lo} and {hi}, got {v}.")
+    return v
 
 
 def _finish_own_video(mesh, job: Optional[TurntableJob], timer: StageTimer):
