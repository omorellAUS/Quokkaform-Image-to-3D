+"""
+Remember the last used settings between sessions.
+
+The settings (generation, background, export incl. flatten base, size in
+mm, triangle count, video toggle and length, auto-select, outputs folder)
+are saved as JSON when they are used (Generate, Batch, Re-export, Preview)
+and loaded into the UI every time the page opens. 'Reset to defaults'
+restores DEFAULTS and saves them.
+
+Location: IMG3D_CONFIG_DIR if set, else %APPDATA%\\Image-to-3D on Windows,
+else ~/.image-to-3d; file settings.json. Unknown keys are ignored and a
+missing, damaged or out-of-range value falls back to its default, so an old
+or hand-edited file can never stop the app from starting.
+"""
+
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+from typing import Any, Callable, Dict, Optional
+
+from .background import BG_MODELS, DEFAULT_BG_MODEL, DEFAULT_TOLERANCE
+from .texturing import DEFAULT_TEXTURE_MODE, TEXTURE_MODES
+
+VERSION = 1
+FILENAME = "settings.json"
+
+
+def _num(lo, hi, integer=False) -> Callable[[Any], Any]:
+    def check(v):
+        if isinstance(v, bool) or not isinstance(v, (int, float)):
+            raise ValueError("not a number")
+        if not lo <= v <= hi:
+            raise ValueError("out of range")
+        return int(round(v)) if integer else float(v)
+    return check
+
+
+def _choice(*choices) -> Callable[[Any], Any]:
+    def check(v):
+        if v not in choices:
+            raise ValueError("unknown choice")
+        return v
+    return check
+
+
+def _bool(v):
+    if not isinstance(v, bool):
+        raise ValueError("not a bool")
+    return v
+
+
+def _text(v):
+    if not isinstance(v, str) or len(v) > 1000:
+        raise ValueError("not a string")
+    return v.strip()
+
+
+# key -> (default, validator). Keys match the UI component names in main.py.
+SCHEMA: Dict[str, tuple] = {
+    "multi_image_mode": ("stochastic", _choice("stochastic", "multidiffusion")),
+    "remove_bg": (True, _bool),
+    "bg_model": (DEFAULT_BG_MODEL, _choice(*BG_MODELS)),
+    "clean_mask": (True, _bool),
+    "remove_enclosed": (True, _bool),
+    "bg_tolerance": (DEFAULT_TOLERANCE, _num(0, 100, True)),
+    "auto_select": (False, _bool),
+    "seed": (42, _num(0, 2 ** 31 - 1, True)),
+    "ss_steps": (25, _num(1, 50, True)),
+    "ss_cfg": (5.0, _num(0.0, 10.0)),
+    "slat_steps": (25, _num(1, 50, True)),
+    "slat_cfg": (5.0, _num(0.0, 10.0)),
+    "simplify": (0.95, _num(0.9, 0.98)),
+    "texture_size": (1024, _choice(512, 1024, 1536, 2048)),
+    "texture_mode": (DEFAULT_TEXTURE_MODE, _choice(*TEXTURE_MODES)),
+    "target_faces": (0, _num(0, 500000, True)),
+    "export_quads": (False, _bool),
+    "quad_faces": (2000, _num(100, 10 ** 7, True)),
+    "render_video": (False, _bool),
+    "video_seconds": (12, _num(4, 15, True)),
+    "target_size_mm": (100.0, _num(0, 100000)),
+    "size_axis": ("longest", _choice("longest", "x", "y", "z")),
+    "flatten": (False, _bool),
+    "cut_mm": (1.0, _num(0.1, 1000)),
+    "output_dir": ("", _text),        # "" = default (Documents/Image-to-3D/outputs)
+    "save_history": (True, _bool),
+}
+KEYS = list(SCHEMA)
+DEFAULTS = {k: d for k, (d, _) in SCHEMA.items()}
+
+
+def config_dir() -> Path:
+    env = os.environ.get("IMG3D_CONFIG_DIR")
+    if env:
+        return Path(env)
+    if sys.platform.startswith("win") and os.environ.get("APPDATA"):
+        return Path(os.environ["APPDATA"]) / "Image-to-3D"
+    return Path.home() / ".image-to-3d"
+
+
+def settings_path() -> Path:
+    return config_dir() / FILENAME
+
+
+def validate(values: Dict[str, Any], log: Optional[Callable] = None) -> Dict[str, Any]:
+    """Defaults merged with the valid entries of `values`."""
+    out = dict(DEFAULTS)
+    for k, v in (values or {}).items():
+        if k not in SCHEMA:
+            continue
+        try:
+            out[k] = SCHEMA[k][1](v)
+        except (ValueError, TypeError) as e:
+            if log:
+                log(f"[settings] ignoring {k}={v!r} ({e}); using the default {DEFAULTS[k]!r}")
+    return out
+
+
+def load(log: Callable = print) -> Dict[str, Any]:
+    """Saved settings (defaults for anything missing or invalid)."""
+    p = settings_path()
+    if not p.is_file():
+        return dict(DEFAULTS)
+    try:
+        data = json.loads(p.read_text(encoding="utf-8"))
+        if not isinstance(data, dict):
+            raise ValueError("not a JSON object")
+    except (OSError, ValueError) as e:
+        log(f"[settings] could not read {p} ({e}); using defaults")
+        return dict(DEFAULTS)
+    return validate(data.get("settings", data), log)
+
+
+def save(values: Dict[str, Any], log: Callable = print) -> Optional[Path]:
+    """Validate and write atomically; returns the path (None if it could not be written)."""
+    clean = validate(values, log)
+    p = settings_path()
+    try:
+        p.parent.mkdir(parents=True, exist_ok=True)
+        fd, tmp = tempfile.mkstemp(prefix="settings_", suffix=".tmp", dir=p.parent)
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            json.dump({"version": VERSION, "settings": clean}, f, indent=2)
+        os.replace(tmp, p)
+    except OSError as e:
+        log(f"[settings] could not save {p}: {e}")
+        return None
+    return p
+
+
+def reset(log: Callable = print) -> Dict[str, Any]:
+    save(DEFAULTS, log)
+    return dict(DEFAULTS)
