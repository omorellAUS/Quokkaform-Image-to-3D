+                t0 = time.time()
+                try:
+                    self._one(item)
+                    item["status"] = "done"
+                except Cancelled as e:
+                    item["status"], item["message"] = "cancelled", "cancelled by you"
+                    if self._job is not None:
+                        self._job._fail(e, "Generation")
+                except Exception as e:
+                    import traceback
+
+                    traceback.print_exc()
+                    if self._job is not None:  # make sure the run folder says why
+                        self._job._fail(e, "Generation")
+                    item["status"] = "failed"
+                    item["message"] = friendly_message(e, "Generation", oom_context(self.settings))
+                    if classify(e) == "oom":
+                        from .runtime import release_exception
+
+                        release_exception(e)
+                finally:
+                    item["seconds"] = round(time.time() - t0, 1)
+                    self._release()
+                self.log(f"[batch] {i + 1}/{len(self.items)} {item['name']}: {item['status']}"
+                         f"{' - ' + item['message'].splitlines()[0] if item['message'] else ''}")
+        finally:
+            self.current, self.stage = None, ""
+            self.finished = time.time()
+            self.running = False
+
+    def _one(self, item: dict) -> None:
+        image = _open(item["path"])
+        stem = os.path.splitext(item["name"])[0]
+        job = GenerationJob([image], self.settings, name=stem, save=True, output_dir=self.output_dir,
+                            kind="batch", source_names=[item["path"]], log=self.log)
+        self._job = job
+        item["folder"] = job.folder
+        if job.history_note:
+            item["message"] = job.history_note
+        job.generate(None, self._progress, should_stop=lambda: self.cancelled)
+        if job.result.video_job is not None:
+            job.render_video(self._progress, should_stop=lambda: self.cancelled)
+            if self.cancelled:
+                item["message"] = "360° video cancelled; the 3D files are saved"
+            elif job.result.video_info.startswith("WARNING"):
+                item["message"] = job.result.video_info.splitlines()[0]
+        job.finish()
+
+    # reporting -------------------------------------------------------
+    def counts(self) -> dict:
+        c = {}
+        for it in self.items:
+            c[it["status"]] = c.get(it["status"], 0) + 1
+        return c
+
+    def rows(self) -> List[list]:
+        return [[i + 1, it["name"], it["status"], "" if it["seconds"] is None else it["seconds"],
+                 it["folder"] or "", it["message"]] for i, it in enumerate(self.items)]
+
+    def summary(self) -> str:
+        n = len(self.items)
+        c = self.counts()
+        done = sum(c.get(k, 0) for k in ("done", "failed", "cancelled", "skipped"))
+        elapsed = (self.finished or time.time()) - (self.started or time.time())
+        parts = [f"{c.get('done', 0)} done", f"{c.get('failed', 0)} failed"]
+        if c.get("cancelled") or c.get("skipped"):
+            parts.append(f"{c.get('cancelled', 0) + c.get('skipped', 0)} cancelled/skipped")
+        head = f"**{done} of {n} finished** ({', '.join(parts)}), {elapsed:.0f} s"
+        if self.running and self.current is not None:
+            it = self.items[self.current]
+            head += f"\n\nNow: **{it['name']}** ({self.current + 1}/{n}) - {self.stage or 'starting'}"
+            if self.cancelled:
+                head += " - cancelling at the next step ..."
+        elif not self.running and self.finished:
+            head = ("Batch cancelled. " if self.cancelled else "Batch finished. ") + head
+            done_runs = [it for it in self.items if it["status"] == "done"]
+            if done_runs:
+                head += "\n\nEvery model is in its own folder in the outputs folder and in the **History** tab."
+        return head
