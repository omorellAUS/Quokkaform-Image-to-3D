+"""
+Startup environment check: Python, PyTorch/CUDA, GPU, driver, RAM, disk.
+
+environment_report() never raises; it returns a dict with the facts and a
+list of problems ("error" = generation will not work, "warning" = it may be
+slow or run out of memory). format_report() renders it as Markdown for the
+UI, log_report() prints it to the console at startup.
+"""
+
+import os
+import platform
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+from typing import List, Optional, Tuple
+
+from .errors import MIN_DRIVER, MIN_DRIVER_TEXT
+
+RECOMMENDED_VRAM_GB = 12
+RECOMMENDED_RAM_GB = 16
+
+
+def _version_tuple(v: str) -> Tuple[int, ...]:
+    out = []
+    for part in str(v).strip().split("."):
+        digits = "".join(ch for ch in part if ch.isdigit())
+        if not digits:
+            break
+        out.append(int(digits))
+    return tuple(out)
+
+
+def driver_too_old(version: str, plat: str = sys.platform) -> bool:
+    need = MIN_DRIVER.get("win32" if plat.startswith("win") else "linux")
+    have = _version_tuple(version)
+    return bool(need and have) and have < need
+
+
+def _nvidia_smi() -> Optional[dict]:
+    exe = shutil.which("nvidia-smi")
+    if exe is None and sys.platform.startswith("win"):
+        cand = Path(os.environ.get("SystemRoot", r"C:\Windows")) / "System32" / "nvidia-smi.exe"
+        exe = str(cand) if cand.exists() else None
+    if exe is None:
+        return None
+    try:
+        out = subprocess.run(
+            [exe, "--query-gpu=name,driver_version,memory.total", "--format=csv,noheader,nounits"],
+            capture_output=True, text=True, timeout=10,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    if out.returncode != 0 or not out.stdout.strip():
+        return None
+    name, driver, mem = [x.strip() for x in out.stdout.strip().splitlines()[0].split(",")[:3]]
+    try:
+        mem_gb = float(mem) / 1024
+    except ValueError:
+        mem_gb = None
+    return {"name": name, "driver": driver, "vram_gb": mem_gb}
+
+
+def _ram_gb() -> Optional[float]:
+    try:
+        if sys.platform.startswith("win"):
+            import ctypes
+
+            class MEMORYSTATUSEX(ctypes.Structure):
+                _fields_ = [("dwLength", ctypes.c_ulong), ("dwMemoryLoad", ctypes.c_ulong),
+                            ("ullTotalPhys", ctypes.c_ulonglong), ("ullAvailPhys", ctypes.c_ulonglong),
+                            ("ullTotalPageFile", ctypes.c_ulonglong), ("ullAvailPageFile", ctypes.c_ulonglong),
+                            ("ullTotalVirtual", ctypes.c_ulonglong), ("ullAvailVirtual", ctypes.c_ulonglong),
+                            ("sullAvailExtendedVirtual", ctypes.c_ulonglong)]
+
+            st = MEMORYSTATUSEX()
+            st.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
+            ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(st))
+            return st.ullTotalPhys / 1024 ** 3
+        return os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") / 1024 ** 3
+    except Exception:
+        return None
+
+
+def _disk_free_gb(path: Path) -> Optional[float]:
+    p = Path(path)
+    while not p.exists() and p.parent != p:
+        p = p.parent
+    try:
+        return shutil.disk_usage(p).free / 1024 ** 3
+    except OSError:
+        return None
+
+
+def environment_report(models_missing_mb: float = 0.0, model_dir: Optional[Path] = None) -> dict:
+    """Facts + problems. models_missing_mb: size still to download (download_models.status)."""
+    r = {
+        "python": platform.python_version(),
+        "os": f"{platform.system()} {platform.release()}",
+        "torch": None, "torch_cuda": None, "cuda_available": False,
+        "gpu": None, "vram_gb": None, "capability": None, "driver": None,
+        "ram_gb": _ram_gb(), "disk_free_gb": None, "attn_backend": os.environ.get("ATTN_BACKEND", "flash_attn"),
+        "problems": [],
+    }
+    problems: List[Tuple[str, str]] = r["problems"]
+    if sys.version_info[:2] != (3, 10):
+        problems.append(("warning", f"Python {r['python']}: this app is built for Python 3.10 (the prebuilt "
+                                    "flash-attn / kaolin wheels are cp310)."))
+    try:
+        import torch
+
+        r["torch"] = torch.__version__
+        r["torch_cuda"] = torch.version.cuda
+        r["cuda_available"] = bool(torch.cuda.is_available())
+        if r["cuda_available"]:
+            p = torch.cuda.get_device_properties(0)
+            r["gpu"], r["vram_gb"] = p.name, p.total_memory / 1024 ** 3
+            r["capability"] = f"{p.major}.{p.minor}"
+    except Exception as e:  # broken torch install
+        problems.append(("error", f"PyTorch could not be loaded ({type(e).__name__}: {e}). Run "
+                                  "'start.bat --reinstall'."))
+    smi = _nvidia_smi()
+    if smi:
+        r["driver"] = smi["driver"]
+        r["gpu"] = r["gpu"] or smi["name"]
+        r["vram_gb"] = r["vram_gb"] or smi["vram_gb"]
+    if r["torch"] and not r["torch_cuda"]:
+        problems.append(("error", "PyTorch is a CPU-only build, so TRELLIS cannot run. Run 'start.bat --reinstall' "
+                                  "to install the CUDA 12.4 build."))
+    elif r["torch"] and not r["cuda_available"]:
+        if smi is None:
+            problems.append(("error", "No NVIDIA GPU / driver found (CUDA is not available). This app needs an "
+                                      "NVIDIA graphics card (12 GB VRAM recommended) with a current driver."))
+        else:
+            problems.append(("error", f"An NVIDIA GPU ({smi['name']}, driver {smi['driver']}) was found but CUDA "
+                                      "is not available to PyTorch. Update the driver and restart the PC."))
+    if r["driver"] and driver_too_old(r["driver"]):
+        problems.append(("error", f"NVIDIA driver {r['driver']} is too old for CUDA 12.4: install "
+                                  f"{MIN_DRIVER_TEXT} or newer from https://www.nvidia.com/drivers."))
+    if r["vram_gb"] is not None and r["vram_gb"] < RECOMMENDED_VRAM_GB - 0.5:
+        problems.append(("warning", f"The GPU has {r['vram_gb']:.0f} GB of VRAM; {RECOMMENDED_VRAM_GB} GB or more "
+                                    "is recommended. Use Texture bake Fast or None and Texture size 1024 or less; "
+                                    "generation may be slow or run out of memory."))
+    if r["capability"] and _version_tuple(r["capability"]) < (8, 0) and r["attn_backend"] == "flash_attn":
+        problems.append(("warning", f"This GPU (compute capability {r['capability']}) is older than RTX 30xx: "
+                                    "flash-attn will not run on it. Set ATTN_BACKEND=xformers (see README)."))
+    if r["ram_gb"] is not None and r["ram_gb"] < RECOMMENDED_RAM_GB - 0.5:
+        problems.append(("warning", f"{r['ram_gb']:.0f} GB of system RAM: BiRefNet background removal needs about "
+                                    "6-7 GB; pick IS-Net or U2-Net if the PC runs out of memory."))
+    if model_dir is not None:
+        r["disk_free_gb"] = _disk_free_gb(model_dir)
+        need_gb = models_missing_mb / 1024 + 1.0
+        if models_missing_mb and r["disk_free_gb"] is not None and r["disk_free_gb"] < need_gb:
+            problems.append(("error", f"Only {r['disk_free_gb']:.1f} GB free on the disk with the model cache; the "
+                                      f"missing models need about {need_gb:.1f} GB."))
+    return r
+
+
+def has_errors(report: dict) -> bool:
+    return any(level == "error" for level, _ in report["problems"])
+
+
+def format_report(r: dict) -> str:
+    gpu = r["gpu"] or "none found"
+    if r["vram_gb"]:
+        gpu += f", {r['vram_gb']:.0f} GB VRAM"
+    lines = [
+        f"- **GPU:** {gpu}" + (f" (compute capability {r['capability']})" if r["capability"] else ""),
+        f"- **NVIDIA driver:** {r['driver'] or 'not found'}",
+        f"- **PyTorch:** {r['torch'] or 'not installed'}"
+        + (f", CUDA {r['torch_cuda']}" if r["torch_cuda"] else "")
+        + f", CUDA available: {'yes' if r['cuda_available'] else 'no'}",
+        f"- **Python:** {r['python']} on {r['os']}",
+        f"- **System RAM:** {r['ram_gb']:.0f} GB" if r["ram_gb"] else "- **System RAM:** unknown",
+        f"- **Attention backend:** {r['attn_backend']}",
+    ]
+    if r.get("disk_free_gb") is not None:
+        lines.append(f"- **Free disk (model cache):** {r['disk_free_gb']:.0f} GB")
+    if r["problems"]:
+        lines.append("")
+        for level, text in r["problems"]:
+            lines.append(f"- {'❌ **Problem:**' if level == 'error' else '⚠️ **Warning:**'} {text}")
+    else:
+        lines += ["", "- ✅ No problems found."]
+    return "\n".join(lines)
+
+
+def log_report(r: dict, log=print) -> None:
+    log("[env] " + " | ".join(
+        f"{k}={r[k]}" for k in ("python", "os", "torch", "torch_cuda", "cuda_available", "gpu", "driver", "attn_backend")))
+    if r["vram_gb"]:
+        log(f"[env] VRAM {r['vram_gb']:.1f} GB" + (f", RAM {r['ram_gb']:.1f} GB" if r["ram_gb"] else ""))
+    for level, text in r["problems"]:
+        log(f"[env] {level.upper()}: {text}")
diff --git a/app/backend/errors.py b/app/backend/errors.py
new file mode 100644
index 0000000..91283be
--- /dev/null
+++ b/app/backend/errors.py
@@ -0,0 +1,175 @@
+"""
+Plain-language error messages for the UI (gr.Error) and the API.
+
+friendly_message(exc) turns the usual failures into one or two sentences
+a non-programmer can act on: CUDA out of memory (with setting suggestions
+based on what was used), no NVIDIA GPU / CPU-only PyTorch, a driver too
+old for CUDA 12.4, a GPU too old for flash-attn, a failed or interrupted
+model download (retry advice), a corrupt downloaded file, a bad image,
+a full disk, and system RAM running out. Anything else keeps its original
+text. The full traceback always goes to the console.
+"""
+
+import errno
+from typing import Optional
+
+# CUDA 12.4 needs at least these NVIDIA driver versions (CUDA 12.4 release notes).
+MIN_DRIVER = {"win32": (551, 61), "linux": (550, 54, 14)}
+MIN_DRIVER_TEXT = "551.61 (Windows) / 550.54 (Linux)"
+
+CONSOLE = "Details are in the console window."
+
+
+def _chain(exc: BaseException):
+    seen = set()
+    while exc is not None and id(exc) not in seen:
+        seen.add(id(exc))
+        yield exc
+        exc = exc.__cause__ or exc.__context__
+
+
+def _text(exc: BaseException) -> str:
+    return " | ".join(f"{type(e).__name__}: {e}" for e in _chain(exc)).lower()
+
+
+def _any(text: str, *needles: str) -> bool:
+    return any(n.lower() in text for n in needles)
+
+
+def is_cuda_oom(exc: BaseException) -> bool:
+    for e in _chain(exc):
+        if type(e).__name__ == "OutOfMemoryError":
+            return True
+    t = _text(exc)
+    return _any(t, "cuda out of memory", "cuda error: out of memory", "cublas_status_alloc_failed",
+                "cudnn_status_alloc_failed", "out of memory (simulated)") or (
+        "out of memory" in t and "cpu" not in t and "defaultcpuallocator" not in t)
+
+
+def oom_advice(settings: Optional[dict] = None) -> str:
+    """Setting suggestions for a CUDA out-of-memory error, cheapest first."""
+    s = settings or {}
+    tips = []
+    if s.get("texture_mode", "fast") == "quality":
+        tips.append("set Texture bake to Fast (Quality needs about 4 GB more)")
+    elif s.get("texture_mode") != "none":
+        tips.append("set Texture bake to None if you only need the STL")
+    if int(s.get("texture_size", 1024) or 1024) > 1024:
+        tips.append("use Texture size 1024 or 512")
+    if s.get("render_video"):
+        tips.append("untick Render 360° video")
+    if s.get("n_images", 1) > 1:
+        tips.append("use fewer photos" + (" or the Stochastic mode" if s.get("multi_image_mode") == "multidiffusion" else ""))
+    tips.append("close other programs that use the graphics card (games, video editors, other AI apps, "
+                "browser tabs with 3D content)")
+    tips.append("restart the app if it keeps happening")
+    return "Try: " + "; ".join(tips) + "."
+
+
+def classify(exc: BaseException) -> str:
+    """Short category name: oom, ram, no_cuda, old_driver, old_gpu, download, corrupt, image,
+    disk, cancelled or other."""
+    names = {type(e).__name__ for e in _chain(exc)}
+    t = _text(exc)
+    if "Cancelled" in names:
+        return "cancelled"
+    if is_cuda_oom(exc):
+        return "oom"
+    if "MemoryError" in names or _any(t, "defaultcpuallocator: can't allocate", "not enough memory",
+                                      "bad allocation", "failed to allocate memory"):
+        return "ram"
+    if _any(t, "driver version is insufficient", "nvidia driver on your system is too old",
+            "cuda driver version is insufficient"):
+        return "old_driver"
+    if _any(t, "torch not compiled with cuda", "no cuda gpus are available", "found no nvidia driver",
+            "cuda driver initialization failed", "no nvidia gpu", "cuda is not available",
+            "cudagetdevicecount", "nvml"):
+        return "no_cuda"
+    if _any(t, "no kernel image is available", "flashattention only supports ampere",
+            "only supports ampere gpus", "cuda capability sm_"):
+        return "old_gpu"
+    if _any(t, "pytorchstreamreader failed", "invalid load key", "error while deserializing header",
+            "safetensorerror", "headertoolarge", "unexpected eof", "invalid_protobuf", "protobuf parsing failed",
+            "hash mismatch", "md5 hash", "sha256 hash", "file is not a zip file", "corrupt", "incomplete"):
+        return "corrupt"
+    if names & {"ConnectionError", "ReadTimeout", "ConnectTimeout", "Timeout", "ChunkedEncodingError",
+                "URLError", "HTTPError", "LocalEntryNotFoundError", "HfHubHTTPError", "IncompleteRead",
+                "RemoteDisconnected", "SSLError", "ProxyError", "ContentTooShortError", "socket.timeout",
+                "TimeoutError", "OfflineModeIsEnabled", "RepositoryNotFoundError"} or _any(
+            t, "max retries exceeded", "getaddrinfo failed", "name or service not known", "connection aborted",
+            "connection reset", "connection refused", "temporary failure in name resolution",
+            "outgoing traffic has been disabled", "couldn't connect", "failed to establish a new connection",
+            "read timed out", "http error", "404 client error", "503 server error"):
+        return "download"
+    if names & {"UnidentifiedImageError", "DecompressionBombError"} or _any(
+            t, "cannot identify image file", "image file is truncated", "left nothing of the object",
+            "the object selection is empty", "broken data stream", "image is too small"):
+        return "image"
+    for e in _chain(exc):
+        if isinstance(e, OSError) and e.errno == errno.ENOSPC:
+            return "disk"
+    if _any(t, "no space left on device", "not enough space on the disk", "disk full"):
+        return "disk"
+    return "other"
+
+
+def friendly_message(exc: BaseException, action: str = "Generation", settings: Optional[dict] = None) -> str:
+    """One readable message for exc (for gr.Error / HTTP detail)."""
+    kind = classify(exc)
+    raw = f"{type(exc).__name__}: {exc}"
+    if kind == "cancelled":
+        return f"{action} cancelled."
+    if kind == "oom":
+        return (f"{action} failed: the graphics card ran out of memory (VRAM). " + oom_advice(settings)
+                + f" {CONSOLE}")
+    if kind == "ram":
+        return (f"{action} failed: the computer ran out of system memory (RAM). Close other programs; "
+                "BiRefNet background removal needs about 6-7 GB, so on a 16 GB PC pick IS-Net or U2-Net "
+                f"under Background removal. {CONSOLE}")
+    if kind == "old_driver":
+        return (f"{action} failed: the NVIDIA graphics driver is too old for CUDA 12.4. Install driver "
+                f"{MIN_DRIVER_TEXT} or newer from https://www.nvidia.com/drivers (or the NVIDIA App), "
+                f"restart the PC and try again. {CONSOLE}")
+    if kind == "no_cuda":
+        return (f"{action} failed: no usable NVIDIA GPU was found (CUDA is not available). This app needs an "
+                "NVIDIA graphics card with an up-to-date driver. If you have one, update the driver from "
+                "https://www.nvidia.com/drivers; if the console says PyTorch is a CPU-only build, run "
+                f"'start.bat --reinstall'. {CONSOLE}")
+    if kind == "old_gpu":
+        return (f"{action} failed: this graphics card is too old for a GPU feature in use (flash-attn needs an "
+                "RTX 30xx or newer). Close the app, set ATTN_BACKEND=xformers (see README) and start again. "
+                f"{CONSOLE}")
+    if kind == "corrupt":
+        return (f"{action} failed: a downloaded model file is damaged (probably an interrupted download). "
+                "Run 'start.bat --download-models' (or Setup > Download models) to repair it; if that does not "
+                "help, delete the file named in the console and download again. " + CONSOLE)
+    if kind == "download":
+        return (f"{action} failed: a model download did not complete ({_short(raw)}). Check the internet "
+                "connection and try again: finished files are kept and the download continues where it "
+                "stopped. You can also download everything up front with 'start.bat --download-models' "
+                f"or Setup > Download models. {CONSOLE}")
+    if kind == "image":
+        return (f"{action} failed: the image could not be used ({_short(raw)}). Use a normal JPG or PNG photo "
+                "(at least 64 px) of a single object; if the background removal left nothing, try another "
+                "Background model, untick Remove background, or select the object with clicks. " + CONSOLE)
+    if kind == "disk":
+        return (f"{action} failed: the disk is full. Free some space (models need about 5 GB, each run a "
+                f"few MB to 100 MB in the outputs folder) and try again. {CONSOLE}")
+    return f"{action} failed: {raw}. {CONSOLE}"
+
+
+def _short(text: str, n: int = 160) -> str:
+    text = " ".join(str(text).split())
+    return text if len(text) <= n else text[: n - 3] + "..."
+
+
+def check_image(image, label: str = "The image") -> None:
+    """Raise ValueError with a readable message for unusable input images."""
+    if image is None:
+        raise ValueError(f"{label} is missing: upload an image first.")
+    w, h = getattr(image, "size", (0, 0))
+    if min(w, h) < 64:
+        raise ValueError(f"{label} is too small ({w} x {h} px): the image is too small, use at least 64 px "
+                         "(ideally 512 px or more).")
+    if w * h > 80_000_000:
+        raise ValueError(f"{label} is very large ({w} x {h} px): please use a photo under 80 megapixels.")
