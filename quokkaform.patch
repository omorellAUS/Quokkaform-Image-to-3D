+def to_device(obj, device):
+    """Move every tensor attribute of a TRELLIS result (MeshExtractResult,
+    Gaussian) to `device` in place; returns obj. None passes through."""
+    if obj is None:
+        return None
+    for k, v in list(vars(obj).items()):
+        if isinstance(v, torch.Tensor):
+            setattr(obj, k, v.to(device))
+    if isinstance(getattr(obj, "device", None), (str, torch.device)):
+        obj.device = device
+    return obj
+
+
+class VideoAbandoned(Exception):
+    pass
