+def _smaller_plans(plan: dict, seconds: float) -> list:
+    """Cheaper fallbacks for a plan that would not finish in time, best first."""
+    out = []
+    for res, frames, colour in (
+        (384, max(30, plan["frames"] // 2), plan["colour"]),
+        (256, max(30, plan["frames"] // 2), False),
+        (256, 30, False),
+    ):
+        if res <= plan["resolution"] and frames <= plan["frames"] and (colour, res, frames) != (
+                plan["colour"], plan["resolution"], plan["frames"]):
+            out.append(dict(resolution=res, frames=frames, colour=colour, reduced=True, fps=frames / seconds))
+    return out
+
+
+def _plan_cost(plan: dict, per_frame: dict, measured_res: int) -> float:
+    """Seconds to render a plan, from the measured seconds per frame per pass."""
+    scale = (plan["resolution"] / measured_res) ** 2
+    keys = ["normal"] + (["color"] if plan["colour"] else [])
+    return sum(plan["frames"] * per_frame[k] * scale for k in keys)
+
