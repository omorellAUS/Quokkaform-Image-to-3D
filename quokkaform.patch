+"""
+One generation with its history folder: shared by the Create tab and Batch.
+
+    job = GenerationJob(images, settings, name="last", save=True, output_dir="")
+    result = job.generate(selections, progress)   # meshes exported + copied to the run folder
+    video = job.render_video(progress)            # optional 360° video (after the meshes)
+    job.finish()                                  # settings.json + log.txt, status ok
+
+A failure or cancel at any step is recorded in the run folder (status,
+error, console log) before the exception is re-raised. A history folder
+that cannot be written never stops the generation itself: the reason is
+added to the info text instead.
+"""
+
+from typing import Callable, List, Optional
+
+from . import history
+from .background import check_bg_model
+from .errors import friendly_message
+from .exporter import check_target_faces
+from .model import MULTI_IMAGE_MODES, check_video_seconds
+from .processor import RunResult, check_tolerance, finish_video, run_generation
+from .runtime import Cancelled, free_cuda
+from .texturing import check_texture_mode
+
+
+def validate_settings(s: dict) -> None:
+    """ValueError with a readable message for settings TRELLIS cannot use."""
+    check_target_faces(s["target_faces"])
+    check_texture_mode(s["texture_mode"])
+    if s["multi_image_mode"] not in MULTI_IMAGE_MODES:
+        raise ValueError(f"Unknown multi-image mode '{s['multi_image_mode']}'.")
+    check_bg_model(s["bg_model"])
+    check_tolerance(s["bg_tolerance"])
+    check_video_seconds(s["video_seconds"])
+
+
+def generation_kwargs(s: dict) -> dict:
+    """settings_store-style dict -> processor.run_generation keyword arguments."""
+    return dict(
+        multi_image_mode=s["multi_image_mode"],
+        remove_bg=bool(s["remove_bg"]),
+        seed=int(s["seed"]),
+        simplify=float(s["simplify"]),
+        texture_size=int(s["texture_size"]),
+        texture_mode=check_texture_mode(s["texture_mode"]),
+        sparse_structure_sampler_params={"steps": int(s["ss_steps"]), "cfg_strength": float(s["ss_cfg"])},
+        slat_sampler_params={"steps": int(s["slat_steps"]), "cfg_strength": float(s["slat_cfg"])},
+        target_size_mm=float(s["target_size_mm"] or 0),
+        size_axis=s["size_axis"],
+        target_faces=int(s["target_faces"] or 0),
+        quad_faces=int(s["quad_faces"] or 0) if s["export_quads"] else 0,
+        flatten=bool(s["flatten"]),
+        cut_mm=float(s["cut_mm"] or 0),
+        bg_model=check_bg_model(s["bg_model"]),
+        clean_mask=bool(s["clean_mask"]),
+        remove_enclosed=bool(s["remove_enclosed"]),
+        bg_tolerance=check_tolerance(s["bg_tolerance"]),
+        render_video=bool(s["render_video"]),
+        video_seconds=float(s["video_seconds"] or 12),
+    )
+
+
+def oom_context(s: dict, n_images: int = 1) -> dict:
+    return dict(texture_mode=s.get("texture_mode"), texture_size=s.get("texture_size"),
+                render_video=s.get("render_video"), n_images=n_images,
+                multi_image_mode=s.get("multi_image_mode"))
+
+
+class GenerationJob:
+    def __init__(self, images: list, settings: dict, name: Optional[str] = None, save: bool = True,
+                 output_dir: str = "", kind: str = "single", source_names: Optional[List[str]] = None,
+                 log: Callable = print):
+        self.images = images
+        self.settings = dict(settings)
+        self.result: Optional[RunResult] = None
+        self.run: Optional[history.Run] = None
+        self.history_note = ""
+        self.files: dict = {}
+        self.console: List[str] = []
+        if save:
+            try:
+                self.run = history.Run(history.output_root(output_dir), name, kind=kind)
+                self.run.save_inputs(images, source_names)
+            except OSError as e:
+                self.run = None
+                self.history_note = f"WARNING: could not save this run to the outputs folder ({e})."
+                log(f"[history] {self.history_note}")
+
+    @property
+    def folder(self) -> Optional[str]:
+        return str(self.run.folder) if self.run else None
+
+    def _fail(self, e: BaseException, action: str) -> None:
+        if self.run is None:
+            return
+        status = "cancelled" if isinstance(e, Cancelled) else "failed"
+        try:
+            self.run.finish(status, self.settings, info=self.result.full_info if self.result else "",
+                            console="\n".join(self.console),
+                            error=friendly_message(e, action, oom_context(self.settings, len(self.images))))
+        except OSError:
+            pass
+
+    def generate(self, selections=None, progress: Optional[Callable] = None,
+                 should_stop: Optional[Callable[[], bool]] = None) -> RunResult:
+        with history.capture_console() as cap:
+            try:
+                self.result = run_generation(
+                    self.images if len(self.images) > 1 else self.images[0],
+                    selections=selections, progress=progress, should_stop=should_stop,
+                    **generation_kwargs(self.settings),
+                )
+            except BaseException as e:
+                self.console.append(cap.text())
+                self._fail(e, "Generation")
+                raise
+            finally:
+                free_cuda()
+            self.console.append(cap.text())
+        if self.run is not None:
+            try:
+                self.run.save_processed(self.result.processed)
+                self.files = self.run.add_exports(self.result.paths, self.result.raw_path)
+            except OSError as e:
+                self.history_note = f"WARNING: could not save this run to the outputs folder ({e})."
+        return self.result
+
+    def info(self, pending_video: bool = False) -> str:
+        r = self.result
+        text = r.info + "\n360° preview video: rendering ... (the downloads above are ready)" if pending_video \
+            else r.full_info
+        if self.run is not None and not self.history_note:
+            text += f"\nSaved to: {self.run.folder}"
+        if self.history_note:
+            text += "\n" + self.history_note
+        return text
+
+    def render_video(self, progress: Optional[Callable] = None,
+                     should_stop: Optional[Callable[[], bool]] = None) -> Optional[str]:
+        if self.result is None or self.result.video_job is None:
+            return None
+        with history.capture_console() as cap:
+            try:
+                path = finish_video(self.result, progress, should_stop=should_stop)
+            finally:
+                self.console.append(cap.text())
+        if self.run is not None and path:
+            try:
+                self.files["video"] = self.run.add_video(path)
+            except OSError as e:
+                self.history_note = f"WARNING: could not copy the video to the outputs folder ({e})."
+        return path
+
+    def finish(self) -> None:
+        if self.run is not None:
+            try:
+                self.run.finish("ok", self.settings, info=self.result.full_info, console="\n".join(self.console))
+            except OSError as e:
+                self.history_note = f"WARNING: could not write settings.json/log.txt ({e})."
