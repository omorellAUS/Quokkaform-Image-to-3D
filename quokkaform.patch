+"""
+Batch mode: many photos (or a folder), one model each, with the current settings.
+
+    b = Batch(paths, settings, output_dir)
+    b.run()          # sequential; call from a worker thread, b.cancel() from anywhere
+
+Each photo is a normal single-image GenerationJob, so it is saved to the
+output history like any other run (kind "batch"), and uses Auto-select if
+that setting is on. A failing photo is recorded (friendly message in the
+table and in its run folder) and the batch carries on. Cancel stops at the
+next stage boundary (TRELLIS cannot be interrupted inside a sampling stage)
+or between video chunks; the photo being worked on is recorded as
+cancelled and the rest are skipped. Between photos everything except the
+TRELLIS weights is released (CUDA cache, SAM 2, background model).
+"""
+
+import os
+import threading
+import time
+from pathlib import Path
+from typing import Callable, Iterable, List, Optional, Tuple
+
+from PIL import Image, ImageOps
+
+from . import background, selection
+from .errors import check_image, classify, friendly_message
+from .jobs import GenerationJob, oom_context
+from .runtime import Cancelled, free_cuda
+
+IMAGE_EXTS = (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff")
+MAX_ITEMS = 500
+
+_active_lock = threading.Lock()
+_active: Optional["Batch"] = None
+
+
+def active() -> Optional["Batch"]:
+    """The batch that is running now (None if none)."""
+    b = _active
+    return b if b is not None and b.running else None
+
+
+def collect(files: Iterable = (), folder: str = "", recursive: bool = False) -> Tuple[List[str], List[str]]:
+    """Uploaded files + image files in a folder -> (paths, notes). Duplicates
+    (same path) are dropped; order: uploads first, then the folder sorted by name."""
+    paths, notes, seen = [], [], set()
+
+    def add(p: str):
+        key = os.path.normcase(os.path.abspath(p))
+        if key not in seen:
+            seen.add(key)
+            paths.append(p)
+
+    for f in files or []:
+        p = getattr(f, "name", None) or getattr(f, "path", None) or (f.get("path") if isinstance(f, dict) else f)
+        if p:
+            add(str(p))
+    folder = (folder or "").strip().strip('"')
+    if folder:
+        d = Path(os.path.expandvars(os.path.expanduser(folder)))
+        if not d.is_dir():
+            notes.append(f"Folder not found: {d}")
+        else:
+            it = d.rglob("*") if recursive else d.iterdir()
+            found = sorted((p for p in it if p.is_file() and p.suffix.lower() in IMAGE_EXTS),
+                           key=lambda p: str(p).lower())
+            if not found:
+                notes.append(f"No images ({', '.join(IMAGE_EXTS)}) in {d}")
+            for p in found:
+                add(str(p))
+    if len(paths) > MAX_ITEMS:
+        notes.append(f"{len(paths)} photos found; only the first {MAX_ITEMS} are queued.")
+        paths = paths[:MAX_ITEMS]
+    return paths, notes
+
+
+def _open(path: str) -> Image.Image:
+    with Image.open(path) as im:
+        im = ImageOps.exif_transpose(im)  # phone photos: apply the EXIF rotation
+        im.load()
+        im = im.copy()
+    if im.mode not in ("RGB", "RGBA"):
+        im = im.convert("RGBA" if "transparency" in im.info or im.mode in ("LA", "PA", "P") else "RGB")
+    check_image(im, f"'{os.path.basename(path)}'")
+    return im
+
+
+class Batch:
+    def __init__(self, paths: List[str], settings: dict, output_dir: str = "", log: Callable = print):
+        self.settings = dict(settings)
+        self.output_dir = output_dir or ""
+        self.log = log
+        self.items = [
+            {"name": os.path.basename(p), "path": p, "status": "queued", "seconds": None, "folder": None,
+             "message": ""}
+            for p in paths
