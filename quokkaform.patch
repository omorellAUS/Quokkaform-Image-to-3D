+"""
+Download every model the app needs up front, with progress and sizes.
+
+    python -m app.download_models            # download what is missing
+    python -m app.download_models --check    # only report (exit code 1 if something is missing)
+    python -m app.download_models --only sam2,birefnet
+    start.bat --download-models              # same as the first line, from Windows
+
+Without this, each model downloads silently the first time it is used
+(about 4.3 GB in total, TRELLIS alone 2.8 GB), which makes the first
+generation look stuck. The installer runs it after installing packages.
+
+Models and where they are stored:
+- TRELLIS-image-large (microsoft, MIT): Hugging Face cache (HF_HOME,
+  default ~/.cache/huggingface).
+- DINOv2 ViT-L/14 with registers (Meta, Apache-2.0), TRELLIS's image
+  encoder: torch hub cache (TORCH_HOME, default ~/.cache/torch/hub).
+- BiRefNet lite (MIT), default background model: ~/.u2net (U2NET_HOME).
+- SAM 2.1 Hiera-Small (Meta, Apache-2.0), Select object: Hugging Face cache.
+
+Downloads go to a temporary name first and are renamed when complete, so
+an interrupted download never leaves a file that looks finished; run this
+again to continue.
+"""
+
+import argparse
+import os
+import sys
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Callable, List, Optional
+
+MB = 1024 ** 2
+
+TRELLIS_REPO = "microsoft/TRELLIS-image-large"
+TRELLIS_MODELS = [  # the checkpoints pipeline.json loads (slat_enc / ss_enc are not needed)
+    "ckpts/ss_dec_conv3d_16l8_fp16",
+    "ckpts/ss_flow_img_dit_L_16l8_fp16",
+    "ckpts/slat_dec_gs_swin8_B_64l8gs32_fp16",
+    "ckpts/slat_dec_rf_swin8_B_64l8r16_fp16",
+    "ckpts/slat_dec_mesh_swin8_B_64l8m256c_fp16",
+    "ckpts/slat_flow_img_dit_L_64l8p2_fp16",
+]
+TRELLIS_FILES = ["pipeline.json"] + [f"{m}{ext}" for m in TRELLIS_MODELS for ext in (".json", ".safetensors")]
+DINO_REPO = "facebookresearch/dinov2"
+DINO_URL = "https://dl.fbaipublicfiles.com/dinov2/dinov2_vitl14/dinov2_vitl14_reg4_pretrain.pth"
+SAM_REPO = "facebook/sam2.1-hiera-small"
+SAM_FILE = "sam2.1_hiera_small.pt"
+BIREFNET = "birefnet-general-lite"
+
+
+@dataclass
+class ModelSpec:
+    key: str
+    label: str
+    size_mb: float          # download size
+    licence: str
+    used_for: str
+
+
+MODELS = [
+    ModelSpec("trellis", "TRELLIS-image-large", 2868, "MIT", "3D generation"),
+    ModelSpec("dinov2", "DINOv2 ViT-L/14 (registers)", 1161, "Apache-2.0", "image encoder inside TRELLIS"),
+    ModelSpec("birefnet", "BiRefNet lite", 214, "MIT", "background removal (default model)"),
+    ModelSpec("sam2", "SAM 2.1 Small", 176, "Apache-2.0", "Select object / Auto-select"),
+]
+SPECS = {m.key: m for m in MODELS}
+
+
+# ---------------------------------------------------------------- locations
+
+def _hf_cached(repo: str, filename: str) -> Optional[str]:
+    try:
+        from huggingface_hub import try_to_load_from_cache
+    except ImportError:
+        return None
+    p = try_to_load_from_cache(repo, filename)
+    return p if isinstance(p, str) and os.path.isfile(p) else None
+
+
+def torch_hub_dir() -> Path:
+    try:
+        import torch
+
+        return Path(torch.hub.get_dir())
+    except ImportError:
+        home = os.environ.get("TORCH_HOME") or os.path.join(
+            os.environ.get("XDG_CACHE_HOME", os.path.join(os.path.expanduser("~"), ".cache")), "torch")
+        return Path(home) / "hub"
+
+
+def dino_paths():
+    hub = torch_hub_dir()
+    return hub / "facebookresearch_dinov2_main", hub / "checkpoints" / os.path.basename(DINO_URL)
+
+
+def u2net_home() -> Path:
+    return Path(os.path.expanduser(os.getenv("U2NET_HOME", os.path.join(os.getenv("XDG_DATA_HOME", "~"), ".u2net"))))
+
+
+def hf_cache_dir() -> Path:
+    try:
+        from huggingface_hub import constants
+
+        return Path(constants.HF_HUB_CACHE)
+    except ImportError:
+        return Path(os.path.expanduser("~/.cache/huggingface/hub"))
+
+
+def files_for(key: str) -> List[Optional[str]]:
+    """Paths of the model's files (None = missing)."""
+    if key == "trellis":
+        return [_hf_cached(TRELLIS_REPO, f) for f in TRELLIS_FILES]
+    if key == "dinov2":
+        repo, ckpt = dino_paths()
+        return [str(repo / "hubconf.py") if (repo / "hubconf.py").is_file() else None,
+                str(ckpt) if ckpt.is_file() else None]
+    if key == "birefnet":
+        p = u2net_home() / f"{BIREFNET}.onnx"
+        # rembg's file is 224,005,088 bytes; a much smaller one is broken
+        return [str(p) if p.is_file() and p.stat().st_size > 200 * MB else None]
+    if key == "sam2":
+        return [_hf_cached(SAM_REPO, SAM_FILE)]
+    raise KeyError(key)
+
+
+def location(key: str) -> str:
+    return {"trellis": str(hf_cache_dir()), "sam2": str(hf_cache_dir()),
+            "dinov2": str(torch_hub_dir()), "birefnet": str(u2net_home())}[key]
+
+
+def status() -> List[dict]:
+    """One row per model: key, label, present, size on disk (MB), expected download (MB)."""
+    rows = []
+    for m in MODELS:
+        files = files_for(m.key)
+        have = [f for f in files if f]
+        rows.append(dict(
+            key=m.key, label=m.label, used_for=m.used_for, licence=m.licence,
+            present=len(have) == len(files), files_present=len(have), files_total=len(files),
+            disk_mb=sum(os.path.getsize(f) for f in have) / MB, size_mb=m.size_mb, location=location(m.key),
+        ))
+    return rows
+
+
+def missing_mb(rows: Optional[List[dict]] = None) -> float:
+    rows = status() if rows is None else rows
+    return sum(r["size_mb"] for r in rows if not r["present"])
+
+
+def status_markdown(rows: Optional[List[dict]] = None) -> str:
+    rows = status() if rows is None else rows
+    lines = ["| Model | Used for | Licence | Status | Size |", "|---|---|---|---|---|"]
+    for r in rows:
+        if r["present"]:
+            st, size = "✅ downloaded", f"{r['disk_mb']:,.0f} MB"
+        elif r["files_present"]:
+            st, size = f"⚠️ incomplete ({r['files_present']}/{r['files_total']} files)", f"~{r['size_mb']:,.0f} MB"
+        else:
+            st, size = "⬇️ not downloaded", f"~{r['size_mb']:,.0f} MB"
+        lines.append(f"| {r['label']} | {r['used_for']} | {r['licence']} | {st} | {size} |")
+    miss = missing_mb(rows)
+    lines.append("")
+    lines.append(f"**Still to download: about {miss / 1024:.1f} GB.**" if miss else "**All models are downloaded.**")
+    return "\n".join(lines)
+
+
+# ---------------------------------------------------------------- downloads
+
+def _download_trellis(log):
+    from huggingface_hub import hf_hub_download
+
+    for f in TRELLIS_FILES:
+        if _hf_cached(TRELLIS_REPO, f):
+            continue
+        log(f"  {TRELLIS_REPO}/{f}")
+        hf_hub_download(TRELLIS_REPO, f)
+
+
+def _download_dino(log):
+    import torch
+
+    repo, ckpt = dino_paths()
+    if not (repo / "hubconf.py").is_file():
+        log(f"  {DINO_REPO} (code, from GitHub)")
+        torch.hub.list(DINO_REPO, trust_repo=True)
+    if not ckpt.is_file():
+        log(f"  {DINO_URL}")
+        ckpt.parent.mkdir(parents=True, exist_ok=True)
+        torch.hub.download_url_to_file(DINO_URL, str(ckpt), progress=True)
+
+
+def _download_birefnet(log):
+    from rembg.sessions import sessions_class
+
+    cls = next(c for c in sessions_class if c.name() == BIREFNET)
+    log(f"  {BIREFNET}.onnx -> {u2net_home()}")
+    p = u2net_home() / f"{BIREFNET}.onnx"
+    if p.is_file() and p.stat().st_size < 200 * MB:
+        p.unlink()  # broken leftover: download again
+    cls.download_models()
+
+
+def _download_sam(log):
+    from huggingface_hub import hf_hub_download
+
+    log(f"  {SAM_REPO}/{SAM_FILE}")
+    hf_hub_download(SAM_REPO, SAM_FILE)
+
+
+DOWNLOADERS = {"trellis": _download_trellis, "dinov2": _download_dino,
+               "birefnet": _download_birefnet, "sam2": _download_sam}
+
+
+def download(keys: Optional[List[str]] = None, log: Callable = print,
+             progress: Optional[Callable] = None) -> List[dict]:
+    """Download the missing models (all, or `keys`). Never raises for one
+    model's failure: returns one result per model with ok / error text."""
+    from app.backend.errors import friendly_message
+
+    keys = list(keys or SPECS)
+    unknown = [k for k in keys if k not in SPECS]
+    if unknown:
+        raise ValueError(f"Unknown model(s): {', '.join(unknown)}. Use: {', '.join(SPECS)}")
+    results = []
+    for i, key in enumerate(keys):
+        spec = SPECS[key]
+        if progress is not None:
+            progress(i / len(keys), f"{spec.label} ({i + 1}/{len(keys)})")
+        if all(files_for(key)):
+            results.append(dict(key=key, label=spec.label, ok=True, skipped=True, seconds=0.0, error=None))
+            log(f"[models] {spec.label}: already downloaded")
+            continue
+        log(f"[models] Downloading {spec.label} (~{spec.size_mb:,.0f} MB) ...")
+        t0 = time.perf_counter()
+        try:
+            DOWNLOADERS[key](log)
+            ok = all(files_for(key))
+            err = None if ok else "some files are still missing after the download"
+        except KeyboardInterrupt:
+            raise
+        except Exception as e:  # keep going with the other models
+            ok, err = False, friendly_message(e, f"Download of {spec.label}")
+        dt = time.perf_counter() - t0
+        results.append(dict(key=key, label=spec.label, ok=ok, skipped=False, seconds=dt, error=err))
+        log(f"[models] {spec.label}: {'done' if ok else 'FAILED'} in {dt:.0f} s" + (f" - {err}" if err else ""))
+    if progress is not None:
+        progress(1.0, "Models checked")
+    return results
+
+
+def results_markdown(results: List[dict]) -> str:
+    lines = []
+    for r in results:
+        if r["ok"]:
+            lines.append(f"- ✅ {r['label']}: " + ("already downloaded" if r["skipped"] else f"downloaded in {r['seconds']:.0f} s"))
+        else:
+            lines.append(f"- ❌ {r['label']}: {r['error']}")
+    if any(not r["ok"] for r in results):
+        lines.append("\nSome downloads failed. Check the internet connection and press the button again "
+                     "(finished files are kept).")
+    return "\n".join(lines)
+
+
+def _print_table(rows):
+    w = max(len(r["label"]) for r in rows)
+    for r in rows:
+        st = "OK      " if r["present"] else ("PARTIAL " if r["files_present"] else "MISSING ")
+        size = f"{r['disk_mb']:8,.0f} MB on disk" if r["present"] else f"~{r['size_mb']:7,.0f} MB to download"
+        print(f"  {st}{r['label']:<{w}}  {size}  ({r['location']})")
+    miss = missing_mb(rows)
+    total = sum(r["disk_mb"] for r in rows if r["present"])
+    print(f"  Total on disk: {total / 1024:.2f} GB" + (f"; still to download: ~{miss / 1024:.1f} GB" if miss else ""))
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="python -m app.download_models", description=__doc__.split("\n\n")[0])
+    ap.add_argument("--check", action="store_true", help="only report what is downloaded (exit 1 if anything is missing)")
+    ap.add_argument("--only", default="", help=f"comma-separated subset of: {','.join(SPECS)}")
+    args = ap.parse_args(argv)
+    keys = [k.strip() for k in args.only.split(",") if k.strip()] or list(SPECS)
+    print("Free Image-to-3D: models")
+    rows = [r for r in status() if r["key"] in keys]
+    _print_table(rows)
+    if args.check:
+        return 0 if all(r["present"] for r in rows) else 1
+    if all(r["present"] for r in rows):
+        print("Nothing to download.")
+        return 0
+    print()
+    results = download(keys)
+    print()
+    rows = [r for r in status() if r["key"] in keys]
+    _print_table(rows)
+    failed = [r for r in results if not r["ok"]]
+    if failed:
+        print("\nFAILED: " + "; ".join(f"{r['label']}: {r['error']}" for r in failed))
+        print("Run the same command again to retry (finished files are kept).")
+        return 1
+    print("\nAll models are ready.")
+    return 0
+
+
+if __name__ == "__main__":
+    # Allow "python app/download_models.py" as well as "python -m app.download_models".
+    root = str(Path(__file__).resolve().parent.parent)
+    if root not in sys.path:
+        sys.path.insert(0, root)
+    sys.exit(main())
