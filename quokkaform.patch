@@ -0,0 +1,333 @@
+"""
+Output history: every run is saved to its own folder.
+
+    <outputs>/<YYYY-MM-DD_HH-MM-SS>_<name>/
+        input_1.png ...        the photo(s) as uploaded
+        processed_1.png ...    what TRELLIS got (cut-out, framed)
+        thumb.png              small preview for the History tab
+        model.glb / .obj / .stl / .ply / model_quads.obj (+ OBJ material files)
+        raw.glb                the raw TRELLIS mesh (Re-export works from History)
+        turntable.mp4          360° video (if rendered)
+        settings.json          every setting + status, timings, app/model info
+        log.txt                the Export info text and the console output of the run
+
+<outputs> defaults to Documents/Image-to-3D/outputs (the Windows Documents
+folder, also when it is moved to OneDrive), IMG3D_OUTPUT_DIR or the
+'Outputs folder' setting override it.
+"""
+
+import datetime as _dt
+import io
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+from pathlib import Path
+from typing import Dict, Iterable, List, Optional
+
+from PIL import Image
+
+APP_VERSION = "0.3-polish"
+MESH_KEYS = ("glb", "obj", "stl", "ply", "quad_obj")
+
+
+# ------------------------------------------------------------------ folders
+
+def documents_dir() -> Path:
+    """The user's Documents folder (Windows known folder, else ~/Documents)."""
+    if sys.platform.startswith("win"):
+        try:
+            import ctypes
+            from ctypes import wintypes
+
+            class GUID(ctypes.Structure):
+                _fields_ = [("Data1", wintypes.DWORD), ("Data2", wintypes.WORD),
+                            ("Data3", wintypes.WORD), ("Data4", wintypes.BYTE * 8)]
+
+            # FOLDERID_Documents {FDD39AD0-238F-46AF-ADB4-6C85480369C7}
+            fid = GUID(0xFDD39AD0, 0x238F, 0x46AF, (wintypes.BYTE * 8)(0xAD, 0xB4, 0x6C, 0x85, 0x48, 0x03, 0x69, 0xC7))
+            ptr = ctypes.c_wchar_p()
+            if ctypes.windll.shell32.SHGetKnownFolderPath(ctypes.byref(fid), 0, None, ctypes.byref(ptr)) == 0:
+                path = ptr.value
+                ctypes.windll.ole32.CoTaskMemFree(ptr)
+                if path:
+                    return Path(path)
+        except Exception:
+            pass
+    return Path.home() / "Documents"
+
+
+def default_output_root() -> Path:
+    env = os.environ.get("IMG3D_OUTPUT_DIR")
+    return Path(env) if env else documents_dir() / "Image-to-3D" / "outputs"
+
+
+def output_root(configured: Optional[str] = None) -> Path:
+    configured = (configured or "").strip().strip('"')
+    return Path(os.path.expandvars(os.path.expanduser(configured))) if configured else default_output_root()
+
+
+def slug(name: Optional[str], default: str = "model") -> str:
+    """Safe, short folder-name part from a run name or file name."""
+    s = Path(str(name or "")).stem if name and Path(str(name)).suffix.lower() in (
+        ".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tif", ".tiff") else str(name or "")
+    s = re.sub(r"[^A-Za-z0-9._-]+", "-", s).strip("-._")[:40]
+    return s or default
+
+
+# ------------------------------------------------------------------ console capture
+
+class _Tee(io.TextIOBase):
+    """sys.stdout/err replacement: writes go to the console and to the
+    capture buffer of the current thread, if any (runs on other threads are
+    not mixed into each other's logs)."""
+
+    def __init__(self, stream):
+        self._stream = stream
+        self._local = threading.local()
+
+    def write(self, s):
+        buf = getattr(self._local, "buf", None)
+        if buf is not None:
+            buf.append(s)
+        return self._stream.write(s)
+
+    def flush(self):
+        self._stream.flush()
+
+    def isatty(self):
+        return getattr(self._stream, "isatty", lambda: False)()
+
+    @property
+    def encoding(self):
+        return getattr(self._stream, "encoding", "utf-8")
+
+    def fileno(self):
+        return self._stream.fileno()
+
+
+_tee_lock = threading.Lock()
+
+
+def _install_tee():
+    with _tee_lock:
+        if not isinstance(sys.stdout, _Tee):
+            sys.stdout = _Tee(sys.stdout)
+        if not isinstance(sys.stderr, _Tee):
+            sys.stderr = _Tee(sys.stderr)
+
+
+class capture_console:
+    """with capture_console() as cap: ...; cap.text() -> console output of this thread."""
+
+    def __enter__(self):
+        _install_tee()
+        self.parts: List[str] = []
+        self._prev = [getattr(s._local, "buf", None) for s in (sys.stdout, sys.stderr)]
+        for s in (sys.stdout, sys.stderr):
+            s._local.buf = self.parts
+        return self
+
+    def __exit__(self, *exc):
+        for s, prev in zip((sys.stdout, sys.stderr), self._prev):
+            s._local.buf = prev
+        return False
+
+    def text(self) -> str:
+        raw = "".join(self.parts)
+        # progress bars rewrite their line with \r: keep the last state only
+        return "\n".join(line.split("\r")[-1] for line in raw.splitlines())
+
+
+# ------------------------------------------------------------------ one run
+
+class Run:
+    """A run folder that is filled step by step (inputs, meshes, video, log)."""
+
+    def __init__(self, root: Path, name: Optional[str] = None, kind: str = "single", now=None):
+        now = now or _dt.datetime.now()
+        root = Path(root)
+        root.mkdir(parents=True, exist_ok=True)
+        base = f"{now:%Y-%m-%d_%H-%M-%S}_{slug(name)}"
+        folder, i = root / base, 2
+        while folder.exists():
+            folder, i = root / f"{base}-{i}", i + 1
+        folder.mkdir()
+        self.folder = folder
+        self.meta: Dict = {"name": name or "", "kind": kind, "created": now.isoformat(timespec="seconds"),
+                           "status": "running", "app_version": APP_VERSION, "inputs": [], "files": {}}
+
+    # inputs ---------------------------------------------------------
+    def save_inputs(self, images: Iterable[Image.Image], names: Optional[List[str]] = None) -> None:
+        for i, im in enumerate(images, 1):
+            fn = f"input_{i}.png"
+            im.save(self.folder / fn)
+            source = names[i - 1] if names and i <= len(names) else None
+            self.meta["inputs"].append({"file": fn, "source": source, "size": list(im.size)})
+
+    def save_processed(self, images: Iterable[Image.Image]) -> None:
+        images = list(images)
+        for i, im in enumerate(images, 1):
+            im.save(self.folder / f"processed_{i}.png")
+        if images:
+            th = images[0].convert("RGB").copy()
+            th.thumbnail((256, 256))
+            th.save(self.folder / "thumb.png")
+
+    # outputs --------------------------------------------------------
+    def add_exports(self, paths: Dict[str, str], raw_path: Optional[str] = None) -> Dict[str, str]:
+        """Copy the export folder(s) (incl. OBJ material files) and raw mesh in;
+        returns {key: path in the run folder}."""
+        out = {}
+        for d in {os.path.dirname(p) for k, p in paths.items() if k in MESH_KEYS and p}:
+            for f in os.listdir(d):
+                src = os.path.join(d, f)
+                if os.path.isfile(src):
+                    shutil.copy2(src, self.folder / f)
+        for k in MESH_KEYS:
+            if paths.get(k):
+                out[k] = str(self.folder / os.path.basename(paths[k]))
+        if raw_path and os.path.isfile(raw_path):
+            shutil.copy2(raw_path, self.folder / "raw.glb")
+            out["raw"] = str(self.folder / "raw.glb")
+        self.meta["files"].update({k: os.path.basename(v) for k, v in out.items()})
+        return out
+
+    def add_video(self, path: Optional[str]) -> Optional[str]:
+        if not path or not os.path.isfile(path):
+            return None
+        dst = self.folder / "turntable.mp4"
+        shutil.copy2(path, dst)
+        self.meta["files"]["video"] = dst.name
+        return str(dst)
+
+    def add_reexport(self, paths: Dict[str, str], now=None) -> Path:
+        return save_reexport(self.folder, paths, now)
+
+    # finish ---------------------------------------------------------
+    def finish(self, status: str, settings: Optional[dict] = None, info: str = "", console: str = "",
+               error: Optional[str] = None, extra: Optional[dict] = None) -> None:
+        self.meta.update(status=status, finished=_dt.datetime.now().isoformat(timespec="seconds"))
+        if error:
+            self.meta["error"] = error
+        if settings is not None:
+            self.meta["settings"] = settings
+        if extra:
+            self.meta.update(extra)
+        (self.folder / "settings.json").write_text(json.dumps(self.meta, indent=2, default=str), encoding="utf-8")
+        log = [f"Free Image-to-3D {APP_VERSION} - {self.meta['created']} - status: {status}"]
+        if error:
+            log += ["", "ERROR: " + error]
+        if info:
+            log += ["", "=== Export info ===", info]
+        if console:
+            log += ["", "=== Console ===", console]
+        (self.folder / "log.txt").write_text("\n".join(log) + "\n", encoding="utf-8")
+
+
+def save_reexport(folder, paths: Dict[str, str], now=None) -> Path:
+    """Copy a re-export into <run folder>/reexport_<time>/ (the original files stay)."""
+    now = now or _dt.datetime.now()
+    base = Path(folder) / f"reexport_{now:%H-%M-%S}"
+    sub, i = base, 2
+    while sub.exists():
+        sub, i = Path(f"{base}-{i}"), i + 1
+    sub.mkdir()
+    for d in {os.path.dirname(p) for k, p in paths.items() if k in MESH_KEYS and p}:
+        for f in os.listdir(d):
+            if os.path.isfile(os.path.join(d, f)):
+                shutil.copy2(os.path.join(d, f), sub / f)
+    return sub
+
+
+# ------------------------------------------------------------------ browsing
+
+def list_runs(root: Path, limit: int = 200) -> List[dict]:
+    """Newest first: folder, name, created, status, thumb, files."""
+    root = Path(root)
+    if not root.is_dir():
+        return []
+    runs = []
+    for d in sorted((p for p in root.iterdir() if p.is_dir()), key=lambda p: p.name, reverse=True)[:limit]:
+        meta_path = d / "settings.json"
+        meta = {}
+        if meta_path.is_file():
+            try:
+                meta = json.loads(meta_path.read_text(encoding="utf-8"))
+            except (OSError, ValueError):
+                meta = {}
+        elif not any(d.glob("input_*.png")):
+            continue  # not a run folder
+        thumb = d / "thumb.png"
+        if not thumb.is_file():
+            thumb = next(iter(sorted(d.glob("input_*.png"))), None)
+        runs.append(dict(folder=str(d), name=meta.get("name") or d.name.split("_", 2)[-1],
+                         created=meta.get("created", ""), status=meta.get("status", "unknown"),
+                         thumb=str(thumb) if thumb else None, files=meta.get("files", {}),
+                         error=meta.get("error")))
+    return runs
+
+
+def run_caption(r: dict) -> str:
+    when = r["created"].replace("T", " ")[:16] if r["created"] else ""
+    mark = {"ok": "", "failed": " (failed)", "cancelled": " (cancelled)", "running": " (unfinished)"}.get(
+        r["status"], f" ({r['status']})")
+    return f"{r['name']} - {when}{mark}"
+
+
+def load_run(folder: str) -> dict:
+    """Files of a run, copied to a fresh temp folder (the UI may only serve
+    files from temp/cwd), plus processed images, info text and settings."""
+    d = Path(folder)
+    if not (d / "settings.json").is_file() and not any(d.glob("input_*.png")):
+        raise FileNotFoundError(f"Not a run folder: {folder}")
+    meta = {}
+    try:
+        meta = json.loads((d / "settings.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        pass
+    tmp = Path(tempfile.mkdtemp(prefix="history_"))
+    paths = {}
+    names = {"glb": "model.glb", "obj": "model.obj", "stl": "model.stl", "ply": "model.ply",
+             "quad_obj": "model_quads.obj", "video": "turntable.mp4", "raw": "raw.glb"}
+    for f in d.iterdir():
+        if f.is_file() and f.suffix.lower() not in (".json", ".txt"):
+            shutil.copy2(f, tmp / f.name)
+    for k, fn in names.items():
+        if (tmp / fn).is_file():
+            paths[k] = str(tmp / fn)
+    processed = [Image.open(p).copy() for p in sorted(d.glob("processed_*.png"))]
+    if not processed:
+        processed = [Image.open(p).copy() for p in sorted(d.glob("input_*.png"))]
+    info = ""
+    log = d / "log.txt"
+    if log.is_file():
+        text = log.read_text(encoding="utf-8", errors="replace")
+        if "=== Export info ===" in text:
+            info = text.split("=== Export info ===", 1)[1].split("=== Console ===", 1)[0].strip()
+        elif "ERROR:" in text:
+            info = text.split("ERROR:", 1)[1].split("\n\n", 1)[0].strip()
+    return dict(folder=str(d), paths=paths, processed=processed, info=info, meta=meta)
+
+
+def open_folder(path: str) -> str:
+    """Open a folder in the file manager (on the PC running the app)."""
+    p = Path(path)
+    if not p.is_dir():
+        return f"Folder not found: {p}"
+    try:
+        if sys.platform.startswith("win"):
+            os.startfile(str(p))  # noqa: S606 - local desktop app
+        elif sys.platform == "darwin":
+            subprocess.Popen(["open", str(p)])
+        else:
+            if not shutil.which("xdg-open"):
+                return f"No file manager available here; the folder is {p}"
+            subprocess.Popen(["xdg-open", str(p)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    except OSError as e:
+        return f"Could not open the folder ({e}); it is {p}"
+    return f"Opened {p}"
