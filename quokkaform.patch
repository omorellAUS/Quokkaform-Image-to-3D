+class TurntableJob:
+    """A 360° video rendered AFTER the meshes have been exported.
+
+    generate_trellis_mesh() captures the decoded mesh and Gaussians into
+    system RAM (capture_*), so neither holds VRAM during hole filling and
+    texture baking; render() moves them back to the GPU, renders the
+    turntable (render_turntable: VRAM check, probe, time cap) and drops
+    them again whatever happens.
+    """
+
+    def __init__(self, video_path: str, seconds: float = VIDEO_SECONDS):
+        self.video_path = video_path
+        self.seconds = check_video_seconds(seconds)
+        self.mesh = None
+        self.gaussian = None
+        self.notes: list = []
+
+    @property
+    def ready(self) -> bool:
+        return self.mesh is not None
+
+    def capture_mesh(self, mesh_result):
+        self.mesh = to_device(mesh_result, "cpu")
+        return self.mesh
+
+    def capture_gaussian(self, gaussian):
+        self.gaussian = to_device(gaussian, "cpu")
+
+    def discard(self) -> None:
+        self.mesh = self.gaussian = None
+
+    def render(self, notes: Optional[list] = None, time_cap: Optional[float] = None, should_stop=None) -> bool:
+        notes = self.notes if notes is None else notes
+        if not self.ready:
+            notes.append("360° video: nothing to render (generation did not finish).")
+            return False
+        device = "cuda" if torch.cuda.is_available() else "cpu"
+        mesh, gaussian = self.mesh, self.gaussian
+        self.discard()
+        try:
+            to_device(mesh, device)
+            to_device(gaussian, device)
+            return render_turntable(mesh, gaussian, self.video_path, notes, time_cap=time_cap,
+                                    seconds=self.seconds, should_stop=should_stop)
+        except Exception as e:  # the mesh is still worth having
+            print(f"WARNING: 360° preview video failed: {type(e).__name__}: {e}", flush=True)
+            notes.append(f"360° video failed: {type(e).__name__}: {e}")
+            if os.path.exists(self.video_path):
+                os.remove(self.video_path)
+            return False
+        finally:
+            mesh = gaussian = None
+            free_cuda()
+
