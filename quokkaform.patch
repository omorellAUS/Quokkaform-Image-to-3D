+# --------------------------------------------------------------------------
+# Auto-select: SAM 2 prompts seeded from the automatic (BiRefNet) mask.
+#
+# The typical failure of automatic background removal on hand-held objects
+# (shoe lasts, tools) is that the hand and sleeve are kept as "foreground".
+# Auto-select finds the object in the BiRefNet mask, places Keep points on
+# it and Remove points on skin-coloured parts and on other blobs that come
+# in from the photo edge (hand, arm, sleeve), and lets SAM 2 cut the object.
+# If nothing needs removing, or SAM's answer does not look like the object
+# BiRefNet found, it returns None and the photo keeps automatic removal.
+# --------------------------------------------------------------------------
+
+
+def _skin(rgb: np.ndarray) -> np.ndarray:
+    """Skin-coloured pixels (YCrCb rule, robust to lighting)."""
+    ycc = np.asarray(Image.fromarray(rgb).convert("YCbCr")).astype(np.int16)
+    y, cb, cr = ycc[..., 0], ycc[..., 1], ycc[..., 2]
+    return (cr >= 136) & (cr <= 175) & (cb >= 80) & (cb <= 128) & (y > 40)
+
+
+def _touches_border(region: np.ndarray, margin: int = 3) -> bool:
+    return bool(
+        region[:margin].any() or region[-margin:].any()
+        or region[:, :margin].any() or region[:, -margin:].any()
+    )
+
+
+def _peaks(region: np.ndarray, n: int, min_sep: float) -> List[Tuple[float, float]]:
+    """Up to n well-separated interior points (distance-transform maxima)."""
+    from scipy import ndimage
+
+    dist = ndimage.distance_transform_edt(region)
+    h, w = region.shape
+    yy, xx = np.mgrid[0:h, 0:w]
+    out: List[Tuple[float, float]] = []
+    for _ in range(n):
+        if dist.max() <= 1.5:
+            break
+        y, x = np.unravel_index(int(np.argmax(dist)), dist.shape)
+        if out and dist[y, x] < 0.25 * first:
+            break
+        if not out:
+            first = dist[y, x]
+        out.append((float(x), float(y)))
+        dist[(xx - x) ** 2 + (yy - y) ** 2 < min_sep ** 2] = 0
+    return out
+
+
+def auto_prompts(rgb: np.ndarray, fg: np.ndarray) -> Optional[dict]:
+    """Keep/Remove points and a box (working-resolution pixels) from the
+    automatic foreground mask, or None when there is nothing to remove.
+
+    Returns {"points": [(x, y, label)], "box": [x0, y0, x1, y1],
+             "object": bool mask of the expected object, "reason": str}.
+    """
+    from scipy import ndimage
+
+    fg = ndimage.binary_opening(fg, iterations=1)
+    total = int(fg.sum())
+    if total < 0.002 * fg.size:
+        return None
+
+    # 1. skin-coloured parts of the foreground big enough to be a hand/arm
+    #    A hand holds the object from outside the photo, so a blob only counts
+    #    when it reaches the photo edge, and its typical colour must be clearly
+    #    skin (median brightness and Cr): brown wood or leather is darker.
+    skin = ndimage.binary_opening(_skin(rgb) & fg, iterations=2)
+    slab, sn = ndimage.label(skin)
+    hand = np.zeros_like(fg)
+    ycc = np.asarray(Image.fromarray(rgb).convert("YCbCr"))
+    margin = max(3, int(0.02 * max(fg.shape)))
+    for i in range(1, sn + 1):
+        blob = slab == i
+        if blob.sum() < 0.03 * total or not _touches_border(blob, margin):
+            continue
+        y_med, cr_med = np.median(ycc[blob][:, 0]), np.median(ycc[blob][:, 2])
+        if y_med >= 80 and cr_med >= 143:
+            hand |= blob
+    if hand.sum() > 0.7 * total:  # (almost) everything is "skin": a skin-coloured object
+        hand[:] = False
+
+    def find_object(hand):
+        """The object: biggest blob left after removing the hand, preferring
+        blobs not cut by the photo edge -> (object, other blobs)."""
+        rest = fg & ~ndimage.binary_dilation(hand, iterations=4) if hand.any() else fg
+        rlab, rn = ndimage.label(rest)
+        best, best_score, blobs = 0, -1.0, []
+        for i in range(1, rn + 1):
+            blob = rlab == i
+            size = float(blob.sum())
+            if size < 0.02 * total:
+                continue
+            score = size * (0.6 if _touches_border(blob) and hand.any() else 1.0)
+            blobs.append((i, blob, size))
+            if score > best_score:
+                best, best_score = i, score
+        if not best:
+            return None, []
+        return rlab == best, [(b, s) for i, b, s in blobs if i != best]
+
+    obj, blobs = find_object(hand)
+    if obj is not None and hand.any() and hand.sum() > 1.2 * obj.sum():
+        # "hand" bigger than what is left: more likely a skin-coloured object
+        # (beige, bone, wood) than a hand holding something: no hand.
+        hand[:] = False
+        obj, blobs = find_object(hand)
+    if obj is None:
+        return None
+    # other parts: foreground coming in from the edge (sleeve, arm) or a second big object
+    others = [b for b, sz in blobs if _touches_border(b) or sz > 0.05 * total]
+    if not hand.any() and not others:
+        return None  # nothing to remove: automatic removal is already right
+    if obj.sum() < 0.08 * total:
+        return None  # the "object" would be a small leftover: not trustworthy
+    obj_filled = ndimage.binary_fill_holes(obj)
+
+    h, w = fg.shape
+    sep = 0.18 * max(h, w)
+    keep = _peaks(obj_filled, 3, sep)
+    remove = []
+    if hand.any():
+        remove += _peaks(hand, 3, 0.12 * max(h, w))
+    for b in others:
+        remove += _peaks(b, 1, sep)
+    ys, xs = np.nonzero(obj_filled)
+    pad = 0.02 * max(h, w)
+    box = [max(0.0, xs.min() - pad), max(0.0, ys.min() - pad),
+           min(w - 1.0, xs.max() + pad), min(h - 1.0, ys.max() + pad)]
+    reason = []
+    if hand.any():
+        reason.append("hand/skin")
+    if others:
+        reason.append(f"{len(others)} other part(s)")
+    return {
+        "points": [(x, y, KEEP) for x, y in keep] + [(x, y, REMOVE) for x, y in remove],
+        "box": box,
+        "object": obj,
+        "reason": " + ".join(reason),
+    }
+
+
+def _iou(a: np.ndarray, b: np.ndarray) -> float:
+    u = (a | b).sum()
+    return float((a & b).sum() / u) if u else 0.0
+
+
+def auto_select(
+    image: Image.Image,
+    bg_model: Optional[str] = None,
+    fg: Optional[np.ndarray] = None,
+) -> Tuple[Optional[dict], str]:
+    """Automatic 'Select object' for one photo -> (selection or None, note).
+
+    selection = {"points": [(x, y, label)], "box": [...], "mask": bool array,
+    "score": float} with points and box in ORIGINAL-photo pixels (so the UI
+    can show and edit them). None = keep automatic background removal (the
+    note says why). fg: the automatic foreground at working resolution
+    (computed with BiRefNet / bg_model when not given).
+    """
+    from . import background
+
+    if image.mode in ("RGBA", "LA", "PA") or (image.mode == "P" and "transparency" in image.info):
+        a = np.asarray(image.convert("RGBA"))[..., 3]
+        if (a < 250).mean() > 0.01:
+            return None, "photo already has a transparent background"
+    work = background.working_image(image)
+    rgb = np.asarray(work.convert("RGB"))
+    if fg is None:
+        rgba, _ = background.cutout(image, bg_model or background.DEFAULT_BG_MODEL, clean=True)
+        fg = np.asarray(rgba)[..., 3] >= 128
+    prompts = auto_prompts(rgb, fg)
+    if prompts is None:
+        return None, "nothing to remove found, automatic background removal used"
+    s = image.width / work.width
+    points = [(x * s, y * s, lab) for x, y, lab in prompts["points"]]
+    box = [v * s for v in prompts["box"]]
+    obj = prompts["object"]
+    best = None
+    for use_box in (True, False):
+        mask, score = predict_mask(image, points, box if use_box else None)
+        if mask is None or not mask.any():
+            continue
+        ratio = mask.sum() / max(1, obj.sum())
+        iou = _iou(mask, obj)
+        if 0.6 <= ratio <= 1.6 and iou >= 0.6:
+            if best is None or iou > best[3]:
+                best = (mask, score, use_box, iou)
+            if iou >= 0.8:
+                break
+    if best is None:
+        return None, "SAM 2 could not separate the object, automatic background removal used"
+    mask, score, use_box, _ = best
+    sel = {"points": points, "box": box if use_box else None, "mask": mask, "score": float(score)}
+    n_keep = sum(1 for p in points if p[2] == KEEP)
+    return sel, (f"auto-selected ({prompts['reason']} removed: {n_keep} keep, "
+                 f"{len(points) - n_keep} remove point(s))")
