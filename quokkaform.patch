+def history_on_tab(output_dir, evt: gr.SelectData):
+    if evt.value != "History":
+        return (gr.update(),) * 7
+    return history_list(output_dir)
+
+
+def _run_details(folder: str) -> str:
+    runs = [r for r in history.list_runs(os.path.dirname(folder)) if r["folder"] == folder]
+    if not runs:
+        return f"Run folder not found: `{folder}`"
+    r = runs[0]
+    files = ", ".join(sorted(r["files"])) or "none"
+    lines = [f"**{history.run_caption(r)}**", f"- Folder: `{folder}`", f"- Status: {r['status']}",
+             f"- Files: {files}"]
+    if r.get("error"):
+        lines.append(f"- Error: {r['error']}")
+    return "\n".join(lines)
+
+
+def history_select(folders, evt: gr.SelectData):
+    i = evt.index if isinstance(evt.index, int) else evt.index[0]
+    if not folders or i >= len(folders):
+        return "Select a run.", None, gr.update(interactive=False), gr.update(interactive=False)
+    folder = folders[i]
+    return _run_details(folder), folder, gr.update(interactive=True), gr.update(interactive=True)
+
+
+def history_open(folder):
+    if not folder:
+        return "Select a run first."
+    return _run_details(folder) + "\n\n" + history.open_folder(folder)
+
+
+def history_load(folder):
+    """Load a past run into the Create tab's viewer and downloads."""
+    if not folder:
+        raise gr.Error("Select a run first.")
+    try:
+        run = history.load_run(folder)
+    except (OSError, ValueError) as e:
+        raise gr.Error(f"Could not load this run: {e}") from None
+    p = run["paths"]
+    status = run["meta"].get("status", "unknown")
+    info = (run["info"] or f"(no export info saved; status: {status})") + f"\nLoaded from: {folder}"
+    return (
+        run["processed"], p.get("glb"), p.get("glb"), p.get("obj"), p.get("stl"), p.get("ply"),
+        p.get("quad_obj"), info, p.get("raw"), gr.update(interactive=bool(p.get("raw"))),
+        p.get("video"), p.get("video"), folder, gr.Tabs(selected="create"),
+    )
+
